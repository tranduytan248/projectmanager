# ---- Kết quả biên dịch ----
bin/
obj/
*.dll
*.pdb
*.cache

# ---- Visual Studio ----
.vs/
*.user
*.suo
*.userprefs
*.csproj.user
*.sln.docstates

# ---- Thư mục publish ----
# Thư mục build là kết quả đóng gói, không đưa vào lịch sử mã nguồn.
# Riêng danh sách file thay đổi mỗi lần publish thì giữ lại để đối chiếu.
build/app/
build/manifest.json
!build/changes/
!build/changes/*.md

# ---- NuGet ----
packages/
*.nupkg

# ---- Dữ liệu vận hành ----
# App_Data chứa dữ liệu thật (dự án, khách hàng, nhân sự, tài khoản) nên không đưa
# vào kho mã nguồn. Thay vào đó chỉ commit dữ liệu mẫu trong App_Data/seed;
# lần đầu chạy, JsonStore tự chép từ seed sang nếu file thật chưa có.
TTKDGP.ProjectManager/App_Data/*.json
TTKDGP.ProjectManager/App_Data/*.tmp
TTKDGP.ProjectManager/App_Data/*.bak
!TTKDGP.ProjectManager/App_Data/seed/

# Trình duyệt Playwright tải về lúc chạy (~500 MB) và phiên đăng nhập GoConnect —
# là dữ liệu vận hành sinh ra tại chỗ, không phải mã nguồn.
TTKDGP.ProjectManager/App_Data/playwright-browsers/
TTKDGP.ProjectManager/App_Data/goconnect-debug/
TTKDGP.ProjectManager/App_Data/goconnect-lastrun.txt

# Ảnh/HTML gỡ lỗi của đăng nhập CAS HRM — sinh ra tại chỗ, không phải mã nguồn.
# hrm_session.json đã bị loại ở dòng App_Data/*.json phía trên.
TTKDGP.ProjectManager/App_Data/hrm-debug/

# ---- Bí mật ----
# Chứa token bot Telegram và khoá kích hoạt. Chỉ commit file .example.
TTKDGP.ProjectManager/App_Config/secrets.config

# File credentials tạm để thử nghiệm đăng nhập HRM — không phải nơi lưu chính thức,
# chuyển sang App_Config/secrets.config sau. Không được commit trong lúc nào.
TTKDGP.ProjectManager/config.json

# ---- Khác ----
.agents/
Thumbs.db
desktop.ini
*.log
