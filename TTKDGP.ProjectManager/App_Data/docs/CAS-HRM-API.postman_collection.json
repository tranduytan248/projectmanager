{
  "info": {
    "_postman_id": "b8e4d1f2-3c5e-4f7a-9b01-2d3e4f5a6b7c",
    "name": "CAS HRM API - Tich hop lay du lieu danh ba CAS VNPT",
    "description": "API POST /api/hrmcas lay du lieu danh ba CAS VNPT (employees, departments, jobs), xac thuc bang checksum SHA-256. Hoan toan khac API /api/hrm (du lieu GoConnect) nhung dung chung partnerCode/secretKey. Dien baseUrl, partnerCode, secretKey o tab Variables roi Send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Nhan su (employees)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Tu dong sinh requestId, requestTime va tinh checksum truoc khi gui.",
              "var partnerCode = pm.variables.get(\"partnerCode\");",
              "var secretKey   = pm.variables.get(\"secretKey\");",
              "",
              "// ---- Cac truong cua request nay ----",
              "var resource = \"employees\";",
              "var page     = \"1\";",
              "var pageSize = \"100\";",
              "var keyword  = \"\";",
              "",
              "function pad(n) { return (n < 10 ? \"0\" : \"\") + n; }",
              "var now = new Date();",
              "var requestTime = \"\" + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());",
              "var requestId = \"REQ-\" + requestTime + \"-\" + Math.floor(Math.random() * 100000);",
              "",
              "// checksum = SHA256( cac truong noi bang \"|\", secretKey o cuoi )",
              "var raw = [partnerCode, requestId, requestTime, resource, page, pageSize, keyword, secretKey].join(\"|\");",
              "var checksum = CryptoJS.SHA256(raw).toString(CryptoJS.enc.Hex);",
              "",
              "pm.variables.set(\"requestId\", requestId);",
              "pm.variables.set(\"requestTime\", requestTime);",
              "pm.variables.set(\"resource\", resource);",
              "pm.variables.set(\"page\", page);",
              "pm.variables.set(\"pageSize\", pageSize);",
              "pm.variables.set(\"keyword\", keyword);",
              "pm.variables.set(\"checksum\", checksum);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var res = pm.response.json();",
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"code = 00 (thanh cong)\", function () { pm.expect(res.code).to.eql(\"00\"); });",
              "",
              "// Xac thuc checksum cua phan hoi",
              "var secretKey = pm.variables.get(\"secretKey\");",
              "var raw = [res.code, res.message, res.requestId, res.resource, String(res.page), String(res.pageSize), String(res.totalItems), secretKey].join(\"|\");",
              "var expected = CryptoJS.SHA256(raw).toString(CryptoJS.enc.Hex);",
              "pm.test(\"Checksum phan hoi hop le\", function () { pm.expect(res.checksum).to.eql(expected); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partnerCode\": \"{{partnerCode}}\",\n  \"requestId\": \"{{requestId}}\",\n  \"requestTime\": \"{{requestTime}}\",\n  \"resource\": \"{{resource}}\",\n  \"page\": {{page}},\n  \"pageSize\": {{pageSize}},\n  \"keyword\": \"{{keyword}}\",\n  \"checksum\": \"{{checksum}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/hrmcas",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "hrmcas" ]
        },
        "description": "Lay danh sach nhan su CAS VNPT, phan trang. checksum tinh tu dong trong Pre-request Script."
      }
    },
