<?xml version="1.0" encoding="utf-8"?>
<!--
  Biến đổi Web.config khi publish ở cấu hình Release.
  Chỉ áp dụng lúc publish, không ảnh hưởng khi chạy ở máy phát triển.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <appSettings>
    <!-- Bản chạy thật mới cho lịch tự động gửi nhắc; ở local vẫn là false -->
    <add key="Reminder:AutoSend" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- Bật kênh Telegram trên bản chạy thật -->
    <add key="Telegram:Enabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <!-- Tắt debug và chỉ hiện trang lỗi chung cho người dùng cuối -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" defaultRedirect="~/Home/Index" xdt:Transform="SetAttributes(mode)" />
  </system.web>

</configuration>
