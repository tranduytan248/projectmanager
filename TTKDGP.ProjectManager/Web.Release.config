<?xml version="1.0" encoding="utf-8"?>
<!--
  Biến đổi Web.config khi publish ở cấu hình Release.
  Chỉ áp dụng lúc publish, không ảnh hưởng khi chạy ở máy phát triển.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <appSettings>
    <!-- Site demo pmncpt.cenit.vn: TẮT hoàn toàn tự động gửi SMS / nhắc việc để không bị gửi trùng với Production (brewtask.vnptkhanhhoa.vn) -->
    <add key="Reminder:AutoSend" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Reminder:TaskSmsEnabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Reminder:LogTimeSmsEnabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- Bật kênh Telegram trên bản chạy thật -->
    <add key="Telegram:Enabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- Bật kênh mail trên bản chạy thật -->
    <add key="Email:Enabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

    <!-- Mật khẩu kết nối CSDL 10.57.30.10 của nội bộ trung tâm -->
    <add key="Db:Password" value="W6!DTCPk@QJ6k3" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <!-- Tắt debug và chỉ hiện trang lỗi chung cho người dùng cuối -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" defaultRedirect="~/Home/Index" xdt:Transform="SetAttributes(mode)" />
  </system.web>

</configuration>
