@model TTKDGP.ProjectManager.Models.PagedList<TTKDGP.ProjectManager.Models.HrPosition>
@using TTKDGP.ProjectManager.Infrastructure
@{
    ViewBag.Title = "Chức danh";
}

<div class="page-head">
    <div>
        <h1>Chức danh</h1>
        <p>Danh mục chức danh đồng bộ từ GoConnect. Tổng cộng @Model.Pager.TotalItems chức danh.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Positions", "Hrm", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field grow">
                    <label for="keyword">Tìm kiếm</label>
                    <input type="search" id="keyword" name="keyword" value="@ViewBag.Keyword"
                           placeholder="Tên hoặc mã chức danh..." />
                </div>
                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a class="btn btn-default" href="@Url.Action("Positions", "Hrm")">Xoá lọc</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            Chưa có chức danh nào phù hợp. Nếu bảng còn trống, nhắn <code>/hrm</code> cho bot Telegram để đồng bộ.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Tên chức danh</th>
                        <th>Mã</th>
                        <th class="num">Nhân sự</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            <td><strong>@ViewHelpers.OrDash(p.PosName)</strong></td>
                            <td class="muted nowrap">@ViewHelpers.OrDash(p.PosCode)</td>
                            <td class="num">
                                @if (p.EmployeeCount > 0)
                                {
                                    <a href="@Url.Action("Employees", "Hrm", new { posId = p.PosId })"
                                       title="Xem nhân sự giữ chức danh này">@p.EmployeeCount</a>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.Partial("_Pager", Model.Pager)
    }
</div>
