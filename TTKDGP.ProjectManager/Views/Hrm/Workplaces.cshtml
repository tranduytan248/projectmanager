@model TTKDGP.ProjectManager.Models.PagedList<TTKDGP.ProjectManager.Models.HrWorkplace>
@using TTKDGP.ProjectManager.Infrastructure
@{
    ViewBag.Title = "Đơn vị";
}

<div class="page-head">
    <div>
        <h1>Đơn vị</h1>
        <p>
            Cây đơn vị đồng bộ từ GoConnect. Tổng cộng @Model.Pager.TotalItems đơn vị.
            Cấp 0 là phòng/tổ cụ thể, số càng lớn càng lên cao.
        </p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Workplaces", "Hrm", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field grow">
                    <label for="keyword">Tìm kiếm</label>
                    <input type="search" id="keyword" name="keyword" value="@ViewBag.Keyword"
                           placeholder="Tên hoặc mã đơn vị..." />
                </div>
                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a class="btn btn-default" href="@Url.Action("Workplaces", "Hrm")">Xoá lọc</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            Chưa có đơn vị nào phù hợp. Nếu bảng còn trống, nhắn <code>/hrm</code> cho bot Telegram để đồng bộ.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Tên đơn vị</th>
                        <th>Mã</th>
                        <th class="num">Cấp</th>
                        <th class="num">Nhân sự</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model.Items)
                    {
                        <tr>
                            <td><strong>@ViewHelpers.OrDash(w.WpName)</strong></td>
                            <td class="muted nowrap">@ViewHelpers.OrDash(w.WpCode)</td>
                            <td class="num muted">@(w.Level.HasValue ? w.Level.Value.ToString() : "—")</td>
                            <td class="num">
                                @if (w.EmployeeCount > 0)
                                {
                                    <a href="@Url.Action("Employees", "Hrm", new { wpId = w.WpId })"
                                       title="Xem nhân sự thuộc đơn vị này">@w.EmployeeCount</a>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.Partial("_Pager", Model.Pager)
    }
</div>
