@model TTKDGP.ProjectManager.Controllers.TeamCalendarViewModel
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Lịch công tác Tổ";
    var dowLabels = new[] { "T2", "T3", "T4", "T5", "T6", "T7", "CN" };
    var monthNames = new[] { "Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6",
                             "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12" };
    const int maxPerDay = 4;
    var yearFrom = Model.Today.Year - 3;
    var yearTo   = Model.Today.Year + 2;

    var prevMonth = Model.Month == 1 ? 12 : Model.Month - 1;
    var prevYear  = Model.Month == 1 ? Model.Year - 1 : Model.Year;
    var nextMonth = Model.Month == 12 ? 1 : Model.Month + 1;
    var nextYear  = Model.Month == 12 ? Model.Year + 1 : Model.Year;

    Func<WorkTask, string> taskTone = t =>
    {
        if (t.IsOverdue)                     return "overdue";
        if (t.State == TaskStates.Done)      return "done";
        if (t.State == TaskStates.Cancelled) return "cancelled";
        return "active";
    };

    Func<WorkTask, string> dueBadge = t =>
    {
        if (!t.DueDate.HasValue) return "";
        var diff = (t.DueDate.Value.Date - Model.Today).Days;
        if (diff < 0)  return "Quá " + (-diff) + " ngày";
        if (diff == 0) return "Hôm nay";
        if (diff == 1) return "Ngày mai";
        return "Còn " + diff + " ngày";
    };

    Func<WorkTask, string> dueBadgeClass = t =>
    {
        if (!t.DueDate.HasValue) return "";
        var diff = (t.DueDate.Value.Date - Model.Today).Days;
        if (diff < 0)  return "cal-due-badge cal-due-late";
        if (diff == 0) return "cal-due-badge cal-due-today";
        return "cal-due-badge cal-due-soon";
    };

    // Hàm lấy tên viết tắt hoặc tên ngắn hiển thị trên chip
    Func<string, string> shortName = fullName =>
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "";
        var parts = fullName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[parts.Length - 1] : fullName;
    };
}

<div class="page-head">
    <div>
        <h1>
            <svg class="cal-page-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="4" width="16" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6"/>
                <path d="M2 8h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                <path d="M6 2v3M14 2v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                <circle cx="7" cy="13" r="1.1" fill="currentColor"/>
                <circle cx="10" cy="13" r="1.1" fill="currentColor"/>
                <circle cx="13" cy="13" r="1.1" fill="currentColor"/>
            </svg>
            Lịch công tác Tổ
        </h1>
        <p>Theo dõi phân bố công việc của <strong>toàn bộ thành viên trong tổ</strong> theo ngày trong tháng.</p>
    </div>
    <div class="btn-row">
        @using (Html.BeginForm("Index", "TeamCalendar", FormMethod.Get, new { @class = "inline-filter" }))
        {
            @Html.Hidden("year",  Model.Year)
            @Html.Hidden("month", Model.Month)
            <select name="userId" onchange="this.form.submit()">
                <option value="">— Tất cả thành viên —</option>
                @foreach (var u in Model.Members)
                {
                    <option value="@u.Id" selected="@(Model.UserFilter == u.Id)">@u.FullName</option>
                }
            </select>
            <select name="state" onchange="this.form.submit()">
                <option value="">— Tất cả trạng thái —</option>
                @foreach (var s in TaskStates.All.Where(s => s != TaskStates.Paused))
                {
                    <option value="@s" selected="@(Model.StateFilter == s)">@TaskStates.Display(s)</option>
                }
            </select>
            <select name="priority" onchange="this.form.submit()">
                <option value="">— Tất cả ưu tiên —</option>
                @foreach (var p in TaskPriorities.All)
                {
                    <option value="@p" selected="@(Model.PriorityFilter == p)">@TaskPriorities.Display(p)</option>
                }
            </select>
        }
    </div>
</div>

<div class="stats">
    <div class="stat">
        <div class="stat-value">@Model.TotalInMonth</div>
        <div class="stat-label">Công việc trong tháng</div>
    </div>
    <div class="stat stat-ok">
        <div class="stat-value">@Model.DoneCount</div>
        <div class="stat-label">Đã hoàn thành</div>
    </div>
    <div class="stat stat-primary">
        <div class="stat-value">@Model.InProgressCount</div>
        <div class="stat-label">Đang thực hiện</div>
    </div>
    <div class="stat @(Model.OverdueCount > 0 ? "stat-late" : "")">
        <div class="stat-value">@Model.OverdueCount</div>
        <div class="stat-label">Quá hạn</div>
    </div>
</div>

<div class="two-col calendar-layout">

    @* ===== Lưới lịch ===== *@
    <div class="card calendar-card">

        @* Tiêu đề tháng + bộ chọn tháng/năm + điều hướng *@
        <div class="calendar-title-row">
            <form id="cal-jump-form" method="get" action="@Url.Action("Index", "TeamCalendar")" class="cal-jump-form">
                <input type="hidden" name="userId"   value="@Model.UserFilter" />
                <input type="hidden" name="state"    value="@Model.StateFilter" />
                <input type="hidden" name="priority" value="@Model.PriorityFilter" />
                <div class="cal-jump-selects">
                    <select id="cal-jump-month" name="month" class="cal-jump-select" onchange="document.getElementById('cal-jump-form').submit()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" @(m == Model.Month ? "selected" : "")>@monthNames[m - 1]</option>
                        }
                    </select>
                    <select id="cal-jump-year" name="year" class="cal-jump-select" onchange="document.getElementById('cal-jump-form').submit()">
                        @for (int y = yearFrom; y <= yearTo; y++)
                        {
                            <option value="@y" @(y == Model.Year ? "selected" : "")>@y</option>
                        }
                    </select>
                </div>
            </form>
            <div class="calendar-nav-actions">
                <a class="btn btn-default btn-sm calendar-today-btn"
                   href="@Url.Action("Index", new { year = Model.Today.Year, month = Model.Today.Month, userId = Model.UserFilter, state = Model.StateFilter, priority = Model.PriorityFilter })">Hôm nay</a>
                <div class="calendar-pager">
                    <a title="Tháng trước"
                       href="@Url.Action("Index", new { year = prevYear,  month = prevMonth, userId = Model.UserFilter, state = Model.StateFilter, priority = Model.PriorityFilter })">&lsaquo;</a>
                    <a title="Tháng sau"
                       href="@Url.Action("Index", new { year = nextYear, month = nextMonth, userId = Model.UserFilter, state = Model.StateFilter, priority = Model.PriorityFilter })">&rsaquo;</a>
                </div>
            </div>
        </div>

        @* Lưới ngày *@
        <table class="calendar-grid">
            <thead>
                <tr>
                    @foreach (var label in dowLabels)
                    {
                        <th>@label</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var week in Model.Weeks)
                {
                    <tr>
                        @foreach (var day in week)
                        {
                            var isToday   = day.Date == Model.Today;
                            var isWeekend = day.Date.DayOfWeek == DayOfWeek.Saturday
                                         || day.Date.DayOfWeek == DayOfWeek.Sunday;
                            var cellClass = "calendar-day"
                                + (day.InCurrentMonth ? "" : " calendar-day-outside")
                                + (isToday   ? " calendar-day-today"   : "")
                                + (isWeekend ? " calendar-day-weekend" : "");
                            <td class="@cellClass">
                                @if (day.Tasks.Count > 0)
                                {
                                    <div class="calendar-day-num calendar-day-has-tasks"
                                         data-modal-url="@Url.Action("DayTasks", "TeamCalendar", new { date = day.Date.ToString("yyyy-MM-dd"), userId = Model.UserFilter, state = Model.StateFilter, priority = Model.PriorityFilter })"
                                         data-modal-title="Công việc ngày @day.Date.ToString("dd/MM/yyyy")"
                                         data-modal-size="lg"
                                         title="Xem @day.Tasks.Count công việc ngày @day.Date.ToString("dd/MM/yyyy")">
                                        @day.Date.Day
                                    </div>
                                }
                                else
                                {
                                    <div class="calendar-day-num">@day.Date.Day</div>
                                }
                                <div class="calendar-task-list">
                                    @foreach (var t in day.Tasks.Take(maxPerDay))
                                    {
                                        var tone = taskTone(t);
                                        var memberShort = shortName(t.AssigneeName);
                                        var tooltip = t.Title + (!string.IsNullOrEmpty(t.AssigneeName) ? " (" + t.AssigneeName + ")" : "")
                                            + (!string.IsNullOrEmpty(t.ProjectName) ? " — " + t.ProjectName : "");
                                        <div class="calendar-task calendar-task-@tone"
                                             data-modal-url="@Url.Action("Detail", "Checklist", new { id = t.Id })"
                                             data-modal-title="Chi tiết công việc" data-modal-size="lg"
                                             title="@tooltip">
                                            <span class="cal-task-dot"></span>
                                            @if (!string.IsNullOrEmpty(memberShort) && !Model.UserFilter.HasValue)
                                            {
                                                <span class="cal-member-tag" title="@t.AssigneeName">@memberShort</span>
                                            }
                                            <span class="cal-task-text">@t.Title</span>
                                        </div>
                                    }
                                    @if (day.Tasks.Count > maxPerDay)
                                    {
                                        <div class="calendar-more"
                                             data-modal-url="@Url.Action("DayTasks", "TeamCalendar", new { date = day.Date.ToString("yyyy-MM-dd"), userId = Model.UserFilter, state = Model.StateFilter, priority = Model.PriorityFilter })"
                                             data-modal-title="Công việc ngày @day.Date.ToString("dd/MM/yyyy")"
                                             data-modal-size="lg"
                                             title="Bấm để xem toàn bộ @day.Tasks.Count công việc trong ngày">
                                            +@(day.Tasks.Count - maxPerDay) việc khác
                                        </div>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @* Chú giải màu *@
        <div class="calendar-legend">
            <span><i class="calendar-dot calendar-dot-overdue"></i>Quá hạn</span>
            <span><i class="calendar-dot calendar-dot-done"></i>Hoàn thành</span>
            <span><i class="calendar-dot calendar-dot-active"></i>Đang thực hiện</span>
        </div>
    </div>

    @* ===== Panel bên phải: Sắp tới của Tổ ===== *@
    <div class="card">
        <div class="card-head">
            <span>
                <svg class="cal-upcoming-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M8 5v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Công việc sắp tới
            </span>
            <a class="muted" href="@Url.Action("Index", "TeamDashboard")">Bảng điều khiển</a>
        </div>
        @if (Model.Upcoming.Count == 0)
        {
            <div class="card-body">
                <div class="cal-upcoming-empty">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
                        <path d="M14 20l4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Không có việc nào sắp tới hạn.</span>
                </div>
            </div>
        }
        else
        {
            foreach (var t in Model.Upcoming)
            {
                var tone     = taskTone(t);
                var badge    = dueBadge(t);
                var badgeCls = dueBadgeClass(t);
                <div class="task-feed-item cal-upcoming-item cal-upcoming-@tone"
                     data-modal-url="@Url.Action("Detail", "Checklist", new { id = t.Id })"
                     data-modal-title="Chi tiết công việc" data-modal-size="lg">
                    <div class="task-feed-main">
                        <div class="task-feed-title">@t.Title</div>
                        <div class="task-feed-meta">
                            @if (!string.IsNullOrEmpty(t.AssigneeName))
                            {
                                <span class="cal-upcoming-assignee">
                                    <svg class="cal-user-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M8 8a3 3 0 100-6 3 3 0 000 6zM2.5 13.5c0-2.5 2.5-3.5 5.5-3.5s5.5 1 5.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                                    </svg>
                                    <strong>@t.AssigneeName</strong>
                                </span>
                                <span>&middot;</span>
                            }
                            <span>@(string.IsNullOrWhiteSpace(t.ProjectName) ? "Việc riêng" : t.ProjectName)</span>
                            @if (t.DueDate.HasValue)
                            {
                                <span>&middot;</span>
                                <span>@t.DueDate.Value.ToString("dd/MM")</span>
                            }
                        </div>
                    </div>
                    <div class="task-feed-side">
                        @if (!string.IsNullOrEmpty(badge))
                        {
                            <span class="@badgeCls">@badge</span>
                        }
                    </div>
                </div>
            }
        }
    </div>

</div>
