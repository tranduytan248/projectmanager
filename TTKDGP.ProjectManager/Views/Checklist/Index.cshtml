@model TTKDGP.ProjectManager.Models.ChecklistViewModel
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Checklist — " + Model.Project.Name;

    var canAll = ViewBag.Can is Func<string, bool> && ((Func<string, bool>)ViewBag.Can)("wprojects.view");
    ViewBag.Crumbs = new List<Crumb>
    {
        canAll
            ? new Crumb { Label = "Dự án", Url = Url.Action("Index", "WorkProjects") }
            : new Crumb { Label = "Dự án của tôi", Url = Url.Action("Projects", "MyWork") },
        new Crumb { Label = Model.Project.Name, Url = Url.Action("Details", "WorkProjects", new { id = Model.Project.Id }) },
        new Crumb { Label = "Checklist" }
    };
}

<div class="page-head">
    <div>
        <h1>Checklist công việc</h1>
        <p>
            Dự án <strong>@Model.Project.Name</strong>
            @if (!string.IsNullOrWhiteSpace(Model.Project.PmName))
            {
                <text>· PM @Model.Project.PmName</text>
            }
            · @Model.DoneCount/@Model.TotalCount mục hoàn thành (@Model.DonePercent%)
            @if (Model.OverdueCount > 0)
            {
                <strong style="color:var(--danger)">· @Model.OverdueCount mục quá hạn</strong>
            }
        </p>
    </div>
    <div class="btn-row">
        <a class="btn @(Model.View == TaskViews.Grid ? "btn-primary" : "btn-default")"
           href="@Url.Action("Index", "Checklist", new { projectId = Model.Project.Id, view = TaskViews.Grid })">
            <svg class="btn-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <rect x="1" y="2" width="14" height="3" rx="1"/>
                <rect x="1" y="6.5" width="14" height="3" rx="1"/>
                <rect x="1" y="11" width="14" height="3" rx="1"/>
            </svg>
            Dạng lưới</a>
        <a class="btn @(Model.View == TaskViews.Kanban ? "btn-primary" : "btn-default")"
           href="@Url.Action("Index", "Checklist", new { projectId = Model.Project.Id, view = TaskViews.Kanban })">
            <svg class="btn-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <rect x="1" y="1" width="4" height="14" rx="1"/>
                <rect x="6" y="1" width="4" height="9" rx="1"/>
                <rect x="11" y="1" width="4" height="12" rx="1"/>
            </svg>
            Kanban</a>
        <a class="btn btn-default" href="@Url.Action("Projects", "MyWork")">&larr; Dự án của tôi</a>
    </div>
</div>

@if (Model.CanEdit)
{
    var canImport = ViewBag.Can is Func<string, bool> && ((Func<string, bool>)ViewBag.Can)("wtasks.import");
    <div class="card">
        <div class="card-body">
            <div class="btn-row">
                <a class="btn btn-primary" href="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id })"
                   data-modal-url="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id })"
                   data-modal-title="Thêm mục checklist">+ Thêm mục</a>
                @if (canImport)
                {
                    <a class="btn btn-default" href="#"
                       data-modal-url="@Url.Action("ImportForm", "Checklist", new { projectId = Model.Project.Id })"
                       data-modal-title="Import checklist từ file"
                       data-modal-size="sm">
                        <svg class="btn-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 1l4 4.5H9.5V10h-3V5.5H4L8 1z"/>
                            <path d="M2 12h12v2.5H2z"/>
                        </svg>
                        Import từ file</a>
                }
                <a class="btn btn-default" href="@Url.Action("Template", "Checklist", new { projectId = Model.Project.Id })">
                    <svg class="btn-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 10.5L4 6h2.5V1.5h3V6H12l-4 4.5z"/>
                        <path d="M2 12h12v2.5H2z"/>
                    </svg>
                    Tải file mẫu</a>
            </div>
        </div>
    </div>
}

@if (Model.ShowWorkload)
{
    @Html.Partial("_Workload", Model)
}

@if (Model.View == TaskViews.Kanban)
{
    @Html.Partial("_Kanban", Model)
}
else
{
<div class="card">
    @if (Model.Rows.Items.Count == 0)
    {
        <div class="empty-state">
            Checklist chưa có mục nào.
            @if (Model.CanEdit)
            {
                <span class="hint">Thêm từng mục hoặc import từ file mẫu.</span>
            }
        </div>
    }
    else
    {
        <div class="table-wrap with-menu">
            <table class="data">
                <thead>
                    <tr>
                        <th>Công việc</th>
                        <th>Loại</th>
                        <th>Ưu tiên</th>
                        <th>Người thực hiện</th>
                        <th>Hạn</th>
                        <th class="num">Tiến độ</th>
                        <th>Trạng thái</th>
                        <th class="num">Trao đổi</th>
                        @if (Model.CanEditAny)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows.Items)
                    {
                        var t = row.Task;
                        @* Quá hạn tô đỏ, còn tối đa 1 ngày tô cam — khớp với màu thẻ bên bảng Kanban. *@
                        var alert = t.IsOverdue ? " row-due-danger" : (t.IsDueSoon ? " row-due-warn" : "");
                        <tr class="row-clickable@alert"
                            data-modal-url="@Url.Action("Detail", "Checklist", new { id = t.Id })"
                            data-modal-title="Chi tiết công việc"
                            data-modal-size="lg">
                            <td style="padding-left:@(12 + row.Depth * 22)px">
                                @if (!string.IsNullOrWhiteSpace(t.Code))
                                {
                                    <span class="muted">@t.Code</span> <text>·</text>
                                }
                                @t.Title
                            </td>
                            <td class="nowrap"><span class="badge">@TaskKinds.Display(t.Kind)</span></td>
                            <td class="nowrap muted">@TaskPriorities.Display(t.Priority)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.AssigneeName) ? "(chưa giao)" : t.AssigneeName)</td>
                            <td class="nowrap">
                                @if (t.DueDate.HasValue)
                                {
                                    @t.DueDate.Value.ToString("dd/MM/yyyy")
                                    if (t.IsOverdue)
                                    {
                                        <span class="badge badge-danger">Quá hạn @(-t.DaysLeft) ngày</span>
                                    }
                                    else if (t.IsDueSoon)
                                    {
                                        <span class="badge badge-waiting">@(t.DaysLeft == 0 ? "Hết hạn hôm nay" : "Còn 1 ngày")</span>
                                    }
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td class="num">@t.Progress%</td>
                            <td>
                                @if (t.State == TaskStates.Done)
                                {
                                    <span class="badge badge-active">Hoàn thành @(t.IsOnTime ? "đúng hạn" : "trễ hạn")</span>
                                }
                                else
                                {
                                    <span class="badge">@TaskStates.Display(t.State)</span>
                                }
                            </td>
                            <td class="num">
                                <a href="@Url.Action("Detail", "MyWork", new { id = t.Id })">@row.CommentCount</a>
                            </td>
                            @if (Model.CanEditAny)
                            {
                                <td class="actions">
                                    <details class="row-menu">
                                        <summary>Thao tác ▾</summary>
                                        <div class="row-menu-items">
                                            @* href giữ trang đầy đủ làm dự phòng khi không có JS; bình thường mở hộp thoại. *@
                                            <a href="@Url.Action("Detail", "MyWork", new { id = t.Id })"
                                               data-modal-url="@Url.Action("Detail", "Checklist", new { id = t.Id })"
                                               data-modal-title="Chi tiết công việc"
                                               data-modal-size="lg">Chi tiết &amp; trao đổi</a>
                                            @if (row.CanEdit)
                                            {
                                                <a href="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id, id = t.Id })"
                                                   data-modal-url="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id, id = t.Id })"
                                                   data-modal-title="@(row.CanEditAll ? "Sửa công việc" : "Cập nhật tiến độ")">
                                                    @(row.CanEditAll ? "Sửa thông tin" : "Cập nhật tiến độ")
                                                </a>
                                            }
                                            @if (row.CanEditAll)
                                            {
                                                <div class="row-menu-sep"></div>
                                                using (Html.BeginForm("Delete", "Checklist", new { projectId = Model.Project.Id, id = t.Id }, FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="danger"
                                                            onclick="return confirm('Xoá mục &quot;@t.Title&quot; và toàn bộ mục con?');">Xoá mục</button>
                                                }
                                            }
                                        </div>
                                    </details>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.Partial("_Pager", Model.Rows.Pager)
        <div class="card-body">
            <span class="hint">
                Bấm vào một dòng để xem chi tiết công việc. Phân trang theo <strong>mục gốc</strong> —
                mỗi trang @Model.Rows.Pager.PageSize mục gốc kèm toàn bộ mục con, để cây không bị cắt
                rời giữa hai trang.
            </span>
        </div>
    }
</div>
}
