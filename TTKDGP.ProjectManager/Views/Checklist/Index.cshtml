@model TTKDGP.ProjectManager.Models.ChecklistViewModel
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Checklist — " + Model.Project.Name;

    var canAll = ViewBag.Can is Func<string, bool> && ((Func<string, bool>)ViewBag.Can)("wprojects.view");
    ViewBag.Crumbs = new List<Crumb>
    {
        canAll
            ? new Crumb { Label = "Dự án", Url = Url.Action("Index", "WorkProjects") }
            : new Crumb { Label = "Dự án của tôi", Url = Url.Action("Projects", "MyWork") },
        new Crumb { Label = Model.Project.Name, Url = Url.Action("Details", "WorkProjects", new { id = Model.Project.Id }) },
        new Crumb { Label = "Checklist" }
    };
}

@{
    @* Chu vi vòng tiến độ, bán kính 25 — dùng để cắt vạch theo đúng tỷ lệ hoàn thành. *@
    const double RingLength = 157.1;
    var ringOffset = RingLength - (RingLength * Model.DonePercent / 100.0);
}

<div class="pagehead">
    <div class="pagehead-top">
        <div>
            <h1>Checklist công việc</h1>
            <p class="pagehead-sub">
                <b>@Model.Project.Name</b>
                @if (!string.IsNullOrWhiteSpace(Model.Project.PmName))
                {
                    <span class="sep"></span>
                    <span>PM @Model.Project.PmName</span>
                }
                @if (Model.OverdueCount > 0)
                {
                    <span class="sep"></span>
                    <span class="pill pill-late"><i></i>@Model.OverdueCount mục quá hạn</span>
                }
            </p>
        </div>

        @* Vòng tiến độ thay cho dòng chữ "x/y mục hoàn thành (z%)": cùng thông tin
           nhưng nắm được trong một phần giây thay vì phải đọc hết câu. *@
        <div class="ringstat">
            <div class="ringstat-ring">
                <svg width="58" height="58" viewBox="0 0 58 58" aria-hidden="true">
                    <circle class="ringstat-track" cx="29" cy="29" r="25" fill="none" stroke-width="5"></circle>
                    <circle class="ringstat-fill" cx="29" cy="29" r="25" fill="none" stroke-width="5"
                            stroke-dasharray="@RingLength.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            stroke-dashoffset="@ringOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"></circle>
                </svg>
                <div class="ringstat-num">@Model.DonePercent%</div>
            </div>
            <div class="ringstat-label">
                <b>@Model.DoneCount / @Model.TotalCount mục</b>
                đã hoàn thành
            </div>
        </div>
    </div>

    <div class="pagehead-bar">
        <div class="segbtn">
            <a class="@(Model.View == TaskViews.Grid ? "on" : "")"
               href="@Url.Action("Index", "Checklist", new { projectId = Model.Project.Id, view = TaskViews.Grid })">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="round"/>
                </svg>
                Dạng lưới</a>
            <a class="@(Model.View == TaskViews.Kanban ? "on" : "")"
               href="@Url.Action("Index", "Checklist", new { projectId = Model.Project.Id, view = TaskViews.Kanban })">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="2" y="3" width="3.6" height="10" rx="1"/>
                    <rect x="6.9" y="3" width="3.6" height="7" rx="1"/>
                    <rect x="11.8" y="3" width="2.4" height="9" rx="1"/>
                </svg>
                Kanban</a>
        </div>

        <div class="pagehead-acts">
            @if (Model.CanCreateTask || Model.CanEdit)
            {
                <a class="btn btn-primary" href="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id })"
                   data-modal-url="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id })"
                   data-modal-title="Thêm mục checklist">
                    <svg class="btn-icon" width="15" height="15" viewBox="0 0 16 16" fill="none"
                         stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                        <path d="M8 3v10M3 8h10" stroke-linecap="round"/>
                    </svg>
                    Thêm mục</a>
            }
            @if (Model.CanEdit)
            {
                var canImport = ViewBag.Can is Func<string, bool> && ((Func<string, bool>)ViewBag.Can)("wtasks.import");
                if (canImport)
                {
                    <a class="btn btn-default" href="#"
                       data-modal-url="@Url.Action("ImportForm", "Checklist", new { projectId = Model.Project.Id })"
                       data-modal-title="Import checklist từ file"
                       data-modal-size="sm">
                        <svg class="btn-icon" width="15" height="15" viewBox="0 0 16 16" fill="none"
                             stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                            <path d="M8 11V3M5 6l3-3 3 3M3 12.5h10" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Import</a>
                }
                <a class="btn btn-default" href="@Url.Action("Template", "Checklist", new { projectId = Model.Project.Id })">
                    <svg class="btn-icon" width="15" height="15" viewBox="0 0 16 16" fill="none"
                         stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path d="M8 3v8M5 8l3 3 3-3M3 13.5h10" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    File mẫu</a>
            }
            <a class="btn btn-ghost" href="@Url.Action("Projects", "MyWork")">&larr; Dự án của tôi</a>
        </div>
    </div>
</div>

@if (Model.ShowWorkload)
{
    @Html.Partial("_Workload", Model)
}

@* ----- Bộ lọc -----
   Một hàng ngang thay cho khối năm ô xếp chồng. Các ô chọn tự gửi form ngay khi đổi
   giá trị nên không cần nút "Lọc" riêng; ô tìm kiếm vẫn gửi bằng phím Enter. Nút Lọc
   vẫn giữ lại cho trường hợp trình duyệt tắt JavaScript. *@
<div class="filterbar">
    @using (Html.BeginForm("Index", "Checklist", FormMethod.Get, new { @class = "filterbar-form" }))
    {
        @* Giữ dự án và kiểu hiển thị khi lọc, nếu không bấm Lọc là nhảy về dạng lưới. *@
        <input type="hidden" name="projectId" value="@Model.Project.Id" />
        <input type="hidden" name="view" value="@Model.View" />

        <div class="filter-search">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <circle cx="7" cy="7" r="4.3"/>
                <path d="M10.2 10.2L14 14" stroke-linecap="round"/>
            </svg>
            <input type="search" id="q" name="q" value="@Model.Query"
                   placeholder="Tìm mã hoặc tên công việc…" aria-label="Tìm công việc" />
        </div>

        <select id="assigneeUserId" name="assigneeUserId" class="filter-pick" aria-label="Người thực hiện">
            <option value="0">Người thực hiện</option>
            <option value="-1" selected="@(Model.AssigneeUserId < 0)">(chưa giao)</option>
            @foreach (var u in Model.Users)
            {
                <option value="@u.Id" selected="@(Model.AssigneeUserId == u.Id)">@u.FullName</option>
            }
        </select>

        <select id="state" name="state" class="filter-pick" aria-label="Trạng thái">
            <option value="">Trạng thái</option>
            @foreach (var s in TaskStates.All)
            {
                <option value="@s" selected="@(Model.State == s)">@TaskStates.Display(s)</option>
            }
        </select>

        <select id="kind" name="kind" class="filter-pick" aria-label="Loại việc">
            <option value="">Loại việc</option>
            @foreach (var k in TaskKinds.InProject)
            {
                <option value="@k" selected="@(Model.Kind == k)">@TaskKinds.Display(k)</option>
            }
        </select>

        <select id="due" name="due" class="filter-pick" aria-label="Hạn">
            <option value="">Hạn</option>
            <option value="@ChecklistDueFilters.Overdue" selected="@(Model.Due == ChecklistDueFilters.Overdue)">@ChecklistDueFilters.Display(ChecklistDueFilters.Overdue)</option>
            <option value="@ChecklistDueFilters.Soon" selected="@(Model.Due == ChecklistDueFilters.Soon)">@ChecklistDueFilters.Display(ChecklistDueFilters.Soon)</option>
            <option value="@ChecklistDueFilters.NoDue" selected="@(Model.Due == ChecklistDueFilters.NoDue)">@ChecklistDueFilters.Display(ChecklistDueFilters.NoDue)</option>
        </select>

        <button type="submit" class="btn btn-default btn-sm filter-go">Lọc</button>

        if (Model.HasFilter)
        {
            <a class="btn btn-ghost btn-sm"
               href="@Url.Action("Index", "Checklist", new { projectId = Model.Project.Id, view = Model.View })">Bỏ lọc</a>
        }
    }

    <span class="filter-count">
        @if (Model.HasFilter)
        {
            <text><b>@Model.MatchCount</b> / @Model.TotalCount mục</text>
        }
        else
        {
            <text><b>@Model.TotalCount</b> mục</text>
        }
    </span>
</div>

@if (Model.View == TaskViews.Kanban)
{
    @Html.Partial("_Kanban", Model)
}
else
{
<div class="panel">
    @if (Model.Rows.Items.Count == 0)
    {
        <div class="empty-state">
            @if (Model.HasFilter)
            {
                <text>Không có mục nào khớp bộ lọc.</text>
                <span class="hint">Thử bỏ bớt điều kiện lọc.</span>
            }
            else
            {
                <text>Checklist chưa có mục nào.</text>
                if (Model.CanEdit)
                {
                    <span class="hint">Thêm từng mục hoặc import từ file mẫu.</span>
                }
            }
        </div>
    }
    else
    {
        @* Bảng gộp cột ở màn hẹp: các cột phụ (loại, ưu tiên, người, hạn, tiến độ, trao đổi) ẩn đi,
           nội dung của chúng hiện lại thành một dòng tóm tắt ngay dưới tên việc. Nhờ vậy không phải
           dựng hai khối HTML song song cho cùng một dữ liệu. *@
        <div class="panel-scroll with-menu">
            <table class="list table-collapse">
                <thead>
                    <tr>
                        <th>Công việc</th>
                        <th class="col-hide-sm">Người thực hiện</th>
                        <th class="col-hide-sm">Ưu tiên</th>
                        <th class="col-hide-sm">Hạn</th>
                        <th class="col-hide-sm">Tiến độ</th>
                        <th class="num col-hide-sm">Giờ công</th>
                        <th>Trạng thái</th>
                        <th class="num col-hide-sm">Trao đổi</th>
                        @if (Model.CanEditAny)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows.Items)
                    {
                        var t = row.Task;

                        @* Mức ưu tiên nói bằng dải màu bên trái dòng thay vì bằng chữ.
                           So theo hằng số chứ không theo chữ hiển thị — đổi chữ tiếng Việt
                           sau này thì màu vẫn đúng. *@
                        var pri = TaskPriorities.Display(t.Priority);
                        var priKey = t.Priority == TaskPriorities.High ? "cao"
                                   : t.Priority == TaskPriorities.Low ? "thap"
                                   : "vua";

                        @* Chữ cái đầu của họ và tên để làm huy hiệu người thực hiện. *@
                        var who = string.IsNullOrWhiteSpace(t.AssigneeName) ? null : t.AssigneeName.Trim();
                        var initials = "—";
                        if (who != null)
                        {
                            var parts = who.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                            initials = parts.Length == 1
                                ? parts[0].Substring(0, 1).ToUpper()
                                : (parts[parts.Length - 2].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper();
                        }

                        <tr class="rowlink" data-pri="@priKey" data-task-id="@t.Id"
                            data-modal-url="@Url.Action("Detail", "Checklist", new { id = t.Id })"
                            data-modal-title="Chi tiết công việc"
                            data-modal-size="lg">
                            <td class="lead@(row.Depth > 0 ? " child" : "")"
                                style="padding-left:@(20 + row.Depth * 22)px">
                                @if (!string.IsNullOrWhiteSpace(t.Code))
                                {
                                    <span class="lead-code">@t.Code</span>
                                }
                                <span class="lead-kind">@(string.IsNullOrWhiteSpace(t.Code) ? "" : " · ")@TaskKinds.Display(t.Kind)</span>
                                <span class="lead-name">@t.Title</span>

                                @* Bản tóm tắt cho màn hẹp — gom nội dung các cột bị ẩn. *@
                                <div class="cell-recap">
                                    <span>@(who ?? "(chưa giao)")</span>
                                    @if (t.DueDate.HasValue)
                                    {
                                        <span>·</span>
                                        <span class="@(t.IsOverdue ? "danger-text" : "")">Hạn @t.DueDate.Value.ToString("dd/MM")</span>
                                    }
                                    <span>·</span>
                                    <span>@t.Progress%</span>
                                    @if (row.LoggedHours > 0)
                                    {
                                        <span>·</span>
                                        <span>@row.LoggedHours.ToString("0.##")h công</span>
                                    }
                                    @if (row.CommentCount > 0)
                                    {
                                        <span>·</span>
                                        <span>@row.CommentCount trao đổi</span>
                                    }
                                </div>
                            </td>

                            <td class="col-hide-sm">
                                <div class="person">
                                    <span class="person-ava">@initials</span>
                                    <span>@(who ?? "(chưa giao)")</span>
                                </div>
                            </td>

                            <td class="nowrap col-hide-sm">
                                <span class="pri pri-@priKey"><i></i>@pri</span>
                            </td>

                            <td class="nowrap col-hide-sm">
                                @if (t.DueDate.HasValue)
                                {
                                    @* Việc đã đóng (xong hoặc huỷ) thì thôi không cảnh báo hạn nữa. *@
                                    var closed = TaskStates.IsClosed(t.State);
                                    var dueClass = closed ? "due-done"
                                                 : t.IsOverdue ? "due-late"
                                                 : t.IsDueSoon ? "due-soon" : "";
                                    <div class="due @dueClass">
                                        <b>@t.DueDate.Value.ToString("dd/MM/yyyy")</b>
                                        @if (t.State == TaskStates.Done)
                                        {
                                            <small>@(t.IsOnTime ? "xong đúng hạn" : "xong trễ hạn")</small>
                                        }
                                        else if (t.State == TaskStates.Cancelled)
                                        {
                                            <small>đã huỷ</small>
                                        }
                                        else if (t.IsOverdue)
                                        {
                                            <small>quá hạn @(-t.DaysLeft) ngày</small>
                                        }
                                        else if (t.IsDueSoon)
                                        {
                                            <small>@(t.DaysLeft == 0 ? "hết hạn hôm nay" : "còn 1 ngày")</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>

                            <td class="col-hide-sm">
                                <div class="prog @(t.Progress >= 100 ? "prog-full" : "")">
                                    <div class="prog-track"><i style="width:@t.Progress%"></i></div>
                                    <span>@t.Progress%</span>
                                </div>
                            </td>

                            @* Giờ công đã ghi, kèm trần của việc để biết đã dùng bao nhiêu phần.
                               Việc thiếu ngày thì không có trần — chỉ hiện số giờ, không hiện mẫu số. *@
                            <td class="num nowrap col-hide-sm">
                                @if (row.LoggedHours > 0)
                                {
                                    var cap = TimeLogRules.TaskCap(t.StartDate, t.DueDate);
                                    <div class="hours @(cap.HasValue && row.LoggedHours > cap.Value ? "hours-over" : "")">
                                        <b>@row.LoggedHours.ToString("0.##")h</b>
                                        @if (cap.HasValue)
                                        {
                                            <small>/ @cap.Value.ToString("0.##")h</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>

                            <td>
                                @*
                                    Màu nói đúng tình trạng, xét theo thứ tự:
                                      xong        → xanh lá, kèm chú thích đúng/trễ hạn khi rê chuột
                                      huỷ         → xám, việc đã đóng nên không còn phải theo dõi
                                      quá hạn     → đỏ, cần xử lý ngay
                                      tạm dừng    → vàng, đang vướng gì đó
                                      đang làm    → xanh thương hiệu (việc đang diễn ra, không tốt
                                                    cũng không xấu, nên không thuộc thang xanh/vàng/đỏ)
                                      chưa bắt đầu→ xám
                                *@
                                @if (t.State == TaskStates.Done)
                                {
                                    <span class="pill pill-ok" title="Hoàn thành @(t.IsOnTime ? "đúng hạn" : "trễ hạn")">
                                        <i></i>Hoàn thành
                                    </span>
                                }
                                else if (t.State == TaskStates.Cancelled)
                                {
                                    <span class="pill pill-idle"><i></i>@TaskStates.Display(t.State)</span>
                                }
                                else if (t.IsOverdue)
                                {
                                    <span class="pill pill-late"><i></i>@TaskStates.Display(t.State)</span>
                                }
                                else if (t.State == TaskStates.Paused)
                                {
                                    <span class="pill pill-warn"><i></i>@TaskStates.Display(t.State)</span>
                                }
                                else if (t.State == TaskStates.InProgress)
                                {
                                    <span class="pill pill-run"><i></i>@TaskStates.Display(t.State)</span>
                                }
                                else
                                {
                                    <span class="pill pill-idle"><i></i>@TaskStates.Display(t.State)</span>
                                }
                            </td>

                            <td class="num col-hide-sm">
                                <a class="talk @(row.CommentCount > 0 ? "talk-has" : "")"
                                   href="@Url.Action("Detail", "MyWork", new { id = t.Id })">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor"
                                         stroke-width="1.5" aria-hidden="true">
                                        <path d="M14 7.5c0 2.8-2.7 5-6 5-.8 0-1.5-.1-2.2-.3L2.5 13.5l1-2.8C2.5 9.8 2 8.7 2 7.5c0-2.8 2.7-5 6-5s6 2.2 6 5z"
                                              stroke-linejoin="round"/>
                                    </svg>
                                    @row.CommentCount
                                </a>
                            </td>
                            @if (Model.CanEditAny)
                            {
                                <td class="actions rowact">
                                    <details class="row-menu">
                                        @* Nút ba chấm chỉ hiện khi rê chuột vào dòng, nhờ vậy bảng bớt
                                           nhiễu. Vẫn hiện đầy đủ khi đi bằng bàn phím. *@
                                        <summary class="rowbtn" aria-label="Thao tác" title="Thao tác">
                                            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                                <circle cx="8" cy="3.2" r="1.4"/>
                                                <circle cx="8" cy="8" r="1.4"/>
                                                <circle cx="8" cy="12.8" r="1.4"/>
                                            </svg>
                                        </summary>
                                        <div class="row-menu-items">
                                            @* href giữ trang đầy đủ làm dự phòng khi không có JS; bình thường mở hộp thoại. *@
                                            <a href="@Url.Action("Detail", "MyWork", new { id = t.Id })"
                                               data-modal-url="@Url.Action("Detail", "Checklist", new { id = t.Id })"
                                               data-modal-title="Chi tiết công việc"
                                               data-modal-size="lg">Chi tiết &amp; trao đổi</a>
                                            @if (row.CanEdit)
                                            {
                                                <a href="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id, id = t.Id })"
                                                   data-modal-url="@Url.Action("Edit", "Checklist", new { projectId = Model.Project.Id, id = t.Id })"
                                                   data-modal-title="@(row.CanEditAll ? "Sửa công việc" : "Cập nhật tiến độ")">
                                                    @(row.CanEditAll ? "Sửa thông tin" : "Cập nhật tiến độ")
                                                </a>
                                            }
                                            @if (row.CanEditAll)
                                            {
                                                <div class="row-menu-sep"></div>
                                                using (Html.BeginForm("Delete", "Checklist", new { projectId = Model.Project.Id, id = t.Id }, FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="danger"
                                                            onclick="return confirm('Xoá mục &quot;@t.Title&quot; và toàn bộ mục con?');">Xoá mục</button>
                                                }
                                            }
                                        </div>
                                    </details>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.Partial("_Pager", Model.Rows.Pager)

        <div class="panel-foot">
            <span>Bấm vào một dòng để xem chi tiết công việc</span>
            <span>
                Phân trang theo <b>mục gốc</b> — mỗi trang @Model.Rows.Pager.PageSize mục gốc kèm
                toàn bộ mục con, để cây không bị cắt rời giữa hai trang.
            </span>
        </div>
    }
</div>
}

@section Scripts {
    <script>
        $(function () {
            var params = new URLSearchParams(window.location.search);
            var highlightId = params.get('highlightTaskId') || params.get('taskId');
            if (highlightId && window.AppModal) {
                var $targetRow = $('tr[data-task-id="' + highlightId + '"]');
                if ($targetRow.length) {
                    $targetRow.css('background-color', 'rgba(56, 189, 248, 0.15)');
                    $('html, body').animate({ scrollTop: $targetRow.offset().top - 120 }, 300);
                }
                window.AppModal.open('@Url.Action("Detail", "Checklist")/' + highlightId, 'Chi tiết công việc', 'lg');
            }
        });
    </script>
}
