@model TTKDGP.ProjectManager.Models.TaskTimeLogViewModel
@*
    Khối "Giờ công" trong hộp chi tiết công việc. Được trả lại nguyên khối sau mỗi lần ghi/xoá
    để hộp thoại tự vẽ lại — chỉ MỘT nơi định nghĩa cách hiển thị giờ công.

    Mọi con số (trần, đã ghi, còn lại) do controller tính sẵn; ở đây không tính lại gì để màn
    hình không bao giờ nói khác với luật mà máy chủ dùng để chặn.
*@

<div class="timelog-summary">
    <div class="timelog-stat">
        <span class="timelog-stat-label">Đã ghi</span>
        <strong class="@(Model.IsOverCap ? "field-error" : "")">@Model.TaskTotal.ToString("0.##") giờ</strong>
    </div>
    <div class="timelog-stat">
        <span class="timelog-stat-label">Trần công việc</span>
        <strong>
            @if (Model.TaskCap.HasValue)
            {
                <text>@Model.TaskCap.Value.ToString("0.##") giờ</text>
            }
            else
            {
                <span class="muted">—</span>
            }
        </strong>
    </div>
    <div class="timelog-stat">
        <span class="timelog-stat-label">Còn lại</span>
        <strong>
            @if (Model.TaskRemaining.HasValue)
            {
                <text>@Model.TaskRemaining.Value.ToString("0.##") giờ</text>
            }
            else
            {
                <span class="muted">—</span>
            }
        </strong>
    </div>
    <div class="timelog-stat">
        <span class="timelog-stat-label">Hôm nay bạn đã ghi</span>
        <strong>@Model.TodayTotal.ToString("0.##")/@Model.MaxPerDay.ToString("0.##") giờ</strong>
    </div>
</div>

@if (Model.TaskCap.HasValue)
{
    <div class="progress-track timelog-bar" title="Đã dùng @Model.UsedPercent% trần công việc">
        <div class="progress-fill @(Model.IsOverCap ? "timelog-over" : "")" style="width:@Model.UsedPercent%"></div>
    </div>
}

@if (Model.IsOverCap)
{
    <div class="alert alert-danger timelog-alert">
        Tổng giờ đã ghi vượt trần của công việc. Hãy xoá bớt một lượt hoặc nhờ người giao việc
        nới hạn hoàn thành.
    </div>
}

@if (Model.HasLogs)
{
    <div class="table-wrap timelog-table">
        <table class="data">
            <thead>
                <tr>
                    <th>Ngày</th>
                    <th class="num">Giờ</th>
                    <th>Nội dung</th>
                    <th>Người ghi</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="nowrap">@log.WorkDate.ToString("dd/MM/yyyy")</td>
                        <td class="num"><strong>@log.Hours.ToString("0.##")</strong></td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(log.Note))
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                <text>@log.Note</text>
                            }
                        </td>
                        <td class="muted nowrap">@log.UserName</td>
                        <td class="nowrap">
                            @* Chỉ xoá được dòng của chính mình, và chỉ khi việc còn mở. *@
                            @if (log.UserId == Model.CurrentUserId && Model.CanLog)
                            {
                                <button type="button" class="timelog-del" data-timelog-id="@log.Id">Xoá</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="muted timelog-empty">Chưa ghi giờ nào cho công việc này.</p>
}

@if (Model.CanLog)
{
    <div class="timelog-form">
        <div class="timelog-row">
            <div class="timelog-field">
                <label for="logDate">Ngày làm</label>
                <input type="date" id="logDate" value="@Model.DefaultDate.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="timelog-field timelog-field-hours">
                <label for="logHours">Số giờ</label>
                @* Nhận cả "2.5" lẫn "2,5" — gửi nguyên văn, máy chủ tự đọc theo khuôn cố định.
                   Dùng type=text + inputmode để bàn phím điện thoại vẫn ra bàn phím số mà trình
                   duyệt không tự ép định dạng theo ngôn ngữ máy. *@
                <input type="text" id="logHours" inputmode="decimal" autocomplete="off"
                       placeholder="2,5" />
            </div>
            <div class="timelog-field timelog-field-note">
                <label for="logNote">Nội dung đã làm</label>
                <input type="text" id="logNote" maxlength="500" autocomplete="off"
                       placeholder="Không bắt buộc" />
            </div>
            <button type="button" id="logTimeAdd" class="btn btn-primary timelog-submit">Ghi giờ</button>
        </div>
        <span class="hint">
            Nhập giờ lẻ được: <strong>2,5</strong> hoặc <strong>2.5</strong> đều là hai tiếng rưỡi.
            Tối đa <strong>@Model.MaxPerDay.ToString("0.##") giờ</strong> mỗi ngày tính trên tất cả
            công việc — hôm nay còn <strong>@Model.TodayRemaining.ToString("0.##") giờ</strong>.
        </span>
    </div>
}
else
{
    <span class="hint timelog-blocked">@Model.BlockedReason</span>
}
