@model TTKDGP.ProjectManager.Models.ChecklistViewModel
@using TTKDGP.ProjectManager.Models
@*
    Bảng Kanban của một dự án. Mỗi cột là một trạng thái; kéo thẻ sang cột khác là đổi trạng thái.

    Thẻ nào người đang xem không được sửa thì KHÔNG đặt draggable — chặn ngay từ giao diện cho đỡ
    hụt hẫng, còn quyền thật vẫn kiểm lại ở phía máy chủ khi nhận yêu cầu.
*@
<div class="kanban" data-kanban data-url="@Url.Action("SetState", "Checklist")">
    @Html.AntiForgeryToken()

    @foreach (var column in Model.Columns)
    {
        <div class="kanban-col" data-state="@column.State">
            <div class="kanban-col-head">
                <span>@column.Title</span>
                <span class="kanban-count" data-count>@column.Cards.Count</span>
            </div>

            <div class="kanban-drop" data-drop>
                @foreach (var card in column.Cards)
                {
                    var t = card.Task;

                    @* Mức gấp nói bằng dải màu bên trái thẻ, KHÔNG tô nền cả thẻ nữa.
                       Nền vàng/đỏ cả thẻ làm chữ khó đọc và khiến bảng trông loang lổ,
                       trong khi dải màu vẫn thấy rõ khi lướt mà thẻ vẫn sạch. *@
                    var alert = t.IsOverdue ? " card-late" : (t.IsDueSoon ? " card-soon" : "");

                    var priKey = t.Priority == TaskPriorities.High ? "cao"
                               : t.Priority == TaskPriorities.Low ? "thap"
                               : "vua";

                    var who = string.IsNullOrWhiteSpace(t.AssigneeName) ? null : t.AssigneeName.Trim();
                    var initials = "—";
                    if (who != null)
                    {
                        var parts = who.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                        initials = parts.Length == 1
                            ? parts[0].Substring(0, 1).ToUpper()
                            : (parts[parts.Length - 2].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper();
                    }

                    <div class="kanban-card@(card.CanEdit ? "" : " is-locked")@alert"
                         data-card
                         data-id="@t.Id"
                         draggable="@(card.CanEdit ? "true" : "false")"
                         data-modal-url="@Url.Action("Detail", "Checklist", new { id = t.Id })"
                         data-modal-title="Chi tiết công việc"
                         data-modal-size="lg">
                        <div class="kanban-head">
                            @if (!string.IsNullOrWhiteSpace(t.Code))
                            {
                                <span class="lead-code">@t.Code</span>
                            }
                            <span class="lead-kind">@TaskKinds.Display(t.Kind)</span>
                            <span class="pri pri-@priKey" title="Ưu tiên @TaskPriorities.Display(t.Priority)"><i></i></span>
                        </div>

                        <span class="kanban-title">@t.Title</span>

                        @if (t.IsOverdue || t.IsDueSoon)
                        {
                            <div class="kanban-meta">
                                @if (t.IsOverdue)
                                {
                                    <span class="pill pill-late js-due-badge"><i></i>Quá hạn @(-t.DaysLeft) ngày</span>
                                }
                                else
                                {
                                    <span class="pill pill-warn js-due-badge"><i></i>@(t.DaysLeft == 0 ? "Hết hạn hôm nay" : "Còn 1 ngày")</span>
                                }
                            </div>
                        }

                        @* Thanh tiến độ mảnh: so sánh các thẻ bằng mắt khi lướt cả cột. *@
                        <div class="prog @(t.Progress >= 100 ? "prog-full" : "")">
                            <div class="prog-track"><i style="width:@t.Progress%"></i></div>
                            <span>@t.Progress%</span>
                        </div>

                        <div class="kanban-foot">
                            <div class="person" title="@(who ?? "(chưa giao)")">
                                <span class="person-ava">@initials</span>
                                <span>@(who ?? "(chưa giao)")</span>
                            </div>
                            <span class="muted">@(t.DueDate.HasValue ? t.DueDate.Value.ToString("dd/MM") : "—")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@{
    var cardCount = ViewBag.KanbanCardCount == null ? Model.TotalCount : (int)ViewBag.KanbanCardCount;
    var hiddenCount = ViewBag.KanbanHiddenCount == null ? 0 : (int)ViewBag.KanbanHiddenCount;
}
<div class="panel">
    <div class="panel-foot">
        <span>
            Bấm vào thẻ để xem chi tiết. Kéo thẻ sang cột khác để đổi trạng thái — chỉ kéo được
            thẻ bạn có quyền sửa: PM dự án và Quản lý Tổ kéo được mọi thẻ, người còn lại chỉ kéo
            được việc giao cho mình.
        </span>
        <span>
            Hiển thị <b>@cardCount</b> việc có hạn hoàn thành@(
                hiddenCount > 0 ? "; " + hiddenCount + " mục cha gom nhóm/việc chưa đặt hạn chỉ xem ở dạng lưới" : "").
        </span>
    </div>
</div>
