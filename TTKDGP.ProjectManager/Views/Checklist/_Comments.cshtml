@model TTKDGP.ProjectManager.Models.TaskCommentsViewModel
@using System.Text.RegularExpressions
@using System.Web
@using TTKDGP.ProjectManager.Infrastructure
@using TTKDGP.ProjectManager.Models
@*
    Danh sách trao đổi trong hộp thoại chi tiết công việc. Được trả lại nguyên khối sau mỗi lần
    gửi/thu hồi để hộp thoại tự vẽ lại — chỉ MỘT nơi định nghĩa cách hiển thị một lượt trao đổi.
*@

@if (Model.Comments.Count == 0)
{
    <div class="chat-empty">
        Chưa có trao đổi nào. Có vướng mắc gì thì trao đổi ngay tại đây —
        gõ <strong>&#64;</strong> để nhắc người tham gia dự án.
    </div>
}
else
{
    foreach (var c in Model.Comments)
    {
        <div class="chat-item @(c.IsDeleted ? "recalled" : "")">
            <div class="chat-meta">
                <strong>@c.AuthorName</strong>
                <span class="muted">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                @if (!c.IsDeleted && (c.UserId == Model.CurrentUserId || Model.CanModerate))
                {
                    <button type="button" class="chat-recall" data-comment-id="@c.Id">Thu hồi</button>
                }
            </div>
            @if (c.IsDeleted)
            {
                <div class="chat-content muted"><em>Nội dung đã thu hồi.</em></div>
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(c.Content))
                {
                    @* Nội dung soạn bằng trình soạn thảo: đã lọc qua HtmlSanitizer khi lưu, lọc
                       thêm lần nữa trong Highlight rồi mới tô @tên. *@
                    <div class="chat-content rich-content">@Highlight(c.Content)</div>
                }
                if (c.HasAttachment)
                {
                    <a class="chat-file" href="@Url.Action("Attachment", "Checklist", new { commentId = c.Id })">
                        <span class="chat-file-icon">&#128206;</span>
                        <span class="chat-file-label">@c.AttachmentName</span>
                        <span class="muted">(@CommentAttachments.SizeLabel(c.AttachmentSize))</span>
                    </a>
                }
            }
        </div>
    }
}

@functions {
    /// <summary>
    /// Lọc nội dung về tập thẻ an toàn rồi tô đậm các cụm @Tên khớp với người tham gia.
    ///
    /// Nội dung đến từ trình soạn thảo nên đã là HTML và ĐÃ được lọc lúc lưu; ToDisplay lọc
    /// thêm lần nữa ở đây (và tự mã hoá nếu là trao đổi cũ dạng chữ thuần), nên chuỗi đưa vào
    /// Html.Raw luôn nằm trong danh sách trắng.
    ///
    /// Chỉ tô ở PHẦN CHỮ NẰM NGOÀI THẺ: tách chuỗi theo từng thẻ rồi chỉ thay trong các đoạn
    /// giữa. Thay thẳng trên cả chuỗi thì một cái tên trùng với thuộc tính bên trong thẻ
    /// (href="...@...") sẽ bị chèn span vào giữa và làm vỡ thẻ đó.
    /// </summary>
    private IHtmlString Highlight(string content)
    {
        var html = HtmlSanitizer.ToDisplay(content) ?? string.Empty;

        var names = Model.Participants
            .Where(x => !string.IsNullOrWhiteSpace(x.FullName))
            .Select(x => x.FullName.Trim())
            .OrderByDescending(n => n.Length)
            .ToList();

        if (names.Count == 0) return new HtmlString(html);

        // Tách thành các mảnh: mảnh bắt đầu bằng '<' là thẻ (giữ nguyên), còn lại là chữ.
        var parts = Regex.Split(html, "(<[^>]*>)");

        for (var i = 0; i < parts.Length; i++)
        {
            if (parts[i].StartsWith("<", StringComparison.Ordinal)) continue;

            foreach (var name in names)
            {
                // Tên trong phần chữ đã ở dạng đã mã hoá, nên mẫu so khớp cũng phải mã hoá y hệt.
                var pattern = "@" + Regex.Escape(HttpUtility.HtmlEncode(name));
                parts[i] = Regex.Replace(parts[i], pattern,
                    m => "<span class=\"mention\">" + m.Value + "</span>",
                    RegexOptions.IgnoreCase);
            }
        }

        return new HtmlString(string.Concat(parts));
    }
}
