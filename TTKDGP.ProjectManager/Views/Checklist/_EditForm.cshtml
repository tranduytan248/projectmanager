@model TTKDGP.ProjectManager.Models.WorkTask
@using TTKDGP.ProjectManager.Models
@*
    Form một mục checklist, dùng chung cho hộp thoại và trang riêng.
*@
@{
    var isNew = Model.Id == 0;
    var users = ViewBag.Users as List<User> ?? new List<User>();
    var parents = ViewBag.ParentOptions as List<WorkTask> ?? new List<WorkTask>();

    // Nhãn tuần phải nói rõ ngày đầu–cuối, mà ngày đó phụ thuộc năm; chưa chọn năm thì lấy năm hiện tại.
    var weekYear = Model.Year > 0 ? Model.Year : WeekHelper.CurrentYear;

    // Tiến độ chọn theo nấc 10%. Giá trị lẻ đã lưu từ trước (ví dụ 35) vẫn phải có trong danh
    // sách, nếu không mở form ra là bị đổi ngầm sang nấc gần nhất.
    var progressOptions = Enumerable.Range(0, 11).Select(i => i * 10).ToList();
    if (!progressOptions.Contains(Model.Progress))
    {
        progressOptions.Add(Model.Progress);
        progressOptions.Sort();
    }

    // Bảng tra tuần theo năm để đổi hạn hoàn thành là tuần/năm bám theo ngay, không nạp lại trang.
    // Kèm ngày đầu–cuối mỗi tuần để phía JS chỉ so chuỗi ngày, logic tính tuần ISO vẫn ở máy chủ.
    var weekYears = new SortedSet<int>();
    for (var y = WeekHelper.CurrentYear - 1; y <= WeekHelper.CurrentYear + 3; y++) { weekYears.Add(y); }
    weekYears.Add(weekYear);
    if (Model.DueDate.HasValue) { weekYears.Add(WeekHelper.GetYear(Model.DueDate.Value)); }

    var weeksByYear = new Dictionary<string, object>();
    foreach (var y in weekYears)
    {
        var list = new List<object>();
        foreach (var opt in WeekHelper.WeekOptions(y))
        {
            list.Add(new
            {
                w = opt.Key,
                label = opt.Value,
                from = WeekHelper.FirstDayOfWeek(y, opt.Key).ToString("yyyy-MM-dd"),
                to = WeekHelper.LastDayOfWeek(y, opt.Key).ToString("yyyy-MM-dd")
            });
        }
        weeksByYear[y.ToString()] = list;
    }

    // PM dự án và Quản lý Tổ sửa được mọi thứ. Người thực hiện chỉ báo cáo tiến độ việc của mình,
    // nên phần giao việc chỉ hiện ra để đọc.
    var canEditAll = ViewBag.CanEditAll == null || (bool)ViewBag.CanEditAll;
    var assigneeName = users.Where(u => u.Id == Model.AssigneeUserId)
        .Select(u => u.FullName).FirstOrDefault();
}

@using (Html.BeginForm("Edit", "Checklist", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ProjectId)
    @Html.ValidationSummary(false, null, new { @class = "validation-summary-errors" })

    <div class="form-grid">
    @if (!canEditAll)
    {
        <div class="form-static full">
            <span class="form-static-label">Công việc</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.Code) ? Model.Title : Model.Code + " · " + Model.Title)</strong>
        </div>

        <div class="form-static">
            <span class="form-static-label">Loại · Ưu tiên</span>
            @TaskKinds.Display(Model.Kind) · @TaskPriorities.Display(Model.Priority)
        </div>

        <div class="form-static">
            <span class="form-static-label">Người thực hiện</span>
            @(string.IsNullOrWhiteSpace(assigneeName) ? "(chưa giao)" : assigneeName)
        </div>

        <div class="form-static">
            <span class="form-static-label">Hạn hoàn thành</span>
            @(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("dd/MM/yyyy") : "—")
        </div>

        <div class="form-static">
            <span class="form-static-label">Thuộc tuần</span>
            @(Model.Week > 0 ? "Tuần " + Model.Week + "/" + Model.Year : "—")
        </div>
    }
    else
    {
        <div class="form-field">
            @Html.LabelReq(m => m.Kind)
            @Html.DropDownListFor(m => m.Kind,
                TaskKinds.InProject.Select(k => new SelectListItem
                {
                    Value = k,
                    Text = TaskKinds.Display(k),
                    Selected = Model.Kind == k
                }))
            <span class="hint">Việc theo checklist kế hoạch là "Triển khai"; việc phát sinh trong giai đoạn hỗ trợ là "Hỗ trợ".</span>
        </div>

        <div class="form-field">
            @Html.LabelReq(m => m.Priority)
            @Html.DropDownListFor(m => m.Priority,
                TaskPriorities.All.Select(p => new SelectListItem
                {
                    Value = p,
                    Text = TaskPriorities.Display(p),
                    Selected = Model.Priority == p
                }))
        </div>

        <div class="form-field full">
            @Html.LabelReq(m => m.Title)
            @Html.TextBoxFor(m => m.Title)
            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelReq(m => m.Code)
            @Html.TextBoxFor(m => m.Code)
            <span class="hint">Ví dụ CL-01. Chỉ cần duy nhất trong dự án này.</span>
            @Html.ValidationMessageFor(m => m.Code, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            <label for="ParentId">Mục cha</label>
            <select id="ParentId" name="ParentId">
                <option value="0">— Mục gốc —</option>
                @foreach (var p in parents)
                {
                    <option value="@p.Id" selected="@(Model.ParentId == p.Id)">
                        @(string.IsNullOrWhiteSpace(p.Code) ? p.Title : p.Code + " · " + p.Title)
                    </option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.ParentId, "", new { @class = "field-error" })
        </div>

        @* Chiếm trọn hàng để Ngày bắt đầu rơi xuống nằm cạnh Hạn hoàn thành,
           kéo theo Tuần cạnh Năm và Trạng thái cạnh Tiến độ. *@
        <div class="form-field full">
            @Html.LabelReq(m => m.AssigneeUserId)
            @Html.DropDownListFor(m => m.AssigneeUserId,
                new SelectList(users, "Id", "FullName", Model.AssigneeUserId), "— Chưa giao —")
            <span class="hint">Chỉ gồm người đang tham gia dự án này.</span>
            @Html.ValidationMessageFor(m => m.AssigneeUserId, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelReq(m => m.StartDate)
            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { type = "date" })
        </div>

        @* Bắt buộc theo nghiệp vụ, ChecklistController kiểm tay. Không khai [Required] trên
           model được vì WorkTask còn dùng cho luồng nhập tiến độ và luồng nhập từ file. *@
        <div class="form-field">
            @Html.LabelReq(m => m.DueDate, required: true)
            @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new { type = "date" })
            <span class="hint">Bộ chấm chất lượng dựa vào đây để biết đúng hay trễ hạn.</span>
            @Html.ValidationMessageFor(m => m.DueDate, "", new { @class = "field-error" })
        </div>

        <div class="form-field">
            @Html.LabelReq(m => m.Week)
            @Html.DropDownListFor(m => m.Week,
                WeekHelper.WeekOptions(weekYear).Select(o => new SelectListItem
                {
                    Value = o.Key.ToString(),
                    Text = o.Value,
                    Selected = Model.Week == o.Key
                }), "— Không gắn tuần —")
            <span class="hint">Tự chọn theo hạn hoàn thành; vẫn đổi tay được.</span>
        </div>

        <div class="form-field">
            @Html.LabelReq(m => m.Year)
            @Html.TextBoxFor(m => m.Year, new { type = "number", min = "2000", max = "2100" })
            <span class="hint">Bỏ trống tuần thì bỏ qua ô này.</span>
        </div>
    }

        <div class="form-field">
            @Html.LabelReq(m => m.State)
            @Html.DropDownListFor(m => m.State,
                TaskStates.All.Select(s => new SelectListItem
                {
                    Value = s,
                    Text = TaskStates.Display(s),
                    Selected = Model.State == s
                }))
        </div>

        @if (!isNew)
        {
            <div class="form-field">
                @Html.LabelReq(m => m.Progress)
                @Html.DropDownListFor(m => m.Progress,
                    progressOptions.Select(p => new SelectListItem
                    {
                        Value = p.ToString(),
                        Text = p + "%",
                        Selected = Model.Progress == p
                    }))
                @Html.ValidationMessageFor(m => m.Progress, "", new { @class = "field-error" })
            </div>
        }

        <div class="form-field full">
            @Html.LabelReq(m => m.Description)
            @* Cùng trình soạn thảo với ô mô tả của dự án — nội dung lưu dạng HTML, đã lọc
               qua HtmlSanitizer.Clean khi lưu và ToDisplay khi hiển thị. *@
            @Html.TextAreaFor(m => m.Description, new { rows = 3, data_rich = "true" })
        </div>
    </div>

    if (!canEditAll)
    {
        <span class="hint">
            Bạn là người thực hiện việc này nên chỉ cập nhật được trạng thái, tiến độ và mô tả.
            Đổi hạn hoàn thành hay chuyển người thực hiện là việc của PM dự án hoặc Quản lý Tổ.
        </span>
    }

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@(isNew ? "Thêm mục" : "Lưu thay đổi")</button>
        <a class="btn btn-default" href="@Url.Action("Index", "Checklist", new { projectId = Model.ProjectId })">Huỷ</a>
    </div>
}

@if (canEditAll)
{
    <script type="application/json" id="cl-weeks-by-year">@Html.Raw(Json.Encode(weeksByYear))</script>
    <script>
        (function () {
            function init() {
                var $ = window.jQuery;
                var dataEl = document.getElementById('cl-weeks-by-year');
                var $due = $('#DueDate'), $week = $('#Week'), $year = $('#Year');
                if (!dataEl || !$due.length || !$week.length || !$year.length) return;

                var data = JSON.parse(dataEl.textContent);

                // Dựng lại danh sách tuần của một năm, giữ ô "— Không gắn tuần —" ở đầu.
                function rebuild(year, selected) {
                    var weeks = data[String(year)];
                    if (!weeks) return;

                    var empty = $week.find('option').first().clone();
                    $week.empty().append(empty);
                    $.each(weeks, function (_, item) {
                        $week.append(new Option(item.label, item.w, false, item.w === selected));
                    });

                    // Danh sách vừa đổi, báo Select2 vẽ lại phần hiển thị.
                    $week.trigger('change');
                }

                // Hạn hoàn thành đổi thì tuần/năm bám theo: chọn đúng tuần chứa ngày đó.
                // Ngày giáp ranh đầu/cuối năm có thể thuộc tuần của năm ISO kề bên, nên dò cả ba năm.
                $due.on('change', function () {
                    var v = $due.val();
                    if (!v) return;

                    var dueYear = parseInt(v.substring(0, 4), 10);
                    for (var y = dueYear - 1; y <= dueYear + 1; y++) {
                        var weeks = data[String(y)];
                        if (!weeks) continue;

                        for (var i = 0; i < weeks.length; i++) {
                            if (weeks[i].from <= v && v <= weeks[i].to) {
                                $year.val(y);
                                rebuild(y, weeks[i].w);
                                return;
                            }
                        }
                    }
                });

                // Đổi năm bằng tay cũng dựng lại danh sách tuần, giữ số tuần đang chọn nếu năm mới vẫn có.
                $year.on('change', function () {
                    var y = parseInt($year.val(), 10);
                    if (y > 0) rebuild(y, parseInt($week.val(), 10));
                });
            }

            // Trong hộp thoại jQuery đã có sẵn; mở bằng trang riêng thì jQuery nạp ở cuối trang
            // nên phải chờ DOMContentLoaded.
            if (window.jQuery) { init(); } else { document.addEventListener('DOMContentLoaded', init); }
        })();
    </script>
}
