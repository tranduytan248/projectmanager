@model TTKDGP.ProjectManager.Models.PagedList<TTKDGP.ProjectManager.Models.LeaveRequest>
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Duyệt nghỉ phép";
    var users = ViewBag.Users as List<User> ?? new List<User>();
    var years = ViewBag.Years as List<int> ?? new List<int>();
    var query = ViewBag.Query as string;
    var userId = (int)ViewBag.UserId;
    var state = ViewBag.State as string;
    var year = (int)ViewBag.Year;
    var month = (int)ViewBag.Month;
    var pendingCount = (int)ViewBag.PendingCount;

    // Chuỗi truy vấn hiện tại để sau khi duyệt còn quay lại đúng chỗ đang đứng.
    var returnQuery = Request.Url == null ? string.Empty : Request.Url.Query;
}

<div class="page-head">
    <div>
        <h1>Duyệt nghỉ phép</h1>
        <p>
            @if (pendingCount > 0)
            {
                <strong>@pendingCount đơn đang chờ duyệt.</strong>
            }
            else
            {
                <text>Không còn đơn nào chờ duyệt.</text>
            }
            Ngày nghỉ đã duyệt sẽ tự trừ vào giờ công yêu cầu khi chấm KPI tháng.
        </p>
    </div>
    <a class="btn btn-default" href="@Url.Action("Index", "Kpi")">KPI theo tháng &rarr;</a>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Approve", "Leaves", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field grow">
                    <label for="q">Tìm kiếm</label>
                    <input type="search" id="q" name="q" value="@query" placeholder="Họ tên hoặc lý do..." />
                </div>

                <div class="filter-field">
                    <label for="userId">Nhân sự</label>
                    <select id="userId" name="userId">
                        <option value="0">— Tất cả —</option>
                        @foreach (var u in users)
                        {
                            <option value="@u.Id" selected="@(userId == u.Id)">@u.FullName</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="state">Trạng thái</label>
                    <select id="state" name="state">
                        <option value="" selected="@(state == "")">— Tất cả —</option>
                        @foreach (var s in LeaveStates.All)
                        {
                            <option value="@s" selected="@(state == s)">@LeaveStates.Display(s)</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="month">Tháng</label>
                    <select id="month" name="month">
                        <option value="0">— Tất cả —</option>
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(month == m)">Tháng @m</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="year">Năm</label>
                    <select id="year" name="year">
                        <option value="0">— Tất cả —</option>
                        @foreach (var y in years)
                        {
                            <option value="@y" selected="@(year == y)">@y</option>
                        }
                    </select>
                </div>

                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a class="btn btn-default" href="@Url.Action("Approve", "Leaves")">Bỏ lọc</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">Không có đơn nào khớp bộ lọc.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Nhân sự</th>
                        <th>Thời gian nghỉ</th>
                        <th>Loại</th>
                        <th class="num">Số ngày</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@l.UserFullName</strong>
                                <div class="muted nowrap">Gửi @l.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td class="nowrap">
                                <strong>@l.FromDate.ToString("dd/MM/yyyy")</strong>
                                @if (l.ToDate.Date != l.FromDate.Date)
                                {
                                    <text>&ndash; @l.ToDate.ToString("dd/MM/yyyy")</text>
                                }
                                @if (l.IsHalfDay)
                                {
                                    <div class="muted">@(string.IsNullOrWhiteSpace(l.HalfDaySession) ? "Nửa ngày" : l.HalfDaySession)</div>
                                }
                            </td>
                            <td>@LeaveKinds.Display(l.Kind)</td>
                            <td class="num"><strong>@l.Days.ToString("0.#")</strong></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(l.Reason))
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    @l.Reason
                                }
                            </td>
                            <td>
                                <span class="@LeaveStates.BadgeClass(l.State)">@LeaveStates.Display(l.State)</span>
                                @if (l.ApprovedAt.HasValue)
                                {
                                    <div class="muted nowrap">@l.ApprovedByName · @l.ApprovedAt.Value.ToString("dd/MM/yyyy")</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(l.ApproverNote))
                                {
                                    <div class="muted">@l.ApproverNote</div>
                                }
                            </td>
                            <td class="actions">
                                @if (l.State == LeaveStates.Pending)
                                {
                                    using (Html.BeginForm("SetState", "Leaves", FormMethod.Post, new { @class = "leave-approve-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <input type="hidden" name="returnQuery" value="@returnQuery" />
                                        <input type="text" name="note" placeholder="Ý kiến (bắt buộc khi từ chối)"
                                               class="leave-note" />
                                        <div class="btn-group">
                                            <button type="submit" name="state" value="@LeaveStates.Approved"
                                                    class="btn btn-primary btn-sm"
                                                    onclick="return confirm('Duyệt đơn nghỉ @l.Days.ToString("0.#") ngày của @l.UserFullName?');">Duyệt</button>
                                            <button type="submit" name="state" value="@LeaveStates.Rejected"
                                                    class="btn btn-default btn-sm">Từ chối</button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.Partial("_Pager", Model.Pager)
    }
</div>
