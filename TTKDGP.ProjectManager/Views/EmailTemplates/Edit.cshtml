@model TTKDGP.ProjectManager.Models.EmailTemplate
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Mẫu email — " + Model.Name;
    var definition = ViewBag.Definition as EmailTemplateDefinition;

    ViewBag.Crumbs = new List<Crumb>
    {
        new Crumb { Label = "Mẫu email", Url = Url.Action("Index", "EmailTemplates") },
        new Crumb { Label = Model.Name }
    };
}

<div class="page-head">
    <div>
        <h1>@Model.Name</h1>
        <p>@(definition == null ? "" : definition.Description)</p>
    </div>
    <a class="btn btn-default" href="@Url.Action("Index", "EmailTemplates")">&larr; Danh sách mẫu</a>
</div>

<div class="tpl-layout">
    <div class="card tpl-main">
        <div class="card-body">
            @using (Html.BeginForm("Edit", "EmailTemplates", FormMethod.Post, new { id = "tplForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Code)
                @Html.HiddenFor(m => m.Name)
                @Html.ValidationSummary(false, null, new { @class = "validation-summary-errors" })

                <div class="form-field">
                    @Html.LabelReq(m => m.Subject)
                    @Html.TextBoxFor(m => m.Subject)
                    @Html.ValidationMessageFor(m => m.Subject, "", new { @class = "field-error" })
                    <span class="hint">Tiêu đề cũng chèn được tham số, ví dụ {{TenDuAn}}.</span>
                </div>

                <div class="form-field">
                    @Html.LabelReq(m => m.Body)

                    @* Thanh công cụ của trình soạn thảo — không phụ thuộc thư viện ngoài. *@
                    <div class="wys-toolbar" id="wysToolbar">
                        <button type="button" data-cmd="bold" title="Đậm (Ctrl+B)"><strong>B</strong></button>
                        <button type="button" data-cmd="italic" title="Nghiêng (Ctrl+I)"><em>I</em></button>
                        <button type="button" data-cmd="underline" title="Gạch chân (Ctrl+U)"><u>U</u></button>
                        <span class="wys-sep"></span>
                        <button type="button" data-cmd="insertUnorderedList" title="Danh sách chấm">&bull; &mdash;</button>
                        <button type="button" data-cmd="insertOrderedList" title="Danh sách số">1. &mdash;</button>
                        <span class="wys-sep"></span>
                        <button type="button" data-act="link" title="Chèn liên kết">Liên kết</button>
                        <button type="button" data-cmd="removeFormat" title="Xoá định dạng">Xoá định dạng</button>
                        <span class="wys-sep"></span>
                        <button type="button" data-act="html" title="Xem/sửa mã HTML">HTML</button>
                    </div>

                    <div class="wys-editor" id="wysEditor" contenteditable="true"></div>
                    <textarea id="wysSource" class="wys-source" style="display:none" rows="10"></textarea>
                    @Html.HiddenFor(m => m.Body, new { id = "BodyField" })
                    @Html.ValidationMessageFor(m => m.Body, "", new { @class = "field-error" })
                </div>

                <div class="check-inline">
                    @Html.CheckBoxFor(m => m.IsActive)
                    @Html.LabelReq(m => m.IsActive)
                </div>
                <span class="hint">Bỏ đánh dấu thì loại này không gửi mail nữa — thông báo trên web vẫn hoạt động.</span>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Lưu mẫu</button>
                </div>
            }

            <div class="btn-row" style="margin-top:12px">
                @using (Html.BeginForm("SendTest", "EmailTemplates", FormMethod.Post, new { @class = "inline-form" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="code" value="@Model.Code" />
                    <button type="submit" class="btn btn-default">Gửi thử tới email của tôi</button>
                }
                @using (Html.BeginForm("Reset", "EmailTemplates", FormMethod.Post, new { @class = "inline-form" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="code" value="@Model.Code" />
                    <button type="submit" class="btn btn-default"
                            onclick="return confirm('Đưa mẫu về nội dung mặc định của hệ thống? Nội dung đang sửa sẽ mất.');">
                        Về mẫu mặc định
                    </button>
                }
            </div>
            <span class="hint">"Gửi thử" dùng mẫu ĐÃ LƯU với dữ liệu minh hoạ — nhớ bấm Lưu trước.</span>
        </div>
    </div>

    <div class="card tpl-side">
        <div class="card-head">Tham số chèn được</div>
        <div class="card-body">
            <p class="hint" style="margin-top:0">
                Bấm một tham số để chèn vào chỗ con trỏ đang đứng. Lúc gửi, hệ thống thay tham số
                bằng giá trị thật của từng người nhận.
            </p>
            <div class="tpl-params">
                @if (definition != null)
                {
                    foreach (var p in definition.Params)
                    {
                        <button type="button" class="tpl-param" data-param="@p.Key" title="@p.Label">
                            <code>{{@p.Key}}</code>
                            <span>@p.Label</span>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

<script>
    // Trình soạn thảo tự chứa: contenteditable + execCommand, đồng bộ HTML vào ô ẩn khi lưu.
    (function () {
        'use strict';

        var editor = document.getElementById('wysEditor');
        var source = document.getElementById('wysSource');
        var field = document.getElementById('BodyField');
        var form = document.getElementById('tplForm');
        var toolbar = document.getElementById('wysToolbar');
        if (!editor || !form) return;

        var htmlMode = false;

        editor.innerHTML = field.value;

        function syncField() {
            field.value = htmlMode ? source.value : editor.innerHTML;
        }

        toolbar.addEventListener('click', function (e) {
            var btn = e.target.closest('button');
            if (!btn) return;
            e.preventDefault();

            var act = btn.getAttribute('data-act');

            // Chế độ HTML: chỉ nút "HTML" còn tác dụng (bấm lần nữa để quay về soạn thảo).
            if (act === 'html') {
                if (htmlMode) {
                    editor.innerHTML = source.value;
                    source.style.display = 'none';
                    editor.style.display = '';
                    btn.classList.remove('active');
                } else {
                    source.value = editor.innerHTML;
                    editor.style.display = 'none';
                    source.style.display = '';
                    btn.classList.add('active');
                }
                htmlMode = !htmlMode;
                return;
            }
            if (htmlMode) return;

            editor.focus();

            if (act === 'link') {
                var url = window.prompt('Địa chỉ liên kết:', 'https://');
                if (url) document.execCommand('createLink', false, url);
                return;
            }

            var cmd = btn.getAttribute('data-cmd');
            if (cmd) document.execCommand(cmd, false, null);
        });

        // Chèn tham số vào chỗ con trỏ; đang ở chế độ HTML thì nối vào cuối ô mã.
        document.querySelectorAll('.tpl-param').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var token = '{{' + btn.getAttribute('data-param') + '}}';
                if (htmlMode) {
                    source.value += token;
                    source.focus();
                    return;
                }
                editor.focus();
                document.execCommand('insertText', false, token);
            });
        });

        form.addEventListener('submit', syncField);
    })();
</script>
