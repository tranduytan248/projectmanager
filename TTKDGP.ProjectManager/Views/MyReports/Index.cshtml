@model TTKDGP.ProjectManager.Models.MyReportViewModel
@using TTKDGP.ProjectManager.Infrastructure
@{
    ViewBag.Title = "Báo cáo của tôi";
    var weekOptions = WeekHelper.WeekOptions(Model.Year);
}

<div class="page-head">
    <div>
        <h1>Báo cáo của tôi</h1>
        <p>
            Ghi nội dung công việc theo tuần cho các dự án bạn đang thực hiện hoặc đang hỗ trợ.
            @if (!string.IsNullOrWhiteSpace(Model.MemberName))
            {
                <text>Nhân sự: <strong>@Model.MemberName</strong>.</text>
            }
        </p>
    </div>

    <div class="week-box">
        <div class="week-box-title">Tuần @Model.Week/@Model.Year</div>
        <div class="week-box-range">@Model.WeekFrom.ToString("dd/MM") – @Model.WeekTo.ToString("dd/MM/yyyy")</div>
        <div class="week-box-stats">
            @if (Model.ReportedCount > 0)
            {
                <span class="badge badge-active">@Model.ReportedCount đã báo cáo</span>
            }
            @if (Model.MissingCount > 0)
            {
                <span class="badge badge-waiting">@Model.MissingCount chưa báo cáo</span>
            }
        </div>
    </div>
</div>

@if (Model.NotLinked)
{
    <div class="card">
        <div class="empty-state">
            Tài khoản của bạn chưa được gắn với nhân sự nào nên chưa biết báo cáo cho phân công nào.<br />
            Liên hệ quản trị để gắn &quot;Nhân sự tương ứng&quot; cho tài khoản.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm("Index", "MyReports", FormMethod.Get))
            {
                <div class="filters">
                    <div class="filter-field">
                        <label for="year">Năm</label>
                        <select id="year" name="year">
                            @foreach (var y in Model.YearOptions)
                            {
                                <option value="@y" selected="@(Model.Year == y)">@y</option>
                            }
                        </select>
                    </div>
                    <div class="filter-field">
                        <label for="week">Tuần</label>
                        <select id="week" name="week">
                            @foreach (var w in weekOptions)
                            {
                                <option value="@w.Key" selected="@(Model.Week == w.Key)">@w.Value</option>
                            }
                        </select>
                    </div>
                    <div class="btn-row" style="padding-bottom:1px">
                        <button type="submit" class="btn btn-primary">Xem tuần này</button>
                        @if (!Model.IsCurrentWeek)
                        {
                            <a class="btn btn-default" href="@Url.Action("Index", "MyReports")">Về tuần hiện tại</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    if (Model.Rows.Count > 0)
    {
        <div class="card">
            <div class="card-body">
                <div style="display:flex;align-items:baseline;justify-content:space-between;gap:14px;flex-wrap:wrap">
                    <div style="font-size:15px;font-weight:600">
                        @(Model.MissingCount > 0
                            ? "Còn " + Model.MissingCount + " dự án chưa ghi báo cáo tuần này"
                            : "Đã ghi báo cáo đủ các dự án tuần này")
                    </div>
                    <div class="muted" style="font-size:13px">Đã ghi @Model.ReportedCount/@Model.TotalRows</div>
                </div>
                <div class="progress-track" style="margin-top:12px">
                    <div class="progress-fill" style="width:@(Model.ReportedPercent)%"></div>
                </div>
            </div>
        </div>
    }

    if (Model.Rows.Count == 0)
    {
        <div class="card">
            <div class="empty-state">
                Bạn không có phân công nào đang ở trạng thái &quot;Đang thực hiện&quot; hoặc &quot;Đang hỗ trợ&quot;.<br />
                Khi được phân công, các dự án sẽ hiện ở đây để báo cáo hằng tuần.
            </div>
        </div>
    }
    else
    {
        foreach (var row in Model.Rows)
        {
            <div class="card">
                <div class="card-head">
                    <span>
                        @row.ProjectName
                        @if (!string.IsNullOrWhiteSpace(row.Customer))
                        {
                            <span class="muted" style="font-weight:400"> · @row.Customer</span>
                        }
                    </span>
                    <span style="font-weight:400">
                        <span class="badge @ViewHelpers.StatusBadgeClass(row.WorkStatus)">@ViewHelpers.OrDash(row.WorkStatus)</span>
                        @if (row.HasReport)
                        {
                            <span class="badge badge-active">Đã báo cáo</span>
                        }
                        else
                        {
                            <span class="badge badge-waiting">Chưa báo cáo</span>
                        }
                    </span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Save", "MyReports", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="assignmentId" value="@row.AssignmentId" />
                        <input type="hidden" name="year" value="@Model.Year" />
                        <input type="hidden" name="week" value="@Model.Week" />

                        <div class="form-field">
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
                                <label for="content-@row.AssignmentId" style="margin:0">Nội dung thực hiện trong tuần</label>
                                @if (row.HasPrevious)
                                {
                                    <button type="button" class="btn btn-default btn-sm" data-reuse="@row.AssignmentId">
                                        Dùng lại nội dung @Model.PreviousWeekLabel
                                    </button>
                                }
                            </div>
                            <textarea id="content-@row.AssignmentId" name="content" rows="4"
                                      maxlength="2000" placeholder="Tuần này bạn đã làm gì trong dự án này?">@row.Content</textarea>
                            @if (row.HasPrevious)
                            {
                                <div id="prev-@row.AssignmentId" hidden>@row.PreviousContent</div>
                                <div class="hint">@Model.PreviousWeekLabel bạn ghi: “@row.PreviousContent”</div>
                            }
                        </div>

                        <div class="filters">
                            <div class="filter-field">
                                <label for="status-@row.AssignmentId">Trạng thái</label>
                                <select id="status-@row.AssignmentId" name="status" data-no-select2>
                                    @foreach (var s in Model.StatusOptions)
                                    {
                                        <option value="@s" selected="@(row.Status == s)">@s</option>
                                    }
                                </select>
                            </div>
                            <div class="btn-row" style="padding-bottom:1px">
                                <button type="submit" class="btn btn-primary">
                                    @(row.HasReport ? "Cập nhật báo cáo" : "Gửi báo cáo")
                                </button>
                            </div>
                        </div>

                        if (row.ReportedAt.HasValue)
                        {
                            <span class="hint">Lần ghi gần nhất: @row.ReportedAt.Value.ToString("HH:mm dd/MM/yyyy")</span>
                        }
                    }
                </div>
            </div>
        }
    }

    if (Model.Rows.Count > 0)
    {
        <div class="section-head" style="margin-top:8px">
            <h2>Vài tuần gần nhất</h2>
            <span class="muted">Trước @Model.WeekLabel</span>
        </div>
        <div class="card">
            @foreach (var h in Model.History)
            {
                <div class="hist-row">
                    <span class="hist-week">@h.WeekLabel</span>
                    <span class="hist-text">
                        @if (h.Reported > 0)
                        {
                            <span>@h.Reported/@h.Total dự án@(string.IsNullOrWhiteSpace(h.Snippet) ? "" : " · " + h.Snippet)</span>
                        }
                        else
                        {
                            <span class="muted">Chưa ghi báo cáo</span>
                        }
                    </span>
                    @if (h.Reported == 0)
                    {
                        <span class="badge badge-inactive">Trống</span>
                    }
                    else if (h.Full)
                    {
                        <span class="badge badge-active">Đủ</span>
                    }
                    else
                    {
                        <span class="badge badge-waiting">Thiếu @h.Missing</span>
                    }
                </div>
            }
        </div>
    }
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-reuse]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-reuse');
                    var src = document.getElementById('prev-' + id);
                    var ta = document.getElementById('content-' + id);
                    if (src && ta) { ta.value = src.textContent.trim(); ta.focus(); }
                });
            });
        })();
    </script>
}
