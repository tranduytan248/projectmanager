@model TTKDGP.ProjectManager.Models.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
}

<div class="login-wrap">
    <div class="card">
        <div class="card-body">
            <h1 class="login-title">Đăng nhập hệ thống</h1>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(false, null, new { @class = "validation-summary-errors" })

                <div class="form-field">
                    @Html.LabelReq(m => m.UserName)
                    @Html.TextBoxFor(m => m.UserName, new { autofocus = "autofocus", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "field-error" })
                </div>

                <div class="form-field">
                    @Html.LabelReq(m => m.Password)
                    @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
                </div>

                <div class="check-inline" style="padding-bottom:14px">
                    @Html.CheckBoxFor(m => m.RememberMe)
                    @Html.LabelReq(m => m.RememberMe)
                </div>

                <button type="submit" class="btn btn-primary">Đăng nhập</button>
            }

            <p class="muted" style="text-align:center;margin:18px 0 0;font-size:13px">
                Chỉ cần đăng nhập khi cập nhật dữ liệu.
                <a href="@Url.Action("Index", "Home")">Xem màn hình tổng hợp</a>
            </p>
        </div>
    </div>
</div>
