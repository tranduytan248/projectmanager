@model List<TTKDGP.ProjectManager.Models.User>
@using TTKDGP.ProjectManager.Infrastructure
@{
    ViewBag.Title = "Người dùng";
    var currentUser = ViewBag.CurrentUser as AppIdentity;
}

<div class="page-head">
    <div>
        <h1>Người dùng</h1>
        <p>Tài khoản đăng nhập để cập nhật dữ liệu. Tổng cộng @Model.Count tài khoản.</p>
    </div>
    <div class="btn-row">
        <a class="btn btn-default" href="@Url.Action("SyncPhones", "Users")">Lấy số điện thoại từ HRM</a>
        <a class="btn btn-default" href="@Url.Action("Provision", "Users")">Mở tài khoản cho nhân sự</a>
        <a class="btn btn-primary" href="@Url.Action("Edit", "Users")">+ Tạo người dùng</a>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Tên đăng nhập</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Phân quyền</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isSelf = currentUser != null && currentUser.UserId == u.Id;
                    <tr>
                        <td>
                            <strong>@u.UserName</strong>
                            @if (isSelf)
                            {
                                <span class="muted"> (bạn)</span>
                            }
                        </td>
                        <td>@u.FullName</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(u.Email))
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                <a href="mailto:@u.Email">@u.Email</a>
                            }
                        </td>
                        <td class="nowrap">
                            @if (string.IsNullOrWhiteSpace(u.Phone))
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                <text>@u.Phone</text>
                            }
                        </td>
                        <td>
                            @* Một tài khoản có thể mang nhiều nhóm — hiện tên từng nhóm. *@
                            @foreach (var r in TTKDGP.ProjectManager.Models.Roles.Split(u.Role))
                            {
                                var grp = TTKDGP.ProjectManager.Data.Repository.RoleGroups
                                    .FirstOrDefault(g => string.Equals(g.Code, r, StringComparison.OrdinalIgnoreCase));
                                <span class="badge badge-role">@(grp != null ? grp.Name : r)</span>
                            }
                            @* Vai Quản lý Tổ nằm ngoài nhóm quyền nên phải hiện riêng, không thì
                               nhìn bảng không biết ai đang xem được việc của cả tổ. *@
                            @if (u.IsTeamManager)
                            {
                                <span class="badge badge-active" title="Xem và sửa được mọi dự án, mọi việc của cả tổ">Quản lý Tổ</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge badge-active">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Đã khoá</span>
                            }
                        </td>
                        <td class="muted">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="actions">
                            <div class="btn-group">
                                <a class="btn btn-default btn-sm" href="@Url.Action("Edit", "Users", new { id = u.Id })">Sửa</a>
                                @if (!isSelf)
                                {
                                    using (Html.BeginForm("Delete", "Users", new { id = u.Id }, FormMethod.Post, new { @class = "inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Xoá tài khoản &quot;@u.UserName&quot;?');">
                                            Xoá
                                        </button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
