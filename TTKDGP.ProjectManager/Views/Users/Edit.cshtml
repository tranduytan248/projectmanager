@model TTKDGP.ProjectManager.Models.UserEditViewModel
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = Model.IsNew ? "Tạo người dùng" : "Sửa người dùng";
    var roleOptions = new List<SelectListItem>
    {
        new SelectListItem { Value = "Manager",  Text = "Quản lý — cập nhật dự án, thành viên, phân công" },
        new SelectListItem { Value = "Admin",    Text = "Quản trị — toàn quyền, gồm quản lý người dùng" },
        new SelectListItem { Value = "Reporter", Text = "Báo cáo công việc — chỉ báo cáo phần việc của mình" }
    };
    var members = ViewBag.MemberOptions as List<Member> ?? new List<Member>();
    var selectedRoles = Model.SelectedRoles ?? new string[0];
}

<div class="page-head">
    <div>
        <h1>@ViewBag.Title</h1>
        @if (!Model.IsNew)
        {
            <p>@Model.UserName</p>
        }
    </div>
    <a class="btn btn-default" href="@Url.Action("Index", "Users")">&larr; Danh sách người dùng</a>
</div>

<div class="card form-narrow">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "Users", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.ValidationSummary(true)

            <div class="form-field">
                @Html.LabelFor(m => m.UserName)
                @Html.TextBoxFor(m => m.UserName, new { autofocus = "autofocus", autocomplete = "off" })
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "field-error" })
            </div>

            <div class="form-field">
                @Html.LabelFor(m => m.FullName)
                @Html.TextBoxFor(m => m.FullName)
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-error" })
            </div>

            <div class="form-field">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { type = "email", autocomplete = "off" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                <span class="hint">Không bắt buộc. Dùng để liên hệ và gửi thông báo sau này.</span>
            </div>

            <div class="form-field">
                @Html.LabelFor(m => m.SelectedRoles)
                @* Chọn được nhiều quyền: một tài khoản vừa Quản lý vừa Báo cáo công việc chẳng hạn. *@
                <select id="SelectedRoles" name="SelectedRoles" multiple="multiple" size="3">
                    @foreach (var opt in roleOptions)
                    {
                        <option value="@opt.Value" selected="@(selectedRoles.Contains(opt.Value, StringComparer.OrdinalIgnoreCase))">@opt.Text</option>
                    }
                </select>
                @Html.ValidationMessageFor(m => m.SelectedRoles, "", new { @class = "field-error" })
                <span class="hint">
                    Chọn được nhiều quyền — bấm vào ô để thêm, bấm dấu × trên thẻ để bỏ.
                    Quyền rộng hơn sẽ quyết định: có Quản trị hoặc Quản lý là vào được các màn quản trị,
                    kèm Báo cáo công việc thì có thêm màn &quot;Báo cáo của tôi&quot;.
                </span>
            </div>

            <div class="form-field">
                @Html.LabelFor(m => m.MemberId)
                <select id="MemberId" name="MemberId">
                    <option value="0">— Chưa gắn —</option>
                    @foreach (var m in members)
                    {
                        <option value="@m.Id" selected="@(Model.MemberId == m.Id)">@m.FullName</option>
                    }
                </select>
                @Html.ValidationMessageFor(m => m.MemberId, "", new { @class = "field-error" })
                <span class="hint">
                    Bắt buộc với quyền <strong>Báo cáo công việc</strong> — để biết tài khoản được báo cáo
                    cho những phân công nào. Quyền khác có thể bỏ trống, nếu gắn thì cũng dùng được
                    màn &quot;Báo cáo của tôi&quot;.
                </span>
            </div>

            <div class="form-field">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { autocomplete = "new-password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
                <span class="hint">
                    @(Model.IsNew ? "Tối thiểu 6 ký tự." : "Để trống nếu không muốn đổi mật khẩu.")
                </span>
            </div>

            <div class="form-field">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })
            </div>

            <div class="check-inline">
                @Html.CheckBoxFor(m => m.IsActive)
                @Html.LabelFor(m => m.IsActive)
            </div>
            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "field-error" })
            <span class="hint">Bỏ đánh dấu để khoá đăng nhập mà không xoá tài khoản.</span>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Tạo người dùng" : "Lưu thay đổi")</button>
                <a class="btn btn-default" href="@Url.Action("Index", "Users")">Huỷ</a>
            </div>
        }
    </div>
</div>
