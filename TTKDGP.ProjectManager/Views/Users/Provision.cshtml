@model TTKDGP.ProjectManager.Models.UserProvisionViewModel
@{
    ViewBag.Title = "Mở tài khoản cho nhân sự";
}

<div class="page-head">
    <div>
        <h1>Mở tài khoản cho nhân sự</h1>
        <p>
            Đối chiếu <strong>nhân sự HRM</strong>@(string.IsNullOrWhiteSpace(Model.UnitName) ? "" : " của " + Model.UnitName)
            với tài khoản hiện có. Tên đăng nhập chính là <strong>tài khoản HRM</strong>, suy từ
            email bỏ phần <strong>@@vnpt.vn</strong>. Tài khoản mở ra mang quyền
            <strong>Báo cáo công việc</strong> và dùng được ngay — công việc giao thẳng theo
            tài khoản, không cần gắn hồ sơ nào.
        </p>
    </div>
    <a class="btn btn-default" href="@Url.Action("Index", "Users")">Về danh sách</a>
</div>

@Html.ValidationSummary(true)

@if (!string.IsNullOrEmpty(Model.UnitError))
{
    <div class="card">
        <div class="empty-state">
            <p><strong>Không đối chiếu được với HRM.</strong></p>
            <p class="hint">@Model.UnitError</p>
        </div>
    </div>
}

<div class="card">
    <div class="card-head">
        <span>Sẽ mở tài khoản mới (@Model.ToCreate.Count)</span>
    </div>

    @if (Model.ToCreate.Count == 0)
    {
        <div class="empty-state">
            Không có nhân sự nào cần mở tài khoản — mọi người đều đã có tài khoản hoặc bị bỏ qua
            vì lý do nêu bên dưới.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Mã NV</th>
                        <th>Nhân sự</th>
                        <th>Email</th>
                        <th>Tài khoản HRM</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.ToCreate)
                    {
                        <tr>
                            <td class="muted">@row.EmployeeCode</td>
                            <td>@row.FullName</td>
                            <td class="muted">@row.Email</td>
                            <td><strong>@row.UserName</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.HasWork)
{
    using (Html.BeginForm("Provision", "Users", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-body">
                <div class="form-field" style="max-width:320px">
                    <label for="Password">Mật khẩu khởi tạo</label>
                    @Html.PasswordFor(m => m.Password, new { id = "Password", value = Model.Password })
                    @Html.ValidationMessageFor(m => m.Password)
                    <span class="hint">Dùng chung cho tất cả tài khoản mở lần này.</span>
                </div>

                @if (Model.Existing.Count > 0)
                {
                    <div class="check-inline" style="margin-top:12px">
                        @Html.CheckBoxFor(m => m.ResetExisting)
                        @Html.LabelFor(m => m.ResetExisting)
                    </div>
                    <span class="hint">
                        Đặt lại mật khẩu của <strong>@Model.Existing.Count</strong> tài khoản nhân sự
                        đang có về đúng mật khẩu khởi tạo ở trên. Mật khẩu cũ của họ sẽ không dùng
                        được nữa. Tài khoản không khớp nhân sự HRM (ví dụ tài khoản quản trị) không
                        bị đụng tới.
                    </span>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"
                            onclick="return confirm('Xác nhận cập nhật tài khoản theo danh sách trên?');">
                        Cập nhật tài khoản
                    </button>
                </div>
            </div>
        </div>
    }
}

@if (Model.Skipped.Count > 0)
{
    <div class="card">
        <div class="card-head">
            <span>Bỏ qua (@Model.Skipped.Count)</span>
            <span class="muted" style="font-weight:400">Cần xử lý tay</span>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Nhân sự</th>
                        <th>Email</th>
                        <th>Lý do</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Skipped)
                    {
                        <tr>
                            <td>@s.FullName</td>
                            <td class="muted">@(string.IsNullOrWhiteSpace(s.Email) ? "—" : s.Email)</td>
                            <td>@s.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.UnlinkedUsers.Count > 0)
{
    <div class="card">
        <div class="card-head">
            <span>Tài khoản không khớp nhân sự HRM (@Model.UnlinkedUsers.Count)</span>
            <span class="muted" style="font-weight:400">Không bị đụng tới</span>
        </div>
        <div class="card-body">
            <p class="hint" style="margin-top:0">
                Không khớp nhân sự HRM nào — thường là tài khoản quản trị hoặc người đã chuyển đi.
                Chức năng này không mở và không đổi mật khẩu của họ.
            </p>
        </div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.UnlinkedUsers)
                    {
                        <tr>
                            <td><strong>@u.UserName</strong></td>
                            <td>@u.FullName</td>
                            <td class="muted">@(string.IsNullOrWhiteSpace(u.Email) ? "—" : u.Email)</td>
                            <td><a href="@Url.Action("Edit", "Users", new { id = u.Id })">Sửa tài khoản</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
