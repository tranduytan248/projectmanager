@model TTKDGP.ProjectManager.Models.PagedList<TTKDGP.ProjectManager.Models.EmployeeHrm>
@using System.Collections.Generic
@using System.Linq
@using TTKDGP.ProjectManager.Infrastructure
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Nhân sự (CAS VNPT)";
    var departments = ViewBag.DepartmentOptions as List<DepartmentHrm> ?? new List<DepartmentHrm>();
    var currentDepartmentId = ViewBag.DepartmentId as int?;
}

<div class="page-head">
    <div>
        <h1>Nhân sự — CAS VNPT (HRM)</h1>
        <p>
            Danh bạ nhân sự lấy từ cổng CAS VNPT (id.vnpt.com.vn → hrm.vnpt.vn) qua lệnh
            <code>/signin</code> trên bot Telegram. Tổng cộng @Model.Pager.TotalItems người.
        </p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Employees", "HrmDirectory", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field grow">
                    <label for="keyword">Tìm kiếm</label>
                    <input type="search" id="keyword" name="keyword" value="@ViewBag.Keyword"
                           placeholder="Họ tên, mã nhân viên, điện thoại, email, đơn vị, chức danh..." />
                </div>
                <div class="filter-field">
                    <label for="departmentId">Đơn vị</label>
                    <select id="departmentId" name="departmentId">
                        <option value="">— Tất cả —</option>
                        @foreach (var d in departments.OrderBy(x => x.DepartmentName))
                        {
                            <option value="@d.DepartmentId" selected="@(currentDepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                        }
                    </select>
                </div>
                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a class="btn btn-default" href="@Url.Action("Employees", "HrmDirectory")">Xoá lọc</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            Chưa có nhân sự nào phù hợp. Nếu bảng còn trống, nhắn <code>/signin</code> cho bot Telegram để đăng nhập và đồng bộ.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Mã NV</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Đơn vị</th>
                        <th>Chức danh</th>
                        <th>Vị trí công việc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@ViewHelpers.OrDash(e.FullName)</strong>
                                @if (e.IsCongTacVien)
                                {
                                    <span class="badge badge-waiting" title="Cộng tác viên">CTV</span>
                                }
                            </td>
                            <td class="muted nowrap">@ViewHelpers.OrDash(e.EmployeeCode)</td>
                            <td class="muted nowrap">@ViewHelpers.OrDash(e.MobilePhone)</td>
                            <td class="muted">@ViewHelpers.OrDash(e.WorkEmail)</td>
                            <td class="muted wrap-text">@ViewHelpers.OrDash(e.DepartmentName)</td>
                            <td class="muted wrap-text">@ViewHelpers.OrDash(e.JobName)</td>
                            <td class="muted wrap-text">@ViewHelpers.OrDash(e.ViTriCongViecName)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.Partial("_Pager", Model.Pager)
    }
</div>
