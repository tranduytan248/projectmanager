@model TTKDGP.ProjectManager.Models.NotificationsViewModel
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Nhắc báo cáo";
}

<div class="page-head">
    <div>
        <h1>Nhắc báo cáo</h1>
        <p>
            <strong>Gửi mail riêng cho từng thành viên:</strong>
            thứ Sáu @Model.MemberEmailHour giờ, liệt kê tên dự án và email PM cần gửi báo cáo về
            để PM tổng hợp lên hệ thống.
        </p>
        <p>
            <strong>Nhắc hạn công việc qua SMS:</strong>
            @Model.TaskSmsMorningHour giờ sáng và @Model.TaskSmsAfternoonHour giờ chiều,
            các ngày làm việc trong tuần (trừ thứ Bảy, Chủ nhật).
        </p>
        <p>Dự án ở trạng thái <em>coi như đã dừng</em> không bị nhắc.</p>
    </div>
</div>

@* Hai bot Telegram tách bạch: bot Thư ký lo nhắc báo cáo, bot HRM lo đăng nhập GoConnect.
   Trình bày cạnh nhau để nhìn một cái là thấy tin nào đi ra từ bot nào. *@
@helper BotCell(string botName, string error, bool hasToken)
{
    if (!string.IsNullOrEmpty(botName))
    {
        <strong>@@@botName</strong>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <span class="field-error">@error</span>
    }
    else if (!hasToken)
    {
        <span class="muted">(chưa đặt token)</span>
    }
}

@helper ChatCell(string chatId, bool hasChatId)
{
    if (!hasChatId)
    {
        <span class="badge badge-waiting">chưa đặt</span>
    }
    else
    {
        @* Telegram đánh id âm cho nhóm, id dương cho chat riêng *@
        <span class="muted">@(chatId.StartsWith("-") ? "Nhóm" : "Chat riêng") · </span><text>@chatId</text>
    }
}

<div class="card">
    <div class="card-head">
        <span>Kết nối Telegram</span>
        <span class="muted" style="font-weight:400">Hệ thống dùng 2 bot riêng biệt</span>
    </div>
    <div class="card-body">
        @if (Model.SharesBotWithReminder)
        {
            <div class="alert alert-danger">
                <strong>Hai chức năng đang dùng chung một bot.</strong>
                Tin nhắc báo cáo và tin hỏi mã OTP sẽ cùng đi ra từ <strong>@@@Model.BotName</strong>.
                Khai báo <code>GoConnect:BotToken</code> riêng trong
                <code>App_Config\secrets.config</code> để tách ra.
            </div>
        }

        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Việc</th>
                        <th>Bot</th>
                        <th>Token</th>
                        <th>Nơi nhận</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Nhắc báo cáo</strong><br /><span class="muted">không còn gửi Telegram</span></td>
                        <td>@BotCell(Model.BotName, Model.ConnectionError, Model.HasToken)</td>
                        <td class="nowrap">@Model.MaskedToken</td>
                        <td>@ChatCell(Model.ChatId, Model.HasChatId)</td>
                        <td><span class="badge badge-inactive">Đã ngừng</span></td>
                    </tr>
                    <tr>
                        <td><strong>Đăng nhập GoConnect</strong><br /><span class="muted">hỏi mã OTP mỗi sáng</span></td>
                        <td>@BotCell(Model.GoConnectBotName, Model.GoConnectConnectionError, Model.GoConnectHasToken)</td>
                        <td class="nowrap">@Model.GoConnectMaskedToken</td>
                        <td>@ChatCell(Model.GoConnectChatId, Model.GoConnectHasChatId)</td>
                        <td>
                            @if (Model.GoConnectEnabled && Model.GoConnectHasToken && Model.GoConnectHasChatId)
                            {
                                <span class="badge badge-active">Sẵn sàng gửi</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Đang tắt</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="alert" style="margin-top:16px;margin-bottom:0">
            <strong>Đã bỏ nhắc báo cáo qua Telegram.</strong>
            Hệ thống không còn gửi tin lên nhóm nữa — việc nhắc báo cáo nay đi bằng mail riêng
            cho từng thành viên. Cấu hình bot bên trên vẫn giữ để dò chat id khi cần.
        </div>

        <div class="form-actions">
            @using (Html.BeginForm("Discover", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-default" @(Model.HasToken ? "" : "disabled=disabled")>
                    Dò chat id
                </button>
            }
        </div>

        @if (Model.DiscoveredChats.Count > 0)
        {
            <div class="table-wrap" style="margin-top:14px">
                <table class="data">
                    <thead>
                        <tr><th>chat id</th><th>Loại</th><th>Tên</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var chat in Model.DiscoveredChats)
                        {
                            <tr>
                                <td><strong>@chat.Id</strong></td>
                                <td class="muted">@chat.Type</td>
                                <td>@chat.Title</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Nhắc hạn công việc bằng SMS. Xem trước đúng danh sách mà lượt gửi tới sẽ dùng. *@
<div class="card">
    <div class="card-head">
        <span>Nhắc hạn công việc qua SMS</span>
        <span class="muted" style="font-weight:400">
            @Model.TaskSmsMorningHour giờ &amp; @Model.TaskSmsAfternoonHour giờ · ngày làm việc
        </span>
    </div>
    <div class="card-body">
        <div class="form-grid">
            <div>
                <strong>Trạng thái:</strong><br />
                @if (Model.TaskSmsEnabled && Model.SmsReady)
                {
                    <span class="badge badge-active">Đang bật</span>
                }
                else if (!Model.TaskSmsEnabled)
                {
                    <span class="badge badge-inactive">Đang tắt</span>
                }
                else
                {
                    <span class="badge badge-waiting">Chưa gửi được</span>
                }
            </div>
            <div>
                <strong>Ngày đang xét:</strong><br />
                @Model.TaskSmsPreview.Day.ToString("dd/MM/yyyy")
                @if (!Model.TaskSmsPreview.IsWorkingDay)
                {
                    <span class="muted"> — ngày nghỉ, không nhắc</span>
                }
            </div>
            <div class="full">
                <strong>Nội dung tin:</strong><br />
                <span class="muted">Bạn có [số lượng] task sẽ hết hạn trong ngày @Model.TaskSmsPreview.Day.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        @if (!Model.SmsReady)
        {
            <div class="alert alert-danger" style="margin-top:16px;margin-bottom:0">
                <strong>Chưa gửi được tin.</strong> Cần <code>Sms:Enabled</code> = <code>true</code>
                và <code>Sms:GatewayUrl</code> trỏ đúng tổng đài.
            </div>
        }

        <hr />

        <div class="stats" style="margin-bottom:16px">
            <div class="stat">
                <div class="stat-value">@Model.TaskSmsPreview.SendableCount</div>
                <div class="stat-label">Người sẽ nhận tin</div>
            </div>
            <div class="stat">
                <div class="stat-value">@Model.TaskSmsPreview.Recipients.Sum(r => r.DueCount)</div>
                <div class="stat-label">Lượt việc đến hạn</div>
            </div>
            <div class="stat">
                <div class="stat-value">@Model.TaskSmsPreview.NoPhoneCount</div>
                <div class="stat-label">Chưa có số điện thoại</div>
            </div>
        </div>

        @if (Model.TaskSmsPreview.Recipients.Count == 0)
        {
            <p class="muted">
                @(Model.TaskSmsPreview.IsWorkingDay
                    ? "Không có việc nào hết hạn trong ngày hôm nay — không cần nhắc ai."
                    : "Hôm nay là ngày nghỉ nên lịch không chạy.")
            </p>
        }
        else
        {
            if (Model.TaskSmsPreview.NoPhoneCount > 0)
            {
                <div class="alert alert-danger">
                    Có @Model.TaskSmsPreview.NoPhoneCount người có việc đến hạn nhưng chưa điền số
                    điện thoại nên sẽ không nhận được tin. Chạy
                    <a href="@Url.Action("SyncPhones", "Users")">Lấy số điện thoại từ HRM</a>
                    để đổ số sang hàng loạt, hoặc điền tay ở màn
                    <a href="@Url.Action("Index", "Users")">Người dùng</a>.
                </div>
            }

            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Người nhận</th>
                            <th>Số điện thoại</th>
                            <th class="num">Việc đến hạn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.TaskSmsPreview.Recipients.OrderByDescending(x => x.DueCount))
                        {
                            <tr>
                                <td><strong>@r.FullName</strong></td>
                                <td class="nowrap">
                                    @if (r.CanSend)
                                    {
                                        <text>@r.Phone</text>
                                    }
                                    else
                                    {
                                        <span class="badge badge-waiting">Chưa có số</span>
                                    }
                                </td>
                                <td class="num">@r.DueCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="form-actions">
            @using (Html.BeginForm("SendTaskDueSms", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"
                        @(Model.SmsReady && Model.TaskSmsPreview.SendableCount > 0 ? "" : "disabled=disabled")
                        onclick="return confirm('Gửi tin nhắc hạn ngay cho @Model.TaskSmsPreview.SendableCount người trong danh sách trên?');">
                    Gửi tin ngay
                </button>
            }
        </div>
    </div>
</div>

@* Thông báo SMS tổng số giờ Logtime trong ngày lúc 17h *@
<div class="card">
    <div class="card-head">
        <span>Thông báo SMS giờ công (Logtime)</span>
        <span class="muted" style="font-weight:400">
            @Model.LogTimeSmsHour giờ hàng ngày · Tất cả các ngày trong tuần
        </span>
    </div>
    <div class="card-body">
        <div class="form-grid">
            <div>
                <strong>Trạng thái:</strong><br />
                @if (Model.LogTimeSmsEnabled && Model.SmsReady)
                {
                    <span class="badge badge-active">Đang bật</span>
                }
                else if (!Model.LogTimeSmsEnabled)
                {
                    <span class="badge badge-inactive">Đang tắt</span>
                }
                else
                {
                    <span class="badge badge-waiting">Chưa gửi được</span>
                }
            </div>
            <div>
                <strong>Ngày đang xét:</strong><br />
                @Model.LogTimeSmsPreview.Day.ToString("dd/MM/yyyy")
                <span class="muted"> — gửi mọi ngày (kể cả T7/CN/Lễ)</span>
            </div>
            <div>
                <strong>Định mức chuẩn:</strong><br />
                @(Model.LogTimeStandardHours.ToString("0.##"))h / ngày
            </div>
            <div>
                <strong>Kênh thông báo:</strong><br />
                @(Model.LogTimeFcmPushEnabled ? "SMS Viễn thông + Mobile Push (App BrewTask)" : "Chỉ gửi SMS")
            </div>
            <div class="full">
                <strong>Nội dung mẫu (SMS viễn thông không dấu &lt; 160 ký tự):</strong><br />
                <div style="font-size:13px;line-height:1.6;margin-top:4px;color:#cbd5e1">
                    <div>• <em>Đủ định mức (&ge; @Model.LogTimeStandardHours.ToString("0.##")h):</em> <code style="color:#38bdf8">[BrewTask] Hom nay @Model.LogTimeSmsPreview.Day.ToString("dd/MM") ban da logtime du @Model.LogTimeStandardHours.ToString("0.##")h/@Model.LogTimeStandardHours.ToString("0.##")h. Cam on ban da tich cuc lam viec!</code></div>
                    <div>• <em>Chưa đủ giờ:</em> <code style="color:#fbbf24">[BrewTask] Hom nay @Model.LogTimeSmsPreview.Day.ToString("dd/MM") ban da logtime 4h/@Model.LogTimeStandardHours.ToString("0.##")h. Vui long kiem tra va log bo sung truoc khi ket thuc ca!</code></div>
                    <div>• <em>Chưa log (0h):</em> <code style="color:#f87171">[BrewTask] Hom nay @Model.LogTimeSmsPreview.Day.ToString("dd/MM") ban chua logtime gio cong nao (0h/@Model.LogTimeStandardHours.ToString("0.##")h). Vui long cap nhat gio lam truoc khi ve!</code></div>
                </div>
            </div>
        </div>

        @if (!Model.SmsReady)
        {
            <div class="alert alert-danger" style="margin-top:16px;margin-bottom:0">
                <strong>Chưa gửi được tin.</strong> Cần <code>Sms:Enabled</code> = <code>true</code>
                và <code>Sms:GatewayUrl</code> trỏ đúng tổng đài SMS.
            </div>
        }

        <hr />

        <div class="stats" style="margin-bottom:16px">
            <div class="stat">
                <div class="stat-value">@Model.LogTimeSmsPreview.TotalCount</div>
                <div class="stat-label">Nhân sự xét gửi</div>
            </div>
            <div class="stat">
                <div class="stat-value" style="color:#4ade80">@Model.LogTimeSmsPreview.SufficientCount</div>
                <div class="stat-label">Đạt định mức (&ge; @Model.LogTimeStandardHours.ToString("0.##")h)</div>
            </div>
            <div class="stat">
                <div class="stat-value" style="color:#fbbf24">@Model.LogTimeSmsPreview.UnderCount</div>
                <div class="stat-label">Chưa đủ định mức</div>
            </div>
            <div class="stat">
                <div class="stat-value" style="color:#f87171">@Model.LogTimeSmsPreview.ZeroCount</div>
                <div class="stat-label">Chưa log giờ nào (0h)</div>
            </div>
            <div class="stat">
                <div class="stat-value">@Model.LogTimeSmsPreview.NoPhoneCount</div>
                <div class="stat-label">Chưa có SĐT</div>
            </div>
        </div>

        @if (Model.LogTimeSmsPreview.Recipients.Count == 0)
        {
            <p class="muted">
                @(Model.LogTimeSmsPreview.IsWorkingDay
                    ? "Không có nhân sự nào trong danh sách nhận tin hôm nay."
                    : "Hôm nay là ngày nghỉ hoặc ngày lễ nên lịch không gửi tin.")
            </p>
        }
        else
        {
            if (Model.LogTimeSmsPreview.NoPhoneCount > 0)
            {
                <div class="alert alert-danger">
                    Có @Model.LogTimeSmsPreview.NoPhoneCount nhân sự chưa có số điện thoại trong hệ thống nên sẽ không nhận được tin SMS.
                    Vào màn hình <a href="@Url.Action("Index", "Users")">Người dùng</a> hoặc chạy
                    <a href="@Url.Action("SyncPhones", "Users")">Đồng bộ số điện thoại từ HRM</a> để cập nhật.
                </div>
            }

            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Nhân viên</th>
                            <th>Số điện thoại</th>
                            <th class="num">Giờ đã log</th>
                            <th>Định mức</th>
                            <th>Nội dung SMS sẽ gửi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.LogTimeSmsPreview.Recipients.OrderByDescending(x => x.TotalHours))
                        {
                            <tr>
                                <td><strong>@r.FullName</strong></td>
                                <td class="nowrap">
                                    @if (r.CanSendSms)
                                    {
                                        <text>@r.Phone</text>
                                    }
                                    else
                                    {
                                        <span class="badge badge-waiting">Chưa có số</span>
                                    }
                                </td>
                                <td class="num">
                                    <strong style="color: @(r.IsSufficient ? "#4ade80" : (r.TotalHours > 0 ? "#fbbf24" : "#f87171"))">
                                        @r.TotalHours.ToString("0.##")h
                                    </strong>
                                </td>
                                <td>
                                    @if (r.IsSufficient)
                                    {
                                        <span class="badge badge-active">Đạt chuẩn</span>
                                    }
                                    else if (r.TotalHours > 0)
                                    {
                                        <span class="badge" style="background:#854d0e;color:#fef08a">Chưa đủ</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#991b1b;color:#fecaca">Chưa log</span>
                                    }
                                </td>
                                <td style="font-size:12px;max-width:380px" class="muted">
                                    @r.SmsContent
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="form-actions">
            @using (Html.BeginForm("SendDailyLogTimeSms", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"
                        @(Model.SmsReady && Model.LogTimeSmsPreview.SendableCount > 0 ? "" : "disabled=disabled")
                        onclick="return confirm('Gửi tin nhắn SMS thông báo LogTime ngay cho @Model.LogTimeSmsPreview.SendableCount nhân viên?');">
                    Gửi tin LogTime ngay
                </button>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <span>Mail riêng cho từng thành viên</span>
        <span class="muted" style="font-weight:400">Sáng thứ Sáu @Model.MemberEmailHour giờ</span>
    </div>
    <div class="card-body">
        <div class="form-grid">
            <div>
                <strong>Trạng thái:</strong><br />
                @if (Model.EmailReady)
                {
                    <span class="badge badge-active">Sẵn sàng gửi</span>
                }
                else
                {
                    <span class="badge badge-waiting">Chưa gửi được</span>
                }
            </div>
            <div><strong>Máy chủ:</strong><br />@Model.EmailHost : @Model.EmailPort</div>
            <div><strong>Tài khoản:</strong><br />@Model.EmailUser</div>
            <div><strong>Mật khẩu:</strong><br />@Model.EmailMaskedPassword</div>
            <div class="full">
                <strong>Người gửi hiển thị:</strong><br />
                @Model.EmailDisplayName &lt;@Model.EmailFrom&gt;
            </div>
            <div class="full">
                <strong>Lịch tự động:</strong>
                @if (Model.AutoSend)
                {
                    <span class="badge badge-active">Đang bật</span>
                    <span class="muted">— tự gửi sáng thứ Sáu @Model.MemberEmailHour giờ.</span>
                }
                else
                {
                    <span class="badge badge-inactive">Đang tắt</span>
                    <span class="muted">
                        — chỉ gửi khi bấm nút bên dưới. Bản publish Release tự bật lịch;
                        máy phát triển để tắt cho khỏi bắn mail thật.
                    </span>
                }
            </div>
        </div>

        @if (!Model.EmailReady)
        {
            <div class="alert alert-danger" style="margin-top:16px;margin-bottom:0">
                <strong>Chưa gửi được mail.</strong> Điền vào <code>App_Config\secrets.config</code>:
                <ul style="margin:8px 0 0;padding-left:20px">
                    @if (!Model.EmailEnabled)
                    {
                        <li><code>Email:Enabled</code> = <code>true</code></li>
                    }
                    @if (!Model.EmailHasAccount)
                    {
                        <li><code>Email:Password</code> — mật khẩu hộp thư gửi</li>
                    }
                    @if (!Model.EmailHasHost)
                    {
                        <li><code>Email:Host</code> — máy chủ SMTP (đặt trong Web.config)</li>
                    }
                </ul>
            </div>
        }

        <hr />

        @{ var noEmailCount = Model.MemberReminders.Count(r => !r.CanSend); }

        <div class="stats" style="margin-bottom:16px">
            <div class="stat">
                <div class="stat-value">@Model.MemberReminders.Count(r => r.CanSend)</div>
                <div class="stat-label">Người sẽ nhận mail</div>
            </div>
            <div class="stat">
                <div class="stat-value">@Model.MemberReminders.Sum(r => r.Projects.Count)</div>
                <div class="stat-label">Lượt dự án cần báo cáo</div>
            </div>
            <div class="stat">
                <div class="stat-value">@noEmailCount</div>
                <div class="stat-label">Chưa có email</div>
            </div>
        </div>

        @if (Model.MemberReminders.Count == 0)
        {
            <p class="muted">Mọi thành viên đều đã báo cáo trong tuần này — không cần gửi mail.</p>
        }
        else
        {
            if (noEmailCount > 0)
            {
                <div class="alert alert-danger">
                    Có @noEmailCount người cần báo cáo nhưng chưa điền email nên sẽ không nhận được mail.
                    Bổ sung ở màn hình <a href="@Url.Action("Index", "Members")">Thành viên</a>.
                </div>
            }

            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Thành viên</th>
                            <th>Email nhận</th>
                            <th class="num">Dự án</th>
                            <th>Gửi báo cáo cho PM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.MemberReminders)
                        {
                            <tr>
                                <td><strong>@r.MemberName</strong></td>
                                <td>
                                    @if (r.CanSend)
                                    {
                                        <span>@r.Email</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-waiting">Chưa có email</span>
                                    }
                                </td>
                                <td class="num">@r.Projects.Count</td>
                                <td class="muted">
                                    @string.Join(" · ", r.Projects.Select(p => p.ProjectName + " → " + p.PmName))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="form-actions">
            @using (Html.BeginForm("SendMemberEmails", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"
                        @(Model.EmailReady && Model.MemberReminders.Any(r => r.CanSend) ? "" : "disabled=disabled")
                        onclick="return confirm('Gửi mail nhắc ngay cho từng thành viên trong danh sách trên?');">
                    Gửi mail ngay
                </button>
            }
        </div>

        <hr />

        @using (Html.BeginForm("SendTestEmail", "Notifications", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="filters">
                <div class="filter-field grow">
                    <label for="to">Gửi thử tới địa chỉ</label>
                    <input type="email" id="to" name="to" placeholder="ten@vnpt.vn" />
                </div>
                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-default" @(Model.EmailReady ? "" : "disabled=disabled")>
                        Gửi mail thử
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-head">
        <span>Lịch sử gửi</span>
        <span class="muted" style="font-weight:400">@Model.History.Count lần gần nhất</span>
    </div>

    @if (Model.History.Count == 0)
    {
        <div class="empty-state">Chưa gửi lần nào.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Thời điểm</th>
                        <th>Kỳ nhắc</th>
                        <th>Tuần</th>
                        <th class="num">Dự án</th>
                        <th class="num">PM / Người nhận</th>
                        <th>Cách gửi</th>
                        <th>Kết quả</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.History)
                    {
                        <tr>
                            <td class="nowrap">@log.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="nowrap">@log.KindLabel</td>
                            <td class="nowrap muted">Tuần @log.Week/@log.Year</td>
                            <td class="num">@log.MissingProjectCount</td>
                            <td class="num">
                                @if (log.IsEmailKind)
                                {
                                    <span title="Đã gửi @log.SentCount mail trên @log.PmCount người cần nhắc">
                                        @log.SentCount/@log.PmCount
                                    </span>
                                }
                                else
                                {
                                    @log.PmCount
                                }
                            </td>
                            <td class="muted">
                                @if (log.IsManual)
                                {
                                    <text>Thủ công@(string.IsNullOrEmpty(log.TriggeredBy) ? "" : " · " + log.TriggeredBy)</text>
                                }
                                else
                                {
                                    <text>Theo lịch</text>
                                }
                            </td>
                            <td>
                                @if (log.Success && log.MissingProjectCount > 0)
                                {
                                    <span class="badge badge-active">Đã gửi</span>
                                }
                                else if (log.Success)
                                {
                                    <span class="badge badge-inactive">Không cần gửi</span>
                                }
                                else
                                {
                                    <span class="badge badge-waiting" title="@log.Error">Lỗi</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
