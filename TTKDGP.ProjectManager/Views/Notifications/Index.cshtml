@model TTKDGP.ProjectManager.Models.NotificationsViewModel
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Nhắc báo cáo";
}

<div class="page-head">
    <div>
        <h1>Nhắc báo cáo</h1>
        <p>
            <strong>Gửi vào nhóm Telegram:</strong>
            thứ Hai @Model.MondayHour giờ rà soát tuần trước ·
            thứ Sáu @Model.FridayHour giờ rà soát tuần này ·
            thứ Bảy @Model.SaturdayHour giờ tổng hợp cho anh Tân.
        </p>
        <p>
            <strong>Gửi mail riêng cho từng thành viên:</strong>
            thứ Sáu @Model.MemberEmailHour giờ, liệt kê tên dự án và email PM cần gửi báo cáo về
            để PM tổng hợp lên hệ thống.
        </p>
        <p>Dự án ở trạng thái <em>coi như đã dừng</em> không bị nhắc.</p>
    </div>
</div>

@* Hai bot Telegram tách bạch: bot Thư ký lo nhắc báo cáo, bot HRM lo đăng nhập GoConnect.
   Trình bày cạnh nhau để nhìn một cái là thấy tin nào đi ra từ bot nào. *@
@helper BotCell(string botName, string error, bool hasToken)
{
    if (!string.IsNullOrEmpty(botName))
    {
        <strong>@@@botName</strong>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <span class="field-error">@error</span>
    }
    else if (!hasToken)
    {
        <span class="muted">(chưa đặt token)</span>
    }
}

@helper ChatCell(string chatId, bool hasChatId)
{
    if (!hasChatId)
    {
        <span class="badge badge-waiting">chưa đặt</span>
    }
    else
    {
        @* Telegram đánh id âm cho nhóm, id dương cho chat riêng *@
        <span class="muted">@(chatId.StartsWith("-") ? "Nhóm" : "Chat riêng") · </span><text>@chatId</text>
    }
}

<div class="card">
    <div class="card-head">
        <span>Kết nối Telegram</span>
        <span class="muted" style="font-weight:400">Hệ thống dùng 2 bot riêng biệt</span>
    </div>
    <div class="card-body">
        @if (Model.SharesBotWithReminder)
        {
            <div class="alert alert-danger">
                <strong>Hai chức năng đang dùng chung một bot.</strong>
                Tin nhắc báo cáo và tin hỏi mã OTP sẽ cùng đi ra từ <strong>@@@Model.BotName</strong>.
                Khai báo <code>GoConnect:BotToken</code> riêng trong
                <code>App_Config\secrets.config</code> để tách ra.
            </div>
        }

        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Việc</th>
                        <th>Bot</th>
                        <th>Token</th>
                        <th>Nơi nhận</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Nhắc báo cáo</strong><br /><span class="muted">thứ Hai · thứ Sáu · thứ Bảy</span></td>
                        <td>@BotCell(Model.BotName, Model.ConnectionError, Model.HasToken)</td>
                        <td class="nowrap">@Model.MaskedToken</td>
                        <td>@ChatCell(Model.ChatId, Model.HasChatId)</td>
                        <td>
                            @if (Model.TelegramEnabled && Model.HasToken && Model.HasChatId)
                            {
                                <span class="badge badge-active">Sẵn sàng gửi</span>
                            }
                            else
                            {
                                <span class="badge badge-waiting">Chưa gửi được</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Đăng nhập GoConnect</strong><br /><span class="muted">hỏi mã OTP mỗi sáng</span></td>
                        <td>@BotCell(Model.GoConnectBotName, Model.GoConnectConnectionError, Model.GoConnectHasToken)</td>
                        <td class="nowrap">@Model.GoConnectMaskedToken</td>
                        <td>@ChatCell(Model.GoConnectChatId, Model.GoConnectHasChatId)</td>
                        <td>
                            @if (Model.GoConnectEnabled && Model.GoConnectHasToken && Model.GoConnectHasChatId)
                            {
                                <span class="badge badge-active">Sẵn sàng gửi</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Đang tắt</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="form-grid" style="margin-top:16px">
            <div class="full">
                <strong>Lịch tự động:</strong>
                @if (Model.AutoSend)
                {
                    <span class="badge badge-active">Đang bật</span>
                    <span class="muted">
                        — tự gửi thứ Hai @Model.MondayHour giờ, thứ Sáu @Model.FridayHour giờ,
                        thứ Bảy @Model.SaturdayHour giờ.
                    </span>
                }
                else
                {
                    <span class="badge badge-inactive">Đang tắt</span>
                    <span class="muted">
                        — chỉ gửi khi bấm nút bên dưới. Bản publish Release tự bật lịch;
                        máy phát triển để tắt cho khỏi bắn tin thật vào nhóm.
                    </span>
                }
            </div>
        </div>

        @if (!Model.TelegramEnabled || !Model.HasToken || !Model.HasChatId)
        {
            <div class="alert alert-danger" style="margin-top:16px;margin-bottom:0">
                <strong>Chưa gửi được.</strong> Tạo file <code>App_Config\secrets.config</code>
                (chép từ <code>secrets.example.config</code>) và điền:
                <ul style="margin:8px 0 0;padding-left:20px">
                    @if (!Model.TelegramEnabled)
                    {
                        <li><code>Telegram:Enabled</code> = <code>true</code></li>
                    }
                    @if (!Model.HasToken)
                    {
                        <li><code>Telegram:BotToken</code> — lấy từ @@BotFather</li>
                    }
                    @if (!Model.HasChatId)
                    {
                        <li><code>Telegram:ChatId</code> — thêm bot vào nhóm, gửi một tin trong nhóm rồi bấm <em>Dò chat id</em> bên dưới</li>
                    }
                </ul>
            </div>
        }

        <div class="form-actions">
            @using (Html.BeginForm("Discover", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-default" @(Model.HasToken ? "" : "disabled=disabled")>
                    Dò chat id
                </button>
            }
        </div>

        @if (Model.DiscoveredChats.Count > 0)
        {
            <div class="table-wrap" style="margin-top:14px">
                <table class="data">
                    <thead>
                        <tr><th>chat id</th><th>Loại</th><th>Tên</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var chat in Model.DiscoveredChats)
                        {
                            <tr>
                                <td><strong>@chat.Id</strong></td>
                                <td class="muted">@chat.Type</td>
                                <td>@chat.Title</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-head">
        <span>Mail riêng cho từng thành viên</span>
        <span class="muted" style="font-weight:400">Sáng thứ Sáu @Model.MemberEmailHour giờ</span>
    </div>
    <div class="card-body">
        <div class="form-grid">
            <div>
                <strong>Trạng thái:</strong><br />
                @if (Model.EmailReady)
                {
                    <span class="badge badge-active">Sẵn sàng gửi</span>
                }
                else
                {
                    <span class="badge badge-waiting">Chưa gửi được</span>
                }
            </div>
            <div><strong>Máy chủ:</strong><br />@Model.EmailHost : @Model.EmailPort</div>
            <div><strong>Tài khoản:</strong><br />@Model.EmailUser</div>
            <div><strong>Mật khẩu:</strong><br />@Model.EmailMaskedPassword</div>
            <div class="full">
                <strong>Người gửi hiển thị:</strong><br />
                @Model.EmailDisplayName &lt;@Model.EmailFrom&gt;
            </div>
        </div>

        @if (!Model.EmailReady)
        {
            <div class="alert alert-danger" style="margin-top:16px;margin-bottom:0">
                <strong>Chưa gửi được mail.</strong> Điền vào <code>App_Config\secrets.config</code>:
                <ul style="margin:8px 0 0;padding-left:20px">
                    @if (!Model.EmailEnabled)
                    {
                        <li><code>Email:Enabled</code> = <code>true</code></li>
                    }
                    @if (!Model.EmailHasAccount)
                    {
                        <li><code>Email:Password</code> — mật khẩu hộp thư gửi</li>
                    }
                    @if (!Model.EmailHasHost)
                    {
                        <li><code>Email:Host</code> — máy chủ SMTP (đặt trong Web.config)</li>
                    }
                </ul>
            </div>
        }

        <hr />

        @{ var noEmailCount = Model.MemberReminders.Count(r => !r.CanSend); }

        <div class="stats" style="margin-bottom:16px">
            <div class="stat">
                <div class="stat-value">@Model.MemberReminders.Count(r => r.CanSend)</div>
                <div class="stat-label">Người sẽ nhận mail</div>
            </div>
            <div class="stat">
                <div class="stat-value">@Model.MemberReminders.Sum(r => r.Projects.Count)</div>
                <div class="stat-label">Lượt dự án cần báo cáo</div>
            </div>
            <div class="stat">
                <div class="stat-value">@noEmailCount</div>
                <div class="stat-label">Chưa có email</div>
            </div>
        </div>

        @if (Model.MemberReminders.Count == 0)
        {
            <p class="muted">Mọi thành viên đều đã báo cáo trong tuần này — không cần gửi mail.</p>
        }
        else
        {
            if (noEmailCount > 0)
            {
                <div class="alert alert-danger">
                    Có @noEmailCount người cần báo cáo nhưng chưa điền email nên sẽ không nhận được mail.
                    Bổ sung ở màn hình <a href="@Url.Action("Index", "Members")">Thành viên</a>.
                </div>
            }

            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Thành viên</th>
                            <th>Email nhận</th>
                            <th class="num">Dự án</th>
                            <th>Gửi báo cáo cho PM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.MemberReminders)
                        {
                            <tr>
                                <td><strong>@r.MemberName</strong></td>
                                <td>
                                    @if (r.CanSend)
                                    {
                                        <span>@r.Email</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-waiting">Chưa có email</span>
                                    }
                                </td>
                                <td class="num">@r.Projects.Count</td>
                                <td class="muted">
                                    @string.Join(" · ", r.Projects.Select(p => p.ProjectName + " → " + p.PmName))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="form-actions">
            @using (Html.BeginForm("SendMemberEmails", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"
                        @(Model.EmailReady && Model.MemberReminders.Any(r => r.CanSend) ? "" : "disabled=disabled")
                        onclick="return confirm('Gửi mail nhắc ngay cho từng thành viên trong danh sách trên?');">
                    Gửi mail ngay
                </button>
            }
        </div>

        <hr />

        @using (Html.BeginForm("SendTestEmail", "Notifications", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="filters">
                <div class="filter-field grow">
                    <label for="to">Gửi thử tới địa chỉ</label>
                    <input type="email" id="to" name="to" placeholder="ten@vnpt.vn" />
                </div>
                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-default" @(Model.EmailReady ? "" : "disabled=disabled")>
                        Gửi mail thử
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@foreach (var preview in new[] { Model.SaturdayPreview, Model.FridayPreview, Model.MondayPreview })
{
    <div class="card">
        <div class="card-head">
            <span>@preview.KindLabel</span>
            <span class="muted" style="font-weight:400">
                Tuần @preview.Week/@preview.Year (@preview.WeekFrom.ToString("dd/MM") – @preview.WeekTo.ToString("dd/MM/yyyy"))
            </span>
        </div>
        <div class="card-body">
            <div class="stats" style="margin-bottom:16px">
                <div class="stat">
                    <div class="stat-value">@preview.MissingProjectCount</div>
                    <div class="stat-label">Dự án chưa báo cáo</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@preview.ReportedProjects</div>
                    <div class="stat-label">Đã báo cáo</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@preview.TotalOpenProjects</div>
                    <div class="stat-label">Dự án đang chạy</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@preview.Groups.Count</div>
                    <div class="stat-label">PM bị nhắc</div>
                </div>
            </div>

            @if (!preview.HasSomethingToSend)
            {
                <p class="muted">Mọi dự án đang chạy đều đã có báo cáo trong tuần này — không cần gửi nhắc.</p>
            }
            else
            {
                <p class="hint" style="margin-bottom:8px">Nội dung sẽ gửi lên nhóm:</p>
                <pre class="message-preview">@preview.Message</pre>
            }

            <div class="form-actions">
                @using (Html.BeginForm("Send", "Notifications", new { kind = preview.Kind }, FormMethod.Post, new { @class = "inline-form" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary"
                            onclick="return confirm('Gửi ngay nội dung này lên nhóm Telegram?');">
                        Gửi ngay lên nhóm
                    </button>
                }
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-head">
        <span>Lịch sử gửi</span>
        <span class="muted" style="font-weight:400">@Model.History.Count lần gần nhất</span>
    </div>

    @if (Model.History.Count == 0)
    {
        <div class="empty-state">Chưa gửi lần nào.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Thời điểm</th>
                        <th>Kỳ nhắc</th>
                        <th>Tuần</th>
                        <th class="num">Dự án</th>
                        <th class="num">PM / Người nhận</th>
                        <th>Cách gửi</th>
                        <th>Kết quả</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.History)
                    {
                        <tr>
                            <td class="nowrap">@log.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="nowrap">@log.KindLabel</td>
                            <td class="nowrap muted">Tuần @log.Week/@log.Year</td>
                            <td class="num">@log.MissingProjectCount</td>
                            <td class="num">
                                @if (log.IsEmailKind)
                                {
                                    <span title="Đã gửi @log.SentCount mail trên @log.PmCount người cần nhắc">
                                        @log.SentCount/@log.PmCount
                                    </span>
                                }
                                else
                                {
                                    @log.PmCount
                                }
                            </td>
                            <td class="muted">
                                @if (log.IsManual)
                                {
                                    <text>Thủ công@(string.IsNullOrEmpty(log.TriggeredBy) ? "" : " · " + log.TriggeredBy)</text>
                                }
                                else
                                {
                                    <text>Theo lịch</text>
                                }
                            </td>
                            <td>
                                @if (log.Success && log.MissingProjectCount > 0)
                                {
                                    <span class="badge badge-active">Đã gửi</span>
                                }
                                else if (log.Success)
                                {
                                    <span class="badge badge-inactive">Không cần gửi</span>
                                }
                                else
                                {
                                    <span class="badge badge-waiting" title="@log.Error">Lỗi</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
