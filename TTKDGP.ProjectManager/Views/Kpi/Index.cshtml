@model List<TTKDGP.ProjectManager.Models.KpiMonth>
@using TTKDGP.ProjectManager.Models
@using TTKDGP.ProjectManager.Services
@using TTKDGP.ProjectManager.Controllers
@{
    ViewBag.Title = "KPI theo tháng";

    int year = ViewBag.Year;
    int month = ViewBag.Month;
    int userId = ViewBag.UserId;
    var users = ViewBag.Users as List<User> ?? new List<User>();
    var summary = ViewBag.Summary as KpiSummary ?? new KpiSummary();

    var can = ViewBag.Can as Func<string, bool>;
    var canGenerate = can != null && can("kpi.generate");
    var canExport = can != null && can("kpi.export");
    var canConfig = ViewBag.CanConfig != null && (bool)ViewBag.CanConfig;

    // Năm quanh hiện tại là đủ: KPI chấm theo tháng vừa qua, không ai chấm trước cả năm.
    var yearOptions = new List<int>();
    for (var y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++) { yearOptions.Add(y); }

    // Thang của thanh điểm trong bảng. Lấy theo trần cấu hình chứ không cố định 100: đổi trọng số
    // thành 40/80 thì thanh phải theo, không thì ai cũng trông như vượt trần.
    var scaleMax = KpiService.MaxQualityPoint;
    if (scaleMax <= 0) { scaleMax = 100; }

    Func<decimal, int> pct = v =>
    {
        var p = (int)Math.Round(v * 100 / scaleMax);
        return p < 0 ? 0 : (p > 100 ? 100 : p);
    };

    // Màu thanh đi theo xếp loại, cùng thang màu với huy hiệu — nhìn một màu là biết một tình
    // trạng, không phải đọc chữ rồi đối chiếu lại.
    Func<string, string> barTone = rank =>
        rank == KpiRanks.Fail ? "bar-late"
        : (rank == KpiRanks.Pass ? "bar-warn" : "bar-ok");
}

<div class="page-head">
    <div>
        <h1>KPI theo tháng</h1>
        <p>
            Đánh giá chất lượng làm việc hàng tháng: cả hỗ trợ và thực hiện đều chấm theo
            <strong>giờ</strong> — hỗ trợ tối đa @KpiService.SupportMaxPoint.ToString("0.##")
            khi đủ mốc @KpiConfigService.Current.SupportHoursShare.ToString("0.##") giờ tháng
            (có trần), thực hiện @KpiService.ExecuteMaxPoint.ToString("0.##") khi đủ mốc
            @KpiConfigService.Current.ExecuteHoursShare.ToString("0.##") giờ tháng (không chặn trên);
            việc riêng cộng theo % từng việc; thiếu giờ công thì nhân tỷ lệ ngày công.
        </p>
    </div>
    <div class="btn-row">
        @if (canGenerate)
        {
            using (Html.BeginForm("Calculate", "Kpi", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@year" />
                <input type="hidden" name="month" value="@month" />
                <button type="submit" class="btn btn-primary"
                        onclick="return confirm('Chốt KPI tháng @month/@year cho toàn bộ nhân sự? Điểm đã lưu của tháng này sẽ được tính lại theo công thức đang áp dụng.');">
                    Tính &amp; lưu KPI tháng @month/@year
                </button>
            }
        }
        @if (canExport && Model.Count > 0)
        {
            <a class="btn btn-default"
               href="@Url.Action("Export", "Kpi", new { year = year, month = month, userId = userId > 0 ? (int?)userId : null })">Xuất Excel</a>
        }
        @if (canConfig)
        {
            <a class="btn btn-default" href="@Url.Action("Index", "KpiConfig")">Cấu hình công thức</a>
        }
    </div>
</div>

@* ---------- Hàng thẻ tổng quan ---------- *@
@if (Model.Count > 0)
{
    <div class="stats">
        <div class="stat stat-primary">
            <div class="stat-value">@summary.AveragePoint.ToString("0.#")</div>
            <div class="stat-label">Điểm trung bình · @summary.Total nhân sự</div>
        </div>
        <div class="stat stat-ok">
            <div class="stat-value">@summary.PassCount</div>
            <div class="stat-label">Đạt trở lên (@summary.PassPercent%)</div>
        </div>
        <div class="stat @(summary.FailCount > 0 ? "stat-late" : "")">
            <div class="stat-value">@summary.FailCount</div>
            <div class="stat-label">Chưa đạt</div>
        </div>
        <div class="stat @(summary.ShortHoursCount > 0 ? "stat-warn" : "")">
            <div class="stat-value">@summary.ShortHoursCount</div>
            <div class="stat-label">Chưa đủ giờ công</div>
        </div>
        <div class="stat">
            <div class="stat-value stat-value-sm">@summary.TopName</div>
            <div class="stat-label">Cao nhất · @summary.TopPoint.ToString("0.#") điểm</div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Kpi", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field">
                    <label for="month">Tháng</label>
                    <select id="month" name="month">
                        @for (var m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(month == m)">Tháng @m</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label for="year">Năm</label>
                    <select id="year" name="year">
                        @foreach (var y in yearOptions)
                        {
                            <option value="@y" selected="@(year == y)">@y</option>
                        }
                    </select>
                </div>
                <div class="filter-field grow">
                    <label for="userId">Nhân viên</label>
                    <select id="userId" name="userId">
                        <option value="">— Tất cả —</option>
                        @foreach (var u in users)
                        {
                            <option value="@u.Id" selected="@(userId == u.Id)">@u.FullName</option>
                        }
                    </select>
                </div>
                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                </div>
            </div>
        }
        <span class="hint">
            Ngày công chuẩn của tháng: <strong>@ViewBag.StandardDays ngày</strong>
            (mỗi ngày @KpiService.HoursPerDay.ToString("0.##") giờ).
            Mốc chuẩn của điểm chất lượng: <strong>@scaleMax.ToString("0.##")</strong> — không phải
            trần: nhóm thực hiện chấm theo giờ nên vượt mốc được, việc riêng cũng cộng thêm ngoài.
        </span>
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            Không có nhân sự nào khớp bộ lọc trong tháng @month/@year.
        </div>
    }
    else
    {
        if (ViewBag.HasPreview != null && (bool)ViewBag.HasPreview)
        {
            <div class="card-body">
                <span class="hint">
                    Dòng đánh dấu <span class="badge badge-waiting">tạm tính</span> được tính trực tiếp
                    từ dữ liệu công việc hiện tại, chưa lưu.
                    @if (canGenerate)
                    {
                        <text>Bấm <strong>Tính &amp; lưu KPI tháng @month/@year</strong> để chốt kết quả.</text>
                    }
                </span>
            </div>
        }
        <div class="table-wrap">
            <table class="data table-collapse">
                <thead>
                    <tr>
                        <th class="center">#</th>
                        <th>Nhân sự</th>
                        <th class="kpi-col-score">KPI cuối cùng</th>
                        <th class="center col-hide-sm">Xếp loại</th>
                        <th class="center col-hide-sm nowrap">Hỗ trợ</th>
                        <th class="center col-hide-sm nowrap">Thực hiện</th>
                        <th class="center col-hide-sm nowrap">Việc riêng</th>
                        <th class="center col-hide-sm nowrap">Điểm trừ</th>
                        <th class="center col-hide-sm nowrap">Giờ công</th>
                        <th class="center col-hide-sm nowrap">Nghỉ phép</th>
                        @if (canGenerate)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var r = Model[i];
                        var isShort = r.AttendanceRate < 100;

                        // Diem tru = phat bao cao tre cua hai nhom Ho tro + Thuc hien, cung cong
                        // thuc TeamDashboardController.TotalPenalty dang dung. r.SupportPoint/
                        // ExecutePoint (KpiService.cs) da TRU SAN khoan nay ben trong (va chan
                        // khong cho am) — de bang doc duoc nhu mot phep tinh that theo dung thu
                        // tu cot (Ho tro + Thuc hien + Viec rieng − Diem tru = Chat luong), cong
                        // nguoc lai phat de ra DIEM GOC (truoc khi tru) cho rieng hai o nay.
                        // Luu y: neu mot nhom bi phat NANG hon diem kiem duoc (r.SupportPoint da
                        // ve 0 do chan am), diem goc tinh lai o day se THIEU dung phan da mat —
                        // truong hop hiem (phai tre rat nhieu lan) nen chap nhan duoc.
                        var rSupportPenalty = KpiService.SupportLatePenalty(r.SupportLateCount);
                        var rExecutePenalty = KpiService.ExecuteLatePenalty(r.ExecuteLateCount);
                        var rTotalPenalty = rSupportPenalty + rExecutePenalty;
                        var rGrossSupport = r.SupportPoint + rSupportPenalty;
                        var rGrossExecute = r.ExecutePoint + rExecutePenalty;
                        var rDisplayQuality = r.AttendanceRate + r.AssignedPoint - rTotalPenalty;
                        if (rDisplayQuality < 0) { rDisplayQuality = 0; }

                        <tr>
                            @* Ba hạng đầu đeo huy chương: bảng đã sắp theo điểm nên thứ hạng là
                               thông tin sẵn có, chỉ cần làm nó nhìn thấy được. *@
                            <td class="center">
                                @if (i < 3)
                                {
                                    <span class="rank-medal rank-@(i + 1)">@(i + 1)</span>
                                }
                                else
                                {
                                    <span class="muted">@(i + 1)</span>
                                }
                            </td>
                            <td class="col-name">
                                <a href="@Url.Action("Detail", "Kpi", new { year = r.Year, month = r.Month, userId = r.UserId })">@r.UserFullName</a>
                                @if (r.Id == 0)
                                {
                                    <span class="badge badge-waiting">tạm tính</span>
                                }
                                <div class="cell-recap">
                                    <span>@r.Rank</span>
                                    <span>·</span>
                                    <span>Hỗ trợ @rGrossSupport.ToString("0.##") (@r.SupportHours.ToString("0.#")/@r.SupportCapHours.ToString("0.#")h)</span>
                                    <span>·</span>
                                    <span>Thực hiện @rGrossExecute.ToString("0.##")</span>
                                    @if (r.AssignedPoint > 0)
                                    {
                                        <span>·</span>
                                        <span>Việc riêng +@r.AssignedPoint.ToString("0.##")</span>
                                    }
                                    <span>·</span>
                                    <span class="@(isShort ? "danger-text" : "")">
                                        @r.WorkedHours.ToString("0.#")/@r.RequiredHours.ToString("0.#") giờ
                                    </span>
                                </div>
                            </td>

                            @* Cột điểm chính: con số và thanh nằm cùng ô, vì thanh không có số thì
                               không đọc được chính xác, còn số không có thanh thì không so sánh
                               được giữa các dòng bằng mắt. *@
                            <td class="kpi-col-score">
                                <div class="kpi-cell">
                                    <strong class="kpi-cell-num">@r.FinalPoint.ToString("0")</strong>
                                    <div class="kpi-cell-bar">
                                        <div class="progress-track">
                                            <div class="progress-fill @barTone(r.Rank)" style="width:@pct(r.FinalPoint)%"></div>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td class="center col-hide-sm">
                                <span class="@KpiRanks.BadgeClass(r.Rank)">@r.Rank</span>
                            </td>
                            @* Hai loại số 0 rất khác nhau: "không được giao việc nào" và "có việc
                               nhưng chưa xong". Cùng hiện 0 thì người quản lý không phân biệt được
                               ai cần nhắc làm việc, ai cần được giao việc. *@
                            @* Nhóm hỗ trợ chấm theo GIỜ so với mốc 30% (có trần), nên dòng phụ hiện
                               giờ chứ không hiện "x/y việc" — cùng lối với cột Thực hiện. *@
                            @* Hien DIEM GOC (rGrossSupport, truoc khi tru phat — xem cong thuc o
                               dau vong lap) de cong don voi Thuc hien/Viec rieng roi tru Diem tru
                               ra dung Chat luong theo dung thu tu cot trai sang phai. *@
                            <td class="center col-hide-sm">
                                @rGrossSupport.ToString("0.##")
                                <div class="cell-sub muted">
                                    @if (r.SupportTotal == 0)
                                    {
                                        <text>chưa giao việc</text>
                                    }
                                    else if (r.IsSupportCapped)
                                    {
                                        @* Giờ hỗ trợ bị cắt vì vượt trần — phải thấy được ngay
                                           trên bảng, không thì con số giờ công trông như sai.
                                           Giữ nguyên dạng "đã tính / mốc" như dòng bình thường
                                           rồi mới nói phần vượt: đảo thứ tự thì số thô đứng
                                           trước, đọc nhầm thành mốc. *@
                                        <span class="danger-text"
                                              title="Giờ hỗ trợ thực tế @r.SupportHoursRaw.ToString("0.#")h, vượt mốc nên phần dư không tính vào điểm lẫn giờ công">
                                            @r.SupportHours.ToString("0.#")/@r.SupportCapHours.ToString("0.#")h ·
                                            thực tế @r.SupportHoursRaw.ToString("0.#")h
                                        </span>
                                    }
                                    else
                                    {
                                        <text>@r.SupportHours.ToString("0.#")/@r.SupportCapHours.ToString("0.#")h</text>
                                    }
                                </div>
                            </td>
                            @* Nhóm thực hiện chấm theo GIỜ so với định mức, không theo số việc —
                               nên dòng phụ hiện giờ chứ không hiện "x/y việc". Hien DIEM GOC, cung
                               ly do voi cot Ho tro o tren. *@
                            <td class="center col-hide-sm">
                                <span class="@(rGrossExecute > KpiService.ExecuteMaxPoint ? "ok-text" : "")">
                                    @rGrossExecute.ToString("0.##")
                                </span>
                                <div class="cell-sub muted">
                                    @if (r.ExecuteTotal == 0)
                                    {
                                        <text>chưa giao việc</text>
                                    }
                                    else
                                    {
                                        <text>@r.ExecuteHours.ToString("0.#")/@r.ExecuteTargetHours.ToString("0.#")h</text>
                                    }
                                </div>
                            </td>
                            <td class="center col-hide-sm">
                                @if (r.AssignedPoint > 0)
                                {
                                    <span class="ok-text">+@r.AssignedPoint.ToString("0.##")</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            @* Điểm trừ = phạt báo cáo trễ của hai nhóm Hỗ trợ + Thực hiện, cùng
                               công thức TeamDashboardController.TotalPenalty đang dùng — tách
                               breakdown để đối chiếu công thức đúng/sai theo từng nhóm. Đặt NGAY
                               SAU Việc riêng, TRƯỚC Chất lượng — đúng thứ tự phép tính. *@
                            <td class="center col-hide-sm nowrap">
                                <span class="@(rTotalPenalty > 0 ? "danger-text" : "")">@rTotalPenalty.ToString("0.##")</span>
                                <div class="cell-sub muted">Hỗ trợ: @rSupportPenalty.ToString("0.##") · Thực hiện: @rExecutePenalty.ToString("0.##")</div>
                            </td>

                            @* Giờ công là chỗ điểm bị hạ nhiều nhất — bày cả tỷ lệ lẫn số giờ,
                               và tô cảnh báo ngay khi chưa đủ. *@
                            <td class="center col-hide-sm nowrap"
                                title="Giờ đã làm / giờ yêu cầu của tháng">
                                <span class="@(isShort ? "danger-text" : "")">@r.AttendanceRate.ToString("0.#")%</span>
                                <div class="cell-sub muted">@r.WorkedHours.ToString("0.#")/@r.RequiredHours.ToString("0.#")h</div>
                            </td>

                            @* Không nhập tay: số ngày nghỉ lấy từ các đơn ĐÃ DUYỆT ở màn
                               Duyệt nghỉ phép, nên chỉ hiển thị. *@
                            <td class="center col-hide-sm" title="Tổng ngày nghỉ phép đã duyệt trong tháng">
                                @if (r.LeaveDays > 0)
                                {
                                    @r.LeaveDays.ToString("0.##")
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>

                            @if (canGenerate)
                            {
                                <td class="nowrap">
                                    <form method="post" action="@Url.Action("Attendance", "Kpi")" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="year" value="@r.Year" />
                                        <input type="hidden" name="month" value="@r.Month" />
                                        <input type="hidden" name="userId" value="@r.UserId" />
                                        <input type="hidden" name="back" value="index" />
                                        <button type="submit" class="btn btn-default btn-sm">Tính lại</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-body">
            <span class="hint">
                Bấm vào tên nhân sự để xem chi tiết công việc và cách tính điểm.
                Nhóm <strong>chưa giao việc</strong> được 0 điểm — điểm chấm trên việc đã làm, nên
                người không được phân việc của một nhóm sẽ mất trọn điểm nhóm đó.
                Cả hai cột <strong>Hỗ trợ</strong> và <strong>Thực hiện</strong> chấm theo
                <strong>giờ</strong> so với mốc của mình, không theo số đầu việc.
                Hỗ trợ: mốc @KpiConfigService.Current.SupportHoursShare.ToString("0.##") &times; giờ
                yêu cầu tháng, <strong>có trần</strong> @KpiService.SupportMaxPoint.ToString("0.##")
                — làm quá mốc không được thêm điểm và phần giờ dư cũng không vào giờ công.
                Thực hiện: mốc @KpiConfigService.Current.ExecuteHoursShare.ToString("0.##") &times; giờ
                yêu cầu tháng, <strong>không chặn trên</strong> — làm nhiều giờ hơn thì điểm vượt
                @KpiService.ExecuteMaxPoint.ToString("0.##").
                <strong>Nghỉ phép</strong> là tổng ngày nghỉ <strong>đã duyệt</strong> trong tháng,
                lấy từ màn <a href="@Url.Action("Approve", "Leaves")">Duyệt nghỉ phép</a> — không sửa
                trực tiếp ở đây. Duyệt thêm đơn xong thì bấm <strong>Tính lại</strong> ở cuối dòng.
                <strong>Giờ công</strong> do hệ thống tự tính: số ngày làm việc từ ngày bắt đầu đến
                hạn hoàn thành của các việc <strong>đã hoàn thành</strong>, nhân
                @KpiService.HoursPerDay.ToString("0.##") giờ — chỉ đếm ngày <strong>nằm trong
                tháng</strong> đang chấm. Việc <strong>đang làm chưa sinh giờ nào</strong> cho tới
                khi xong. Giờ <strong>hỗ trợ</strong> bị chặn trần ở
                @KpiConfigService.Current.SupportHoursShare.ToString("0.##") &times; giờ yêu cầu tháng;
                phần vượt không được tính vào giờ công.
                @if (canConfig)
                {
                    <text>
                        Đổi trọng số, mức trừ hay ngưỡng xếp loại ở màn
                        <a href="@Url.Action("Index", "KpiConfig")">Cấu hình KPI</a>.
                    </text>
                }
            </span>
        </div>
    }
</div>
