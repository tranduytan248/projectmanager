@using TTKDGP.ProjectManager.Infrastructure
@{
    var currentUser = ViewBag.CurrentUser as AppIdentity;
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "";
    var action = ViewContext.RouteData.Values["action"] as string ?? "";

    // Menu dựng động từ danh mục chức năng: mỗi mục chỉ hiện khi tài khoản có quyền "xem" màn đó.
    var role = currentUser != null ? currentUser.Role : null;
    Func<string, bool> can = p => TTKDGP.ProjectManager.Models.Permissions.UserHas(role, p);
    Func<TTKDGP.ProjectManager.Models.MenuLink, bool> linkActive = l =>
        controller == l.Controller && (l.Action == "Index" || action == l.Action);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Quản lý dự án NCPT</title>

    <link rel="icon" href="@Url.Content("~/favicon.ico")" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/Content/img/favicon-32x32.png")" />
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/Content/img/favicon-16x16.png")" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content("~/Content/img/apple-touch-icon.png")" />
    <link rel="manifest" href="@Url.Content("~/site.webmanifest")" />
    <meta name="theme-color" content="#1a56a8" />

    <link rel="stylesheet" href="@Url.Content("~/Content/lib/select2.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css")" />
</head>
@* Chưa đăng nhập thì không dựng menu dọc — trang Đăng nhập dùng trọn bề ngang *@
<body class="@(currentUser != null ? "has-sidebar" : "")">
    @if (currentUser != null)
    {
        @* Áp trạng thái thu gọn NGAY trước khi dựng menu để không bị nháy khi tải trang. *@
        <script>try{if(localStorage.getItem('sidebarCollapsed')==='1')document.body.classList.add('sidebar-collapsed');}catch(e){}</script>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-head">
                <a class="brand" href="@Url.Action("Index", "Home")">
                    <span class="brand-mark">NCPT</span>
                    <span class="brand-text">Quản lý dự án &amp; nhân sự</span>
                </a>
                <button type="button" class="sidebar-collapse" data-sidebar-toggle
                        aria-label="Thu gọn menu" title="Thu gọn menu">«</button>
            </div>

            <nav class="sidenav">
                @foreach (var menuSection in TTKDGP.ProjectManager.Models.Permissions.Menu)
                {
                    var nodes = menuSection.Nodes
                        .Where(n => n.IsGroup ? n.Children.Any(c => can(c.Permission)) : can(n.Link.Permission))
                        .ToList();
                    if (nodes.Count == 0) { continue; }

                    if (!string.IsNullOrEmpty(menuSection.Title))
                    {
                        <div class="sidenav-title">@menuSection.Title</div>
                    }

                    foreach (var node in nodes)
                    {
                        if (!node.IsGroup)
                        {
                            var link = node.Link;
                            <a href="@Url.Action(link.Action, link.Controller)" class="@(linkActive(link) ? "active" : "")">@link.Label</a>
                        }
                        else
                        {
                            var kids = node.Children.Where(c => can(c.Permission)).ToList();
                            var groupActive = kids.Any(c => linkActive(c));
                            <details class="sidenav-group" @(groupActive ? "open" : "")>
                                <summary class="@(groupActive ? "active" : "")">@node.GroupLabel</summary>
                                <div class="sidenav-sub">
                                    @foreach (var c in kids)
                                    {
                                        <a href="@Url.Action(c.Action, c.Controller)" class="@(linkActive(c) ? "active" : "")">@c.Label</a>
                                    }
                                </div>
                            </details>
                        }
                    }
                }
            </nav>
        </aside>

        @* Nền mờ phủ nội dung khi mở menu trên màn hình hẹp; bấm vào để đóng *@
        <div class="sidebar-scrim" data-menu-close></div>
    }

    <div class="shell">
        <header class="topbar">
            <div class="container topbar-inner">
                @if (currentUser != null)
                {
                    <button type="button" class="menu-toggle" data-menu-toggle
                            aria-label="Mở menu" aria-controls="sidebar" aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>

                    @* Nút mở lại menu khi đã thu gọn (chỉ hiện trên màn hình rộng lúc menu đang đóng) *@
                    <button type="button" class="sidebar-expand" data-sidebar-toggle
                            aria-label="Mở menu" title="Mở menu">☰</button>

                    @* Trên màn hình hẹp menu dọc bị ẩn nên thanh trên phải tự mang tên hệ thống *@
                    <a class="brand brand-compact" href="@Url.Action("Index", "Home")">
                        <span class="brand-mark">NCPT</span>
                    </a>
                }
                else
                {
                    <a class="brand" href="@Url.Action("Index", "Home")">
                        <span class="brand-mark">NCPT</span>
                        <span class="brand-text">Quản lý dự án &amp; nhân sự</span>
                    </a>
                }

                @if (currentUser != null)
                {
                    var wy = WeekHelper.CurrentYear;
                    var ww = WeekHelper.CurrentWeek;
                    <div class="topbar-week" title="Tuần đang diễn ra">
                        <span class="topbar-week-dot"></span>
                        Tuần @ww/@wy
                        <span class="topbar-week-range">@WeekHelper.FirstDayOfWeek(wy, ww).ToString("dd/MM") – @WeekHelper.LastDayOfWeek(wy, ww).ToString("dd/MM/yyyy")</span>
                    </div>
                }

                <div class="user-area">
                    @if (currentUser != null)
                    {
                        <a class="user-chip" href="@Url.Action("Profile", "Account")" title="Thông tin cá nhân">
                            @currentUser.FullName
                            <em>@TTKDGP.ProjectManager.Models.Roles.Display(currentUser.Role)</em>
                        </a>
                        using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "inline-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-sm">Đăng xuất</button>
                        }
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                    }
                </div>
            </div>
        </header>

        <main class="container main">
            @if (TempData["Flash"] != null)
            {
                <div class="alert alert-success">@TempData["Flash"]</div>
            }
            @if (TempData["FlashError"] != null)
            {
                <div class="alert alert-danger">@TempData["FlashError"]</div>
            }

            @RenderBody()
        </main>

        <footer class="footer">
            <div class="container">
                Tổ NCPT &mdash; Trung tâm Kinh doanh Giải pháp, VNPT Khánh Hòa
            </div>
        </footer>
    </div>

    @* Thư viện đóng gói sẵn trong project, không phụ thuộc CDN nên chạy được cả khi server không có internet *@
    <script src="@Url.Content("~/Scripts/lib/jquery.min.js")"></script>
    <script src="@Url.Content("~/Scripts/lib/select2.min.js")"></script>
    <script src="@Url.Content("~/Scripts/lib/select2.vi.js")"></script>
    <script src="@Url.Content("~/Scripts/app.js")"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
