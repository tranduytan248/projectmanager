@model List<TTKDGP.ProjectManager.Models.IntegrationSystem>
@using TTKDGP.ProjectManager.Infrastructure
@{
    ViewBag.Title = "Hệ thống tích hợp";
}

<div class="page-head">
    <div>
        <h1>Hệ thống tích hợp</h1>
        <p>
            Các hệ thống bên ngoài được phép trao đổi dữ liệu. Mỗi hệ thống có một khoá bí mật
            để ký checksum khi tích hợp. Tổng cộng @Model.Count hệ thống.
        </p>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Edit", "IntegrationSystems")">+ Thêm hệ thống</a>
</div>

<details class="card api-help">
    <summary>Hướng dẫn tích hợp API lấy dữ liệu HRM</summary>
    <div class="card-body">
        <p>
            Đối tác gọi <code>POST /api/hrm</code>, thân là JSON, xác thực bằng checksum SHA-256.
            Endpoint không cần đăng nhập — chỉ cần checksum đúng và hệ thống đang hoạt động.
        </p>

        <p class="hint" style="margin-bottom:6px"><strong>Các trường bản tin (đúng thứ tự tạo checksum):</strong></p>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th class="num">#</th><th>Trường</th><th>Bắt buộc</th><th>Mô tả</th></tr>
                </thead>
                <tbody>
                    <tr><td class="num">1</td><td><code>partnerCode</code></td><td>Có</td><td>Mã hệ thống (cột Mã ở bảng trên)</td></tr>
                    <tr><td class="num">2</td><td><code>requestId</code></td><td>Có</td><td>Mã yêu cầu duy nhất mỗi lần gọi</td></tr>
                    <tr><td class="num">3</td><td><code>requestTime</code></td><td>Có</td><td>Thời gian gửi, dạng <code>yyyyMMddHHmmss</code></td></tr>
                    <tr><td class="num">4</td><td><code>resource</code></td><td>Có</td><td><code>employees</code> · <code>workplaces</code> · <code>positions</code></td></tr>
                    <tr><td class="num">5</td><td><code>page</code></td><td>Không</td><td>Trang, mặc định 1</td></tr>
                    <tr><td class="num">6</td><td><code>pageSize</code></td><td>Không</td><td>Số dòng/trang, mặc định 100, tối đa 500</td></tr>
                    <tr><td class="num">7</td><td><code>keyword</code></td><td>Không</td><td>Từ khoá lọc</td></tr>
                </tbody>
            </table>
        </div>

        <p class="hint" style="margin:12px 0 6px"><strong>Cách tạo checksum của request:</strong></p>
        <pre class="message-preview">checksum = SHA256( partnerCode|requestId|requestTime|resource|page|pageSize|keyword|&lt;khoá bí mật&gt; )</pre>
        <ul style="margin:6px 0 0;padding-left:20px;font-size:13px;color:var(--text-muted)">
            <li>Ghép các trường 1→7 theo đúng thứ tự, ngăn nhau bởi ký tự <code>|</code>.</li>
            <li>Trường không bắt buộc mà bỏ trống thì để rỗng nhưng vẫn giữ dấu <code>|</code>.</li>
            <li>Khoá bí mật của hệ thống đứng cuối cùng. Kết quả băm là chuỗi hex thường.</li>
        </ul>

        <p class="hint" style="margin:12px 0 6px"><strong>Ví dụ thân request:</strong></p>
        <pre class="message-preview">{
  "partnerCode": "CRM",
  "requestId": "REQ-20260724-0001",
  "requestTime": "20260724013000",
  "resource": "employees",
  "page": 1,
  "pageSize": 100,
  "keyword": "",
  "checksum": "&lt;chuỗi SHA-256&gt;"
}</pre>

        <p class="hint" style="margin:12px 0 6px"><strong>Phản hồi khi thành công:</strong></p>
        <pre class="message-preview">{
  "code": "00", "message": "Thành công.",
  "requestId": "REQ-20260724-0001", "resource": "employees",
  "page": 1, "pageSize": 100, "totalItems": 780, "totalPages": 8,
  "data": [ ... ], "checksum": "&lt;chuỗi SHA-256&gt;"
}</pre>
        <ul style="margin:6px 0 0;padding-left:20px;font-size:13px;color:var(--text-muted)">
            <li>
                Kiểm phản hồi đúng nguồn bằng cách tính lại:
                <code>SHA256( code|message|requestId|resource|page|pageSize|totalItems|&lt;khoá bí mật&gt; )</code>
                — lấy giá trị từ chính phản hồi, vì <code>page</code> và <code>pageSize</code> có thể
                khác lúc gửi (trang vượt quá bị kéo về trang cuối, <code>pageSize</code> bị chặn ở 500).
            </li>
            <li>
                Bản ghi trong <code>data</code> <strong>lược bỏ trường rỗng</strong>: nhân sự không có
                email thì phản hồi không có khoá <code>email</code>. Bên nhận nên coi khoá vắng mặt là
                giá trị rỗng.
            </li>
        </ul>

        <p class="hint" style="margin:12px 0 6px"><strong>Mã lỗi:</strong></p>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th><code>code</code></th><th>Ý nghĩa</th></tr>
                </thead>
                <tbody>
                    <tr><td><code>00</code></td><td>Thành công</td></tr>
                    <tr><td><code>01</code></td><td>Checksum không hợp lệ</td></tr>
                    <tr><td><code>02</code></td><td>Hệ thống không tồn tại hoặc đang bị khoá</td></tr>
                    <tr><td><code>03</code></td><td>Thiếu trường bắt buộc, hoặc <code>resource</code> không đúng</td></tr>
                    <tr><td><code>99</code></td><td>Lỗi hệ thống (kể cả khi thân JSON sai cú pháp)</td></tr>
                </tbody>
            </table>
        </div>
        <p class="hint" style="margin-top:8px">
            Phản hồi lỗi <strong>không kèm</strong> <code>checksum</code> (chưa xác thực được bên gọi thì
            không ký), và các số phân trang đều bằng <code>0</code>. Mọi trường hợp đều trả HTTP 200 —
            phân biệt thành công hay lỗi bằng <code>code</code>, không bằng mã HTTP.
        </p>
    </div>
</details>

<details class="card api-help">
    <summary>Hướng dẫn tích hợp API gửi tin nhắn SMS</summary>
    <div class="card-body">
        <p>
            Đối tác gọi <code>GET /api/Util/SendSms</code> với bốn tham số trên query string. Xác thực
            bằng cặp <strong>Mã hệ thống</strong> và <strong>Khoá bí mật</strong> ở bảng trên — dùng
            đúng khoá đã cấp, không cấp khoá riêng cho SMS. Phần mềm chuẩn hoá số máy rồi chuyển tiếp
            sang tổng đài SMS dùng chung.
        </p>

        <p class="hint" style="margin-bottom:6px"><strong>Các tham số:</strong></p>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th class="num">#</th><th>Tham số</th><th>Bắt buộc</th><th>Mô tả</th></tr>
                </thead>
                <tbody>
                    <tr><td class="num">1</td><td><code>partnerCode</code></td><td>Có</td><td>Mã hệ thống (cột <strong>Mã</strong> ở bảng trên)</td></tr>
                    <tr><td class="num">2</td><td><code>phoneNums</code></td><td>Có</td><td>Danh sách số nhận, ngăn nhau bởi dấu phẩy</td></tr>
                    <tr><td class="num">3</td><td><code>smsContents</code></td><td>Có</td><td>Nội dung tin nhắn</td></tr>
                    <tr><td class="num">4</td><td><code>secretKey</code></td><td>Có</td><td>Khoá bí mật của chính hệ thống đó (cột <strong>Khoá bí mật</strong>)</td></tr>
                </tbody>
            </table>
        </div>

        <ul style="margin:10px 0 0;padding-left:20px;font-size:13px;color:var(--text-muted)">
            <li>Mọi giá trị phải được URL-encode khi ghép vào địa chỉ (nội dung có dấu, dấu cách, dấu phẩy…).</li>
            <li>Số máy nhận cả <code>0942963127</code>, <code>84942963127</code> hay <code>+84 942 963 127</code>.</li>
            <li>Một lần gọi tối đa 50 số; số sai định dạng bị loại và trả lại trong <code>invalidPhones</code>.</li>
        </ul>

        <p class="hint" style="margin:12px 0 6px"><strong>Ví dụ gọi:</strong></p>
        <pre class="message-preview">GET /api/Util/SendSms?partnerCode=CRM&amp;phoneNums=0942963127%2C0912345678
    &amp;smsContents=Xin%20chao!%20Toi%20la%20SMS&amp;secretKey=&lt;khoá bí mật&gt;</pre>
        <p class="hint">
            Phản hồi có <code>code</code> = <code>00</code> khi thành công, kèm <code>message</code> của
            tổng đài và danh sách số đã gửi. Mã lỗi: <code>01</code> sai khoá bí mật, <code>02</code>
            hệ thống không tồn tại/đang khoá, <code>03</code> tham số hoặc số máy sai, <code>04</code>
            tổng đài từ chối hoặc tính năng SMS đang tắt.
        </p>
        <p class="hint" style="margin-top:10px">
            <strong>Lưu ý:</strong> khoá bí mật đi trên query string nên sẽ bị ghi vào nhật ký của IIS
            và các thiết bị trung gian. Chỉ cấp khoá cho hệ thống trong mạng nội bộ, và tạo lại khoá
            ngay khi nghi bị lộ.
        </p>
    </div>
</details>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Index", "IntegrationSystems", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field grow">
                    <label for="keyword">Tìm kiếm</label>
                    <input type="search" id="keyword" name="keyword" value="@ViewBag.Keyword"
                           placeholder="Mã hoặc tên hệ thống..." />
                </div>
                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a class="btn btn-default" href="@Url.Action("Index", "IntegrationSystems")">Xoá lọc</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">Chưa có hệ thống tích hợp nào.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên hệ thống</th>
                        <th>Khoá bí mật</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.Code</strong></td>
                            <td>@s.Name</td>
                            <td class="muted">
                                @* Chỉ hiện phần đầu khoá cho gọn; xem/sao chép đủ ở trang sửa. *@
                                <code class="key-peek">@ViewHelpers.KeyPeek(s.PrivateKey)</code>
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge badge-active">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Ngừng</span>
                                }
                            </td>
                            <td class="muted nowrap">@s.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="actions">
                                <div class="btn-group">
                                    <a class="btn btn-default btn-sm" href="@Url.Action("Edit", "IntegrationSystems", new { id = s.Id })">Sửa</a>
                                    @using (Html.BeginForm("Delete", "IntegrationSystems", new { id = s.Id }, FormMethod.Post, new { @class = "inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Xoá hệ thống &quot;@s.Code&quot;? Khoá bí mật của nó cũng mất, hệ thống đối tác sẽ không tích hợp được nữa.');">
                                            Xoá
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
