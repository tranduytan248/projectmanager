@model TTKDGP.ProjectManager.Controllers.MyProjectsViewModel
@using TTKDGP.ProjectManager.Models
@{
    ViewBag.Title = "Dự án của tôi";
    var year = (int)ViewBag.Year;
    var week = (int)ViewBag.Week;
}

<div class="page-head">
    <div>
        <h1>Dự án của tôi</h1>
        <p>
            @Model.TotalCount dự án đang hoặc đã tham gia@(Model.PmCount > 0 ? ", trong đó " + Model.PmCount + " dự án bạn làm PM" : "").
            Tuần @week/@year.
        </p>
    </div>
    <a class="btn btn-default" href="@Url.Action("Tasks", "MyWork")">Công việc của tôi &rarr;</a>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Projects", "MyWork", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field grow">
                    <label for="q">Tìm kiếm</label>
                    <input type="search" id="q" name="q" value="@Model.Query"
                           placeholder="Tên, mã dự án, khách hàng hoặc PM..." />
                </div>

                <div class="filter-field">
                    <label for="phase">Giai đoạn</label>
                    <select id="phase" name="phase">
                        <option value="">— Tất cả —</option>
                        @foreach (var p in ProjectPhases.All)
                        {
                            <option value="@p" selected="@(Model.Phase == p)">@ProjectPhases.Display(p)</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="state">Trạng thái</label>
                    <select id="state" name="state">
                        <option value="">— Tất cả —</option>
                        @foreach (var s in Model.States)
                        {
                            <option value="@s" selected="@(Model.State == s)">@ProjectStates.Display(s)</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="role">Vai trò</label>
                    <select id="role" name="role">
                        <option value="">— Tất cả —</option>
                        @if (Model.PmCount > 0)
                        {
                            <option value="@TTKDGP.ProjectManager.Controllers.MyProjectsViewModel.RolePm"
                                    selected="@(Model.Role == TTKDGP.ProjectManager.Controllers.MyProjectsViewModel.RolePm)">
                                Tôi làm PM (@Model.PmCount)
                            </option>
                        }
                        @foreach (var r in Model.Roles)
                        {
                            <option value="@r" selected="@(Model.Role == r)">@r</option>
                        }
                    </select>
                </div>

                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    @if (Model.HasFilter)
                    {
                        <a class="btn btn-default" href="@Url.Action("Projects", "MyWork")">Bỏ lọc</a>
                    }
                </div>
            </div>

            if (Model.ClosedCount > 0)
            {
                <div class="check-inline" style="margin-top:10px">
                    <input type="checkbox" id="showClosed" name="showClosed" value="true"
                           @(Model.ShowClosed ? "checked=\"checked\"" : "") />
                    <label for="showClosed">Hiện cả dự án đã đóng (@Model.ClosedCount dự án đã huỷ hoặc kết thúc hỗ trợ)</label>
                </div>
            }
        }
    </div>
</div>

<div class="card">
    @if (Model.Rows.Items.Count == 0)
    {
        <div class="empty-state">
            @if (Model.HasFilter)
            {
                <text>Không có dự án nào khớp bộ lọc.</text>
            }
            else if (Model.TotalCount > 0)
            {
                <text>Các dự án của bạn đều đã đóng.</text>
                <span class="hint">Đánh dấu "Hiện cả dự án đã đóng" để xem.</span>
            }
            else
            {
                <text>Bạn chưa tham gia dự án nào.</text>
                <span class="hint">Nhờ Quản lý Tổ phân công ở màn Dự án → Nhân sự.</span>
            }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Dự án</th>
                        <th>Vai trò của tôi</th>
                        <th>PM</th>
                        <th>Tiến độ checklist</th>
                        <th class="num">Việc của tôi</th>
                        <th>Báo cáo tuần</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows.Items)
                    {
                        var rowClass = !r.Project.IsOpen ? "row-closed"
                            : (r.Project.Phase == ProjectPhases.Support ? "row-support" : "row-implement");
                        <tr class="@rowClass">
                            <td>
                                <strong>@r.Project.Name</strong>
                                @if (!r.IsActiveMember && !r.IsPm)
                                {
                                    <span class="badge badge-inactive">Đã rời</span>
                                }
                                <div class="muted">@ProjectStates.Display(r.Project.State)</div>
                            </td>
                            <td>
                                @if (r.IsPm)
                                {
                                    <span class="badge badge-active">PM</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(r.Role))
                                {
                                    <span>@r.Role</span>
                                }
                                @if (r.JoinedAt.HasValue)
                                {
                                    <div class="muted nowrap">
                                        Từ @r.JoinedAt.Value.ToString("dd/MM/yyyy")
                                        @if (r.LeftAt.HasValue)
                                        {
                                            <text>đến @r.LeftAt.Value.ToString("dd/MM/yyyy")</text>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(r.Project.PmName) ? "(chưa có PM)" : r.Project.PmName)</td>
                            <td>
                                @if (r.Stat.Total == 0)
                                {
                                    <span class="muted">Chưa có checklist</span>
                                }
                                else
                                {
                                    <text>@r.Stat.Done/@r.Stat.Total (@r.Stat.Percent%)</text>
                                }
                            </td>
                            <td class="num">
                                @r.MyOpenCount
                                @if (r.MyOverdueCount > 0)
                                {
                                    <span class="badge badge-inactive">@r.MyOverdueCount quá hạn</span>
                                }
                            </td>
                            <td>
                                @if (r.Report != null && r.Report.IsSubmitted)
                                {
                                    <span class="badge badge-active">Đã nộp @(r.Report.IsOnTime ? "đúng hạn" : "trễ hạn")</span>
                                }
                                else if (r.Report != null)
                                {
                                    <span class="badge">Còn bản nháp</span>
                                }
                                else if (r.IsPm)
                                {
                                    <span class="badge badge-inactive">Chưa nộp</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td class="actions">
                                <div class="btn-group">
                                    <a class="btn btn-default btn-sm"
                                       href="@Url.Action("Details", "WorkProjects", new { id = r.Project.Id })">Chi tiết</a>
                                    <a class="btn btn-default btn-sm"
                                       href="@Url.Action("Index", "Checklist", new { projectId = r.Project.Id })">Checklist</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @Html.Partial("_Pager", Model.Rows.Pager)
    }
</div>
