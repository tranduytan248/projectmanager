@model TTKDGP.ProjectManager.Models.ProjectDetailsViewModel
@using TTKDGP.ProjectManager.Models
@using TTKDGP.ProjectManager.Infrastructure
@{
    var p = Model.Project;
    ViewBag.Title = p.Name;

    // Người không có quyền xem toàn bộ dự án của Tổ thì đường về là "Dự án của tôi".
    var canAll = ViewBag.Can is Func<string, bool> && ((Func<string, bool>)ViewBag.Can)("wprojects.view");
    ViewBag.Crumbs = new List<Crumb>
    {
        canAll
            ? new Crumb { Label = "Dự án", Url = Url.Action("Index", "WorkProjects") }
            : new Crumb { Label = "Dự án của tôi", Url = Url.Action("Projects", "MyWork") },
        new Crumb { Label = p.Name }
    };
}

<div class="page-head">
    <div>
        <h1>@p.Name</h1>
        <p>
            @(string.IsNullOrWhiteSpace(p.Code) ? "" : p.Code + " · ")
            @(string.IsNullOrWhiteSpace(p.ProjectType) ? "chưa phân loại" : p.ProjectType)
            · Giai đoạn @ProjectPhases.Display(p.Phase)
        </p>
    </div>
    <div class="btn-row">
        <a class="btn btn-default" href="@Url.Action("Index", "Discussions", new { projectId = p.Id })">💬 Trao đổi</a>
        <a class="btn btn-default" href="@Url.Action("Index", "Checklist", new { projectId = p.Id })">Checklist</a>
        <a class="btn btn-default" href="@Url.Action("Members", "WorkProjects", new { id = p.Id })">Nhân sự</a>
        @if (Model.CanEdit)
        {
            <a class="btn btn-primary" href="@Url.Action("Edit", "WorkProjects", new { id = p.Id })">Sửa</a>
        }
    </div>
</div>

<div class="stats">
    <div class="stat">
        <div class="stat-value">@Model.ActiveCount</div>
        <div class="stat-label">Đang tham gia@(Model.PastCount > 0 ? " (" + Model.PastCount + " đã rời)" : "")</div>
    </div>
    <div class="stat">
        <div class="stat-value">@Model.ChecklistStat.Done/@Model.ChecklistStat.Total</div>
        <div class="stat-label">Mục checklist hoàn thành</div>
    </div>
    <div class="stat">
        <div class="stat-value">@Model.ChecklistStat.Overdue</div>
        <div class="stat-label">Đầu việc quá hạn</div>
    </div>
    <div class="stat">
        <div class="stat-value">@Model.SupportThisWeek</div>
        <div class="stat-label">Việc hỗ trợ tuần @Model.Week</div>
    </div>
</div>

<div class="card">
    <div class="card-head">Thông tin chung</div>
    <div class="card-body">
        <div class="form-grid">
            <div class="form-field">
                <label>Khách hàng</label>
                <div class="form-static">@(string.IsNullOrWhiteSpace(p.Customer) ? "—" : p.Customer)</div>
            </div>
            <div class="form-field">
                <label>Loại dự án</label>
                <div class="form-static">@(string.IsNullOrWhiteSpace(p.ProjectType) ? "—" : p.ProjectType)</div>
            </div>
            <div class="form-field">
                <label>Giai đoạn</label>
                <div class="form-static">@ProjectPhases.Display(p.Phase)</div>
            </div>
            <div class="form-field">
                <label>Trạng thái</label>
                <div class="form-static">
                    @if (p.IsOpen)
                    {
                        <span class="badge badge-active">@ProjectStates.Display(p.State)</span>
                    }
                    else
                    {
                        <span class="badge badge-inactive">@ProjectStates.Display(p.State)</span>
                    }
                </div>
            </div>
            <div class="form-field">
                <label>Thời gian</label>
                <div class="form-static">
                    @(p.StartDate.HasValue ? p.StartDate.Value.ToString("dd/MM/yyyy") : "?")
                    &ndash;
                    @(p.EndDate.HasValue ? p.EndDate.Value.ToString("dd/MM/yyyy") : "?")
                </div>
            </div>
            <div class="form-field">
                <label>PM phụ trách</label>
                <div class="form-static">
                    @(p.PmUserId > 0 ? p.PmName : "Chưa chỉ định")
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(p.Description))
        {
            <p class="hint" style="margin:14px 0 6px"><strong>Mô tả</strong></p>
            @* Nội dung từ WYSIWYG, đã lọc khi lưu; ToDisplay lọc thêm lần nữa rồi mới Raw. *@
            <div class="rich-content">@Html.Raw(HtmlSanitizer.ToDisplay(p.Description))</div>
        }
    </div>
</div>

@{
    var hasDeployInfo = !string.IsNullOrWhiteSpace(p.GithubLink) || !string.IsNullOrWhiteSpace(p.SvnLink)
        || !string.IsNullOrWhiteSpace(p.FtpAccount) || !string.IsNullOrWhiteSpace(p.FtpPassword)
        || !string.IsNullOrWhiteSpace(p.DbType) || !string.IsNullOrWhiteSpace(p.DbServer)
        || !string.IsNullOrWhiteSpace(p.DbUsername) || !string.IsNullOrWhiteSpace(p.DbPassword);
}
@if (hasDeployInfo)
{
    <div class="card">
        <div class="card-head">Thông tin triển khai</div>
        <div class="card-body">
            <div class="form-grid">
                @if (!string.IsNullOrWhiteSpace(p.GithubLink))
                {
                    <div class="form-field">
                        <label>Link Source Github</label>
                        <div class="form-static">
                            @if (p.GithubLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@p.GithubLink" target="_blank" rel="noopener noreferrer">@p.GithubLink</a>
                            }
                            else
                            {
                                @p.GithubLink
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.SvnLink))
                {
                    <div class="form-field">
                        <label>Link Source SVN</label>
                        <div class="form-static">
                            @if (p.SvnLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@p.SvnLink" target="_blank" rel="noopener noreferrer">@p.SvnLink</a>
                            }
                            else
                            {
                                @p.SvnLink
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.FtpAccount))
                {
                    <div class="form-field">
                        <label>FTP — Tài khoản</label>
                        <div class="form-static secret-row">
                            <span>@p.FtpAccount</span>
                            <input type="hidden" id="ftpAccount" value="@p.FtpAccount" />
                            <button type="button" class="btn btn-ghost btn-sm" data-copy-target="#ftpAccount">Sao chép</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.FtpPassword))
                {
                    <div class="form-field">
                        <label>FTP — Mật khẩu</label>
                        <div class="form-static secret-row">
                            <span class="secret-mask">••••••••</span>
                            <input type="hidden" id="ftpPassword" value="@p.FtpPassword" />
                            <button type="button" class="btn btn-ghost btn-sm" data-copy-target="#ftpPassword">Sao chép</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.DbType))
                {
                    <div class="form-field">
                        <label>Sử dụng database</label>
                        <div class="form-static">@p.DbType</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.DbServer))
                {
                    <div class="form-field">
                        <label>Database — Server</label>
                        <div class="form-static secret-row">
                            <span>@p.DbServer</span>
                            <input type="hidden" id="dbServer" value="@p.DbServer" />
                            <button type="button" class="btn btn-ghost btn-sm" data-copy-target="#dbServer">Sao chép</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.DbUsername))
                {
                    <div class="form-field">
                        <label>Database — Username</label>
                        <div class="form-static secret-row">
                            <span>@p.DbUsername</span>
                            <input type="hidden" id="dbUsername" value="@p.DbUsername" />
                            <button type="button" class="btn btn-ghost btn-sm" data-copy-target="#dbUsername">Sao chép</button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(p.DbPassword))
                {
                    <div class="form-field">
                        <label>Database — Password</label>
                        <div class="form-static secret-row">
                            <span class="secret-mask">••••••••</span>
                            <input type="hidden" id="dbPassword" value="@p.DbPassword" />
                            <button type="button" class="btn btn-ghost btn-sm" data-copy-target="#dbPassword">Sao chép</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-head">
        Tài liệu dự án
        <span class="muted">— @Model.Files.Count file</span>
    </div>

    @if (Model.Files.Count == 0)
    {
        <div class="empty-state">Chưa có tài liệu nào.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Dung lượng</th>
                        <th>Người tải lên</th>
                        <th>Ngày</th>
                        @if (Model.CanEdit)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Files)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("DownloadFile", "WorkProjects", new { id = p.Id, fileId = f.Id })">
                                    @f.OriginalName
                                </a>
                            </td>
                            <td class="muted nowrap">@CommentAttachments.SizeLabel(f.Size)</td>
                            <td class="muted">@(string.IsNullOrWhiteSpace(f.UploadedByName) ? "—" : f.UploadedByName)</td>
                            <td class="muted nowrap">@f.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            @if (Model.CanEdit)
                            {
                                <td class="nowrap" style="text-align:right">
                                    @using (Html.BeginForm("DeleteFile", "WorkProjects",
                                        new { id = p.Id, fileId = f.Id }, FormMethod.Post, new { @class = "inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-sm"
                                                onclick="return confirm('Xoá file này?');">Xoá</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.CanEdit)
    {
        <div class="card-body" style="border-top:1px solid var(--border-soft)">
            @using (Html.BeginForm("UploadFiles", "WorkProjects", new { id = p.Id },
                FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="btn-row" style="align-items:center">
                    <input type="file" name="files" multiple
                           accept=".png,.jpg,.jpeg,.gif,.webp,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.md,.zip,.rar,.7z" />
                    <button type="submit" class="btn btn-default btn-sm">Tải lên</button>
                    <span class="hint">Mỗi file tối đa 10 MB; nhận tài liệu, ảnh và file nén.</span>
                </div>
            }
        </div>
    }
</div>

<div class="card">
    <div class="card-head">
        Nhân sự dự án
        <span class="muted">— @Model.Assignments.Count giai đoạn tham gia</span>
    </div>
    @if (Model.Assignments.Count == 0)
    {
        <div class="empty-state">Dự án chưa có nhân sự nào.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Nhân sự</th>
                        <th>Vai trò</th>
                        <th>Giai đoạn</th>
                        <th>Tham gia từ</th>
                        <th>Rời ngày</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Assignments)
                    {
                        <tr class="@(a.IsActive ? "" : "row-closed")">
                            <td>
                                <strong>@a.UserFullName</strong>
                                @if (a.IsPm)
                                {
                                    <span class="badge badge-active">PM</span>
                                }
                            </td>
                            <td class="muted">@(string.IsNullOrWhiteSpace(a.Role) ? "—" : a.Role)</td>
                            <td class="muted">@AssignmentPhases.Display(string.IsNullOrWhiteSpace(a.Phase) ? AssignmentPhases.Both : a.Phase)</td>
                            <td class="nowrap">@a.JoinedAt.ToString("dd/MM/yyyy")</td>
                            <td class="nowrap">@(a.LeftAt.HasValue ? a.LeftAt.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td>
                                @if (a.IsActive)
                                {
                                    <span class="badge badge-active">Đang tham gia</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Đã rời</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.OverdueTasks.Count > 0)
{
    <div class="card">
        <div class="card-head">Đầu việc quá hạn</div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th>Công việc</th><th>Loại</th><th>Người thực hiện</th><th>Hạn</th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.OverdueTasks)
                    {
                        <tr>
                            <td><a href="@Url.Action("Detail", "MyWork", new { id = t.Id })">@t.Title</a></td>
                            <td class="muted">@TaskKinds.Display(t.Kind)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.AssigneeName) ? "(chưa giao)" : t.AssigneeName)</td>
                            <td class="nowrap">
                                @t.DueDate.Value.ToString("dd/MM/yyyy")
                                <span class="badge badge-inactive">Quá @(-t.DaysLeft) ngày</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Báo cáo tuần dự án dạng Timeline theo tuần/năm và Tự động tổng hợp *@
@if (Model.WeeklyReportModel != null)
{
    @Html.Partial("_WeeklyReportTimeline", Model.WeeklyReportModel)
}
