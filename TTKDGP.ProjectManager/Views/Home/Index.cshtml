@model TTKDGP.ProjectManager.Models.SummaryViewModel
@using TTKDGP.ProjectManager.Infrastructure
@{
    ViewBag.Title = "Tổng hợp nhân sự tham gia dự án";
    var maxLoad = Model.MemberLoads.Count == 0 ? 0 : Model.MemberLoads.Max(m => m.ProjectCount);
    var maxStatus = Model.StatusBreakdown.Count == 0 ? 0 : Model.StatusBreakdown.Max(s => s.Count);
}

<div class="page-head">
    <div>
        <h1>Tổng hợp nhân sự tham gia dự án</h1>
        <p>Thành viên nào đang tham gia dự án nào, làm công việc gì và trạng thái tham gia ra sao.</p>
    </div>

    <div class="week-box">
        <div class="week-box-title">
            Tuần @Model.CurrentWeek/@Model.CurrentYear
        </div>
        <div class="week-box-range">
            @Model.CurrentWeekFrom.ToString("dd/MM") – @Model.CurrentWeekTo.ToString("dd/MM/yyyy")
        </div>
        <div class="week-box-stats">
            <span class="badge badge-active" title="Tổng số công việc trong tháng @Model.TaskMonth/@Model.TaskMonthYear">
                @Model.MonthTaskCount việc trong tháng
            </span>
            <span class="badge badge-doing" title="Số dự án có ít nhất một công việc trong tháng @Model.TaskMonth/@Model.TaskMonthYear">
                @Model.MonthTaskProjectCount dự án có việc
            </span>
        </div>
    </div>
</div>

<div class="stats">
    <div class="stat">
        <div class="stat-value">@Model.TotalAssignments</div>
        <div class="stat-label">Lượt phân công</div>
    </div>
    <div class="stat">
        <div class="stat-value">@Model.DistinctMembers</div>
        <div class="stat-label">Thành viên</div>
    </div>
    <div class="stat">
        <div class="stat-value">@Model.DistinctProjects</div>
        <div class="stat-label">Dự án</div>
    </div>
    <div class="stat">
        <div class="stat-value">@Model.ActiveAssignments</div>
        <div class="stat-label">Đang tham gia</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Home", FormMethod.Get))
        {
            <div class="filters">
                <div class="filter-field grow">
                    <label for="keyword">Tìm kiếm</label>
                    <input type="search" id="keyword" name="keyword" value="@Model.Keyword"
                           placeholder="Tên thành viên, dự án, khách hàng, nội dung công việc..." />
                </div>

                <div class="filter-field">
                    <label for="memberId">Thành viên</label>
                    <select id="memberId" name="memberId">
                        <option value="">— Tất cả —</option>
                        @foreach (var m in Model.Members)
                        {
                            <option value="@m.Id" selected="@(Model.MemberId == m.Id)">@m.FullName</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="projectId">Dự án</label>
                    <select id="projectId" name="projectId">
                        <option value="">— Tất cả —</option>
                        @foreach (var p in Model.Projects)
                        {
                            <option value="@p.Id" selected="@(Model.ProjectId == p.Id)">@p.Name</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="pmId">PM</label>
                    <select id="pmId" name="pmId">
                        <option value="">— Tất cả —</option>
                        @foreach (var pm in Model.Pms)
                        {
                            <option value="@pm.Id" selected="@(Model.PmId == pm.Id)">@pm.FullName</option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label for="workStatus">Trạng thái</label>
                    <select id="workStatus" name="workStatus">
                        <option value="">— Tất cả —</option>
                        @foreach (var s in Model.WorkStatuses)
                        {
                            <option value="@s" selected="@(Model.WorkStatus == s)">@s</option>
                        }
                    </select>
                </div>

                <div class="check-inline">
                    <input type="checkbox" id="activeOnly" name="activeOnly" value="true" checked="@Model.ActiveOnly" />
                    <label for="activeOnly">Chỉ đang tham gia</label>
                </div>

                <div class="btn-row" style="padding-bottom:1px">
                    <button type="submit" class="btn btn-primary">Lọc</button>
                    <a class="btn btn-default" href="@Url.Action("Index", "Home")">Xoá lọc</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="two-col">
    <div class="card">
        <div class="card-head">
            <span>Khối lượng theo thành viên</span>
            <span class="muted" style="font-weight:400;font-size:12px">
                Công việc đang thực hiện, thuộc dự án đang thực hiện hoặc đang hỗ trợ
            </span>
        </div>
        <div class="card-body">
            @if (Model.MemberLoads.Count == 0)
            {
                <p class="muted">Không có ai đang thực hiện công việc nào phù hợp bộ lọc.</p>
            }
            else
            {
                <div class="bar-list">
                    @foreach (var load in Model.MemberLoads)
                    {
                        <div class="bar-row">
                            <div class="bar-label" title="@load.MemberName">@load.MemberName</div>
                            <div class="bar-track">
                                <div class="bar-fill" style="width:@(ViewHelpers.BarWidth(load.ProjectCount, maxLoad))%"></div>
                            </div>
                            <div class="bar-count">@load.ProjectCount</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <span>Phân bố theo trạng thái dự án</span>
            <span class="muted" style="font-weight:400;font-size:12px">Số dự án</span>
        </div>
        <div class="card-body">
            @if (Model.StatusBreakdown.Count == 0)
            {
                <p class="muted">Không có dữ liệu phù hợp bộ lọc.</p>
            }
            else
            {
                <div class="bar-list">
                    @foreach (var s in Model.StatusBreakdown)
                    {
                        <div class="bar-row">
                            <div class="bar-label"><span class="badge @ViewHelpers.StatusBadgeClass(s.Status)">@s.Status</span></div>
                            <div class="bar-track">
                                <div class="bar-fill" style="width:@(ViewHelpers.BarWidth(s.Count, maxStatus))%"></div>
                            </div>
                            <div class="bar-count">@s.Count</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <span>Công việc của nhân sự trong tháng @Model.TaskMonth/@Model.TaskMonthYear</span>
        <span class="muted" style="font-weight:400;font-size:12px">
            Việc đến hạn trong tháng; việc hỗ trợ tính theo tuần được phân
        </span>
    </div>

    @if (Model.MonthTasks.Count == 0)
    {
        <div class="card-body">
            <p class="muted" style="margin:0">Chưa có công việc nào trong tháng này.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Nhân sự</th>
                        @foreach (var state in TaskStates.All)
                        {
                            <th style="text-align:center">@TaskStates.Display(state)</th>
                        }
                        <th style="text-align:center">Quá hạn</th>
                        <th style="text-align:center">Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.MonthTasks)
                    {
                        <tr>
                            <td>@row.UserName</td>
                            @foreach (var state in TaskStates.All)
                            {
                                var n = row.Count(state);
                                <td style="text-align:center">
                                    @if (n > 0) { @n } else { <span class="muted">–</span> }
                                </td>
                            }
                            <td style="text-align:center">
                                @if (row.Overdue > 0)
                                {
                                    <strong style="color:var(--danger)">@row.Overdue</strong>
                                }
                                else
                                {
                                    <span class="muted">–</span>
                                }
                            </td>
                            <td style="text-align:center"><strong>@row.Total</strong></td>
                        </tr>
                    }
                </tbody>
                @if (Model.MonthTaskTotal != null && Model.MonthTasks.Count > 1)
                {
                    <tfoot>
                        <tr>
                            <td><strong>@Model.MonthTaskTotal.UserName</strong></td>
                            @foreach (var state in TaskStates.All)
                            {
                                <td style="text-align:center"><strong>@Model.MonthTaskTotal.Count(state)</strong></td>
                            }
                            <td style="text-align:center">
                                <strong style="color:@(Model.MonthTaskTotal.Overdue > 0 ? "var(--danger)" : "inherit")">
                                    @Model.MonthTaskTotal.Overdue
                                </strong>
                            </td>
                            <td style="text-align:center"><strong>@Model.MonthTaskTotal.Total</strong></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    }
</div>

