@model TTKDGP.ProjectManager.Controllers.DashboardViewModel
@using TTKDGP.ProjectManager.Infrastructure
@using TTKDGP.ProjectManager.Models
@using TTKDGP.ProjectManager.Services
@{
    ViewBag.Title = "Tổng quan";
    var t = Model.MyTasks;
}

<div class="page-head">
    <div>
        <h1>Tổng quan</h1>
        <p>@Model.UserFullName · @Model.Today.ToString("dd/MM/yyyy")</p>
    </div>
    <div class="btn-row">
        @using (Html.BeginForm("Index", "Dashboard", FormMethod.Get, new { @class = "inline-filter" }))
        {
            <select name="month" onchange="this.form.submit()">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.Month == m)">Tháng @m</option>
                }
            </select>
            <select name="year" onchange="this.form.submit()">
                @for (var y = Model.Today.Year - 2; y <= Model.Today.Year + 1; y++)
                {
                    <option value="@y" selected="@(Model.Year == y)">@y</option>
                }
            </select>
        }
        <a class="btn btn-default" href="@Url.Action("Tasks", "MyWork")">Công việc của tôi &rarr;</a>
    </div>
</div>

@* Khối KPI cá nhân bày đúng như màn Chi tiết KPI của Quản lý Tổ: vòng điểm bên trái, ngày công
   bên phải. Hai màn nói về cùng một con số nên phải nhìn giống nhau — người xem điểm của mình
   rồi được quản lý mở màn kia ra trao đổi thì không phải học lại cách đọc. *@
<div class="two-col">
    @* ----- KPI tháng ----- *@
    <div class="card">
        <div class="card-head">
            <span>Kết quả tháng @Model.Month/@Model.Year</span>
            <span class="muted" style="font-weight:400">
                @(Model.IsCurrentMonth ? "Tạm tính theo dữ liệu hiện có" : "Tháng đã qua")
            </span>
        </div>
        <div class="card-body">
            @if (Model.MyKpi == null)
            {
                <div class="muted">Chưa có dữ liệu KPI tháng này.</div>
            }
            else
            {
                @* Vòng điểm vẽ bằng conic-gradient, thang theo trần cấu hình chứ không cố định 100:
                   đổi trọng số thành 40/80 thì vòng phải theo, không thì ai cũng trông như vượt trần. *@
                <div class="score-block">
                    <div class="score-dial @Model.ScoreTone" style="--dial: @Model.ScorePercent%">
                        <div class="score-dial-inner">
                            <strong>@Model.MyKpi.FinalPoint.ToString("0")</strong>
                            <em>/ @Model.ScoreMax.ToString("0.##")</em>
                        </div>
                    </div>
                    <div class="score-side">
                        <span class="@KpiRanks.BadgeClass(Model.MyKpi.Rank) badge-lg">@Model.MyKpi.Rank</span>
                        <div class="score-side-line">
                            <span>Điểm chất lượng</span>
                            <strong>@Model.MyKpi.QualityPoint.ToString("0.##")</strong>
                        </div>
                        <div class="score-side-line">
                            <span>Tỷ lệ giờ công</span>
                            <strong class="@(Model.HoursShort > 0 ? "danger-text" : "ok-text")">@Model.MyKpi.AttendanceRate.ToString("0.##")%</strong>
                        </div>
                        <div class="score-side-line">
                            <span>Tổng số việc</span>
                            <strong>@(Model.MyKpi.SupportTotal + Model.MyKpi.ExecuteTotal + Model.MyKpi.AssignedTotal)</strong>
                        </div>
                    </div>
                </div>

                @* Bày ra từng bước tính: cộng ba nhóm ra điểm chất lượng, rồi nhân tỷ lệ giờ công
                   ra điểm cuối. Chỉ đưa con số rời rạc thì không ai lần ra điểm của mình ở đâu. *@
                <table class="kpi-calc">
                    <tbody>
                        <tr>
                            <td class="op"></td>
                            <td>
                                Hỗ trợ
                                <span class="muted">
                                    @if (Model.MyKpi.SupportTotal == 0)
                                    {
                                        <text>(chưa được giao việc nào)</text>
                                    }
                                    else
                                    {
                                        <text>(@Model.MyKpi.SupportHours.ToString("0.#")/@Model.MyKpi.SupportCapHours.ToString("0.#") giờ mốc)</text>
                                    }
                                </span>
                            </td>
                            <td class="val">@Model.MyKpi.SupportPoint.ToString("0.##")</td>
                        </tr>
                        <tr>
                            <td class="op">+</td>
                            <td>
                                Triển khai
                                <span class="muted">
                                    @if (Model.MyKpi.ExecuteTotal == 0)
                                    {
                                        <text>(chưa được giao việc nào)</text>
                                    }
                                    else
                                    {
                                        <text>(@Model.MyKpi.ExecuteHours.ToString("0.#")/@Model.MyKpi.ExecuteTargetHours.ToString("0.#") giờ định mức)</text>
                                    }
                                </span>
                            </td>
                            <td class="val">@Model.MyKpi.ExecutePoint.ToString("0.##")</td>
                        </tr>
                        <tr>
                            <td class="op">+</td>
                            <td>Việc riêng <span class="muted">(@Model.MyKpi.AssignedDone/@Model.MyKpi.AssignedTotal việc đúng hạn)</span></td>
                            <td class="val">@Model.MyKpi.AssignedPoint.ToString("0.##")</td>
                        </tr>
                        <tr class="sum">
                            <td class="op">=</td>
                            <td>Điểm chất lượng</td>
                            <td class="val">@Model.MyKpi.QualityPoint.ToString("0.##")</td>
                        </tr>
                        <tr class="@(Model.HoursShort > 0 ? "warn-row" : "")">
                            <td class="op">×</td>
                            <td>
                                Tỷ lệ giờ công
                                <span class="muted">(@Model.MyKpi.WorkedHours.ToString("0.#")/@Model.MyKpi.RequiredHours.ToString("0.#") giờ)</span>
                            </td>
                            <td class="val">@Model.MyKpi.AttendanceRate.ToString("0.##")%</td>
                        </tr>
                        <tr class="total">
                            <td class="op">=</td>
                            <td>KPI tháng @Model.Month/@Model.Year <span class="muted">(đã làm tròn)</span></td>
                            <td class="val">@Model.MyKpi.FinalPoint.ToString("0")</td>
                        </tr>
                    </tbody>
                </table>

                <span class="hint">
                    Xếp loại hiện hành: &ge;@KpiConfigService.Current.RankExcellent.ToString("0.##") Xuất sắc ·
                    @KpiConfigService.Current.RankGood.ToString("0.##") Tốt ·
                    @KpiConfigService.Current.RankFair.ToString("0.##") Khá ·
                    @KpiConfigService.Current.RankPass.ToString("0.##") Đạt · thấp hơn là Chưa đạt.
                </span>

                @* Quy tắc chấm để gập lại: người xem thường chỉ cần con số, nhưng khi thắc mắc
                   "sao lại ra điểm này" thì phải có chỗ tra ngay tại chỗ. *@
                <details class="kpi-rules">
                    <summary>Cách chấm điểm KPI</summary>
                    <div class="kpi-rules-body">
                        <p>
                            Điểm chất lượng cộng từ ba nhóm việc, sau đó nhân với tỷ lệ giờ công của
                            tháng. Điểm cuối làm tròn về số nguyên (từ 0,5 trở lên làm tròn lên).
                        </p>

                        <div class="kpi-rules-item">
                            <strong>Hỗ trợ — @KpiService.SupportMaxPoint.ToString("0.##") điểm khi đủ mốc giờ, CÓ trần</strong>
                            <div>
                                Chấm theo <strong>số giờ</strong> bỏ ra cho việc hỗ trợ, không theo
                                số đầu việc. Mốc =
                                @KpiConfigService.Current.SupportHoursShare.ToString("0.##") ×
                                giờ yêu cầu của tháng. Làm quá mốc không được thêm điểm, và phần
                                giờ vượt cũng không tính vào giờ công.
                                Không được giao việc nào trong nhóm thì nhóm đó 0 điểm.
                            </div>
                            <div class="muted">
                                Trễ: 0–@KpiConfigService.Current.SupportLateFreeCount lần không trừ ·
                                @(KpiConfigService.Current.SupportLateFreeCount + 1) lần trừ
                                @KpiConfigService.Current.SupportLate2Penalty.ToString("0.##") ·
                                nhiều hơn trừ @KpiConfigService.Current.SupportLateMorePenalty.ToString("0.##")
                            </div>
                        </div>

                        <div class="kpi-rules-item">
                            <strong>Triển khai — @KpiService.ExecuteMaxPoint.ToString("0.##") điểm khi đủ định mức, KHÔNG chặn trên</strong>
                            <div>
                                Chấm theo <strong>số giờ</strong> bỏ ra cho việc triển khai, không
                                theo số đầu việc. Định mức =
                                @KpiConfigService.Current.ExecuteHoursShare.ToString("0.##") ×
                                giờ yêu cầu của tháng. Làm nhiều giờ hơn định mức thì điểm vượt lên,
                                không bị chặn.
                            </div>
                            <div class="muted">
                                Mỗi lần báo cáo trễ trừ
                                @KpiConfigService.Current.ExecuteLatePenalty.ToString("0.##") điểm.
                            </div>
                        </div>

                        <div class="kpi-rules-item">
                            <strong>Việc riêng — điểm cộng</strong>
                            <div>
                                Mỗi việc mang sẵn mức điểm cộng ấn định lúc giao, chỉ tính khi hoàn
                                thành <strong>đúng hạn</strong>. Cộng thêm ngoài trần
                                @Model.ScoreMax.ToString("0.##") điểm của hai nhóm trên.
                            </div>
                        </div>

                        <div class="kpi-rules-item">
                            <strong>Tỷ lệ giờ công</strong>
                            <div>
                                Giờ yêu cầu = (ngày công chuẩn − ngày nghỉ phép đã duyệt) × @KpiService.HoursPerDay.ToString("0.##") giờ.
                                Giờ đã làm đếm theo <strong>ngày làm việc riêng biệt</strong> của các việc đang làm
                                hoặc đã xong — nhiều việc cùng một khoảng chỉ tính một lần, và chỉ đếm
                                ngày <strong>nằm trong tháng</strong> đang chấm.
                            </div>
                            <div class="muted">
                                Giờ <strong>hỗ trợ</strong> chỉ được tính tối đa
                                @KpiConfigService.Current.SupportHoursShare.ToString("0.##") × giờ yêu cầu
                                tháng; phần vượt trần không vào giờ công.
                                Đủ giờ thì giữ nguyên điểm chất lượng; thiếu giờ thì nhân theo tỷ lệ (chặn trên 100%).
                            </div>
                        </div>

                        <div class="kpi-rules-item">
                            <strong>Xếp loại</strong>
                            <div>
                                Từ @KpiConfigService.Current.RankExcellent.ToString("0.##") điểm: Xuất sắc ·
                                từ @KpiConfigService.Current.RankGood.ToString("0.##"): Tốt ·
                                từ @KpiConfigService.Current.RankFair.ToString("0.##"): Khá ·
                                từ @KpiConfigService.Current.RankPass.ToString("0.##"): Đạt ·
                                thấp hơn: Chưa đạt.
                            </div>
                        </div>

                        <div class="muted">
                            "Báo cáo trễ" là việc hoàn thành sau hạn. Việc quá hạn còn treo không tính
                            vào đây — nó đã bị trừ qua tỷ lệ hoàn thành. Việc đã huỷ không được chấm.
                        </div>
                    </div>
                </details>

                @* Giờ công: thiếu giờ thì KPI bị nhân theo tỷ lệ, nên phải nói rõ còn thiếu bao nhiêu. *@
                <div class="kpi-hours">
                    <div class="kpi-hours-head">
                        <span>Giờ làm việc tháng @Model.Month</span>
                        <strong>@Model.MyKpi.WorkedHours.ToString("0.#")/@Model.MyKpi.RequiredHours.ToString("0.#") giờ</strong>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill @(Model.HoursShort > 0 ? "warn" : "")"
                             style="width:@Model.HoursPercent%"></div>
                    </div>

                    <div class="kpi-hours-note">
                        @if (Model.HoursShort > 0)
                        {
                            <span class="danger-text">Còn thiếu @Model.HoursShort.ToString("0.#") giờ</span>
                            <text> — tương đương @Model.DaysShort.ToString("0.#") ngày công. Làm đủ giờ thì
                            được trọn @Model.MyKpi.QualityPoint.ToString("0.##") điểm thay vì
                            @Model.MyKpi.FinalPoint.ToString("0.##").</text>
                        }
                        else
                        {
                            <span class="ok-text">Đã đủ giờ công</span>
                            <text> — được trọn điểm chất lượng, không bị trừ theo ngày công.</text>
                        }
                    </div>

                    <div class="kpi-lines">
                        <div class="kpi-line">
                            <span>Ngày công chuẩn</span>
                            <strong>@Model.MyKpi.StandardDays ngày</strong>
                        </div>
                        @if (Model.MyKpi.LeaveDays > 0)
                        {
                            <div class="kpi-line">
                                <span>Trừ nghỉ phép</span>
                                <strong>@Model.MyKpi.LeaveDays.ToString("0.##") ngày</strong>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Nghỉ phép gộp vào đây thay vì đứng riêng một thẻ: cùng nói về ngày công của tháng,
               mà để riêng thì nửa màn hình bên phải gần như trống. *@
            <div class="kpi-hours">
                <div class="kpi-hours-head">
                    <span>Nghỉ phép</span>
                    <a href="@Url.Action("My", "Leaves")">Xem tất cả</a>
                </div>

                <div class="kpi-lines">
                    <div class="kpi-line">
                        <span>Đã nghỉ tháng @Model.Month</span>
                        <strong>@Model.MyLeave.ApprovedDays.ToString("0.##") ngày</strong>
                    </div>
                    <div class="kpi-line">
                        <span>Đơn của tôi đang chờ duyệt</span>
                        <strong>@Model.MyLeave.PendingCount</strong>
                    </div>
                    @if (Model.CanApproveLeave)
                    {
                        <div class="kpi-line">
                            <span>Chờ tôi duyệt</span>
                            <strong>
                                @if (Model.PendingLeaveCount > 0)
                                {
                                    <a href="@Url.Action("Approve", "Leaves")">@Model.PendingLeaveCount đơn</a>
                                }
                                else
                                {
                                    <text>0</text>
                                }
                            </strong>
                        </div>
                    }
                    @foreach (var leave in Model.MyLeave.Upcoming)
                    {
                        <div class="kpi-line">
                            <span>Sắp nghỉ · @LeaveKinds.Display(leave.Kind)</span>
                            <strong>@leave.FromDate.ToString("dd/MM") – @leave.ToDate.ToString("dd/MM") · @leave.Days.ToString("0.##") ngày</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ----- Việc cần làm trước: đặt cạnh thẻ KPI để hai khối chính cùng nằm trong một màn ----- *@
    <div class="card">
        <div class="card-head">
            <span>Cần làm trước</span>
            <span class="muted" style="font-weight:400">Tháng @Model.Month · quá hạn và sắp tới hạn</span>
        </div>
        @if (t.Focus.Count == 0)
        {
            <div class="empty-state">
                @if (t.OpenCount == 0)
                {
                    <text>Không có việc nào đang mở trong tháng @Model.Month.</text>
                }
                else
                {
                    <text>Không có việc nào quá hạn hay sắp tới hạn trong tháng @Model.Month. Còn @t.OpenCount việc đang mở.</text>
                }
            </div>
        }
        else
        {
            @* Dạng danh sách chứ không phải bảng: cột này chỉ rộng nửa màn, mà bảng năm cột thì
               mỗi cột bị bóp còn một hai từ. Gom mỗi việc thành một dòng hai tầng. *@
            <div class="task-feed">
                @foreach (var task in t.Focus)
                {
                    <div class="task-feed-item row-clickable"
                         data-modal-url="@Url.Action("Detail", "Checklist", new { id = task.Id })"
                         data-modal-title="Chi tiết công việc"
                         data-modal-size="lg">
                        <div class="task-feed-main">
                            <div class="task-feed-title">
                                @if (!string.IsNullOrWhiteSpace(task.Code))
                                {
                                    <span class="muted">@task.Code</span> <text>·</text>
                                }
                                @task.Title
                            </div>
                            <div class="task-feed-meta">
                                <span>@(string.IsNullOrWhiteSpace(task.ProjectName) ? "Việc riêng" : task.ProjectName)</span>
                                @if (task.DueDate.HasValue)
                                {
                                    <span>·</span>
                                    <span>Hạn @task.DueDate.Value.ToString("dd/MM")</span>
                                }
                                <span>·</span>
                                <span>@task.Progress%</span>
                            </div>
                        </div>
                        <div class="task-feed-side">
                            @if (task.IsOverdue)
                            {
                                @* Việc còn đang treo nên đếm từ hạn tới hôm nay; LateDays chỉ có
                                   nghĩa khi đã hoàn thành, dùng ở đây sẽ luôn ra 0. *@
                                <span class="badge badge-danger">Quá hạn @(-task.DaysLeft) ngày</span>
                            }
                            else
                            {
                                <span class="badge">@TaskStates.Display(task.State)</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ----- Biểu đồ ----- *@
<div class="two-col">
    <div class="card">
        <div class="card-head">
            <span>Việc của tôi theo trạng thái</span>
        </div>
        <div class="card-body">
            @if (Model.StateChart.HasData)
            {
                <div class="chart-box">
                    <canvas id="chart-state"></canvas>
                </div>
            }
            else
            {
                <div class="muted">Chưa có công việc nào để thống kê.</div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <span>Hoàn thành theo tháng</span>
            <span class="muted" style="font-weight:400">6 tháng gần đây</span>
        </div>
        <div class="card-body">
            @if (Model.TrendChart.HasData)
            {
                <div class="chart-box">
                    <canvas id="chart-trend"></canvas>
                </div>
            }
            else
            {
                <div class="muted">Chưa có việc nào hoàn thành trong 6 tháng gần đây.</div>
            }
        </div>
    </div>
</div>

@* ----- Phần toàn Tổ: chỉ Quản lý Tổ mới thấy ----- *@
@if (Model.CanSeeTeam && Model.Team != null)
{
    <div class="tile-grid">
        <div class="tile">
            <div class="tile-num">@Model.Team.OpenProjectCount</div>
            <div class="tile-label">Dự án đang chạy</div>
        </div>
        <div class="tile">
            <div class="tile-num">@Model.Team.MyPmCount</div>
            <div class="tile-label">Dự án tôi làm PM</div>
        </div>
        <div class="tile">
            <div class="tile-num">@Model.Team.OpenTaskCount</div>
            <div class="tile-label">Việc chưa xong toàn Tổ</div>
        </div>
        <div class="tile">
            <div class="tile-num @(Model.Team.OverdueTaskCount > 0 ? "danger" : "")">@Model.Team.OverdueTaskCount</div>
            <div class="tile-label">Quá hạn toàn Tổ</div>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <span>Dự án cần chú ý</span>
            <a class="muted" style="font-weight:400" href="@Url.Action("Index", "WorkProjects")">Tất cả dự án</a>
        </div>
        @if (Model.Team.Projects.Count == 0)
        {
            <div class="empty-state">Chưa có dự án nào đang chạy.</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Dự án</th>
                            <th>PM</th>
                            <th class="num">Quá hạn</th>
                            <th class="num">Tiến độ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Team.Projects)
                        {
                            <tr>
                                <td class="col-project">
                                    <a href="@Url.Action("Details", "WorkProjects", new { id = row.Project.Id })">@row.Project.Name</a>
                                    @if (!string.IsNullOrWhiteSpace(row.Project.Customer))
                                    {
                                        <div class="cell-sub muted">@row.Project.Customer</div>
                                    }
                                </td>
                                <td class="col-name">@(string.IsNullOrWhiteSpace(row.Project.PmName) ? "—" : row.Project.PmName)</td>
                                <td class="num">
                                    @if (row.OverdueCount > 0)
                                    {
                                        <span class="badge badge-inactive">@row.OverdueCount</span>
                                    }
                                    else
                                    {
                                        <span class="muted">0</span>
                                    }
                                </td>
                                <td class="num">@row.Stat.Percent%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@* Số liệu để riêng trong thẻ json, không nhúng thẳng vào mã lệnh — chuỗi tiếng Việt nằm trong
   JavaScript dễ vỡ khi có dấu nháy. *@
<script type="application/json" id="dash-state">@Html.Raw(Json.Encode(Model.StateChart))</script>
<script type="application/json" id="dash-trend">@Html.Raw(Json.Encode(Model.TrendChart))</script>

@section Scripts {
    <script src="@Url.Content("~/Scripts/lib/chart.min.js")"></script>
    <script>
        (function () {
            'use strict';

            if (typeof Chart === 'undefined') return;

            function read(id) {
                var el = document.getElementById(id);
                if (!el) return null;
                try { return JSON.parse(el.textContent || el.innerText); } catch (e) { return null; }
            }

            // Lấy màu từ biến CSS để biểu đồ đổi theo bảng màu chung, khỏi chép cứng mã màu.
            function themeColor(name, fallback) {
                var value = getComputedStyle(document.documentElement).getPropertyValue(name);
                return (value || '').trim() || fallback;
            }

            Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
            Chart.defaults.color = themeColor('--text-muted', '#6b7280');

            var state = read('dash-state');
            var stateCanvas = document.getElementById('chart-state');
            if (state && stateCanvas) {
                new Chart(stateCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: state.Labels,
                        datasets: [{
                            data: state.Values,
                            // Theo thứ tự trạng thái: chưa bắt đầu, đang làm, tạm dừng, hoàn thành, huỷ.
                            backgroundColor: ['#94a3b8', '#3b82f6', '#f59e0b', '#22a06b', '#ef4444'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } }
                        }
                    }
                });
            }

            var trend = read('dash-trend');
            var trendCanvas = document.getElementById('chart-trend');
            if (trend && trendCanvas) {
                var line = themeColor('--primary', '#2563eb');

                new Chart(trendCanvas, {
                    type: 'line',
                    data: {
                        labels: trend.Labels,
                        datasets: [{
                            label: 'Việc hoàn thành',
                            data: trend.Values,
                            borderColor: line,
                            backgroundColor: 'rgba(37, 99, 235, .12)',
                            borderWidth: 2,
                            fill: true,
                            tension: .3,
                            pointRadius: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            // Số việc là số nguyên — bỏ các vạch lẻ như 0,5.
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }
        })();
    </script>
}
