  <!--
    Chặn lỗi font tiếng Việt trong view ngay tại bước build.

    View .cshtml thiếu BOM sẽ được Razor đọc theo mã trang mặc định của máy chủ, làm mọi chữ tiếng
    Việt viết thẳng trong view hiện thành ký tự rác. Lỗi này KHÔNG làm build đỏ và chỉ lộ ra khi mở
    trang, nên kiểm bằng mắt là không đủ — đã lọt lên bản chạy nhiều lần.

    Script tự thêm BOM cho file nào thiếu, chạy trước mỗi lần build (kể cả lúc publish trên máy chủ
    build), nên không còn đường nào để lỗi này tới được người dùng.
  -->
  <Target Name="KiemTraMaHoaView" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-tools\fix-view-encoding.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)\Views&quot;"
          ContinueOnError="false" />
  </Target>
