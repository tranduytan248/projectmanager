<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Thuộc tính file= trỏ tới một file cấu hình ngoài, các khoá trong đó sẽ ghi đè khoá ở đây.
    File secrets.config chứa token thật và KHÔNG được đưa vào kho mã nguồn.
    Xem App_Config\secrets.example.config để biết cách tạo.
  -->
  <appSettings file="App_Config\secrets.config">
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!-- Địa chỉ truy cập hệ thống, đính kèm cuối mỗi tin nhắc -->
    <add key="App:PublicUrl" value="pmncpt.cenit.vn" />

    <!--
      ===== Kết nối cơ sở dữ liệu SQL Server =====
      Dữ liệu nghiệp vụ nay lưu trong SQL Server chứ không còn ở các file JSON trong App_Data.
      Máy chủ, tên CSDL và tài khoản để ở đây; MẬT KHẨU đặt trong App_Config\secrets.config,
      không đưa vào kho mã nguồn (giống cách làm với hộp thư mail).
      Bảng sẽ tự được tạo khi ứng dụng khởi động lần đầu; nếu bảng còn trống thì dữ liệu
      trong App_Data\*.json sẽ được nạp sang một lần.
    -->
    <add key="Db:Server" value="10.57.30.10,1433" />
    <add key="Db:Name" value="pmncpt.cenit.vn" />
    <add key="Db:User" value="pmncpt.cenit.vn" />
    <!-- Mật khẩu đặt trong secrets.config, không đặt ở đây -->
    <add key="Db:Password" value="" />
    <!-- Đăng nhập SQL bằng tài khoản Windows thay cho user/mật khẩu thì đặt true -->
    <add key="Db:IntegratedSecurity" value="false" />

    <!--
      Biểu đồ "Khối lượng theo thành viên" chỉ đếm phân công ở trạng thái công việc
      dưới đây, và dự án phải đang ở một trong các trạng thái dự án dưới đây.
      Nhiều giá trị thì ngăn nhau bằng dấu phẩy. Đổi tên trạng thái trong danh mục
      thì nhớ sửa lại hai dòng này cho khớp.
    -->
    <add key="Dashboard:WorkloadWorkStatuses" value="Đang thực hiện" />
    <add key="Dashboard:WorkloadProjectStatuses" value="Đang thực hiện, Đang hỗ trợ" />

    <!-- ===== Nhắc báo cáo qua Telegram ===== -->
    <!-- Bật/tắt toàn bộ tính năng gửi nhắc tự động -->
    <add key="Telegram:Enabled" value="false" />
    <!-- Token lấy từ @BotFather — đặt trong secrets.config, không đặt ở đây -->
    <add key="Telegram:BotToken" value="" />
    <!-- Id nhóm nhận thông báo, dạng số âm với nhóm (ví dụ -1001234567890) -->
    <add key="Telegram:ChatId" value="" />

    <!-- ===== Gửi mail nhắc báo cáo cho từng thành viên ===== -->
    <!-- Bật/tắt toàn bộ tính năng gửi mail -->
    <add key="Email:Enabled" value="false" />
    <add key="Email:Host" value="email.vnpt.vn" />
    <add key="Email:Port" value="587" />
    <!-- Cổng 587 dùng STARTTLS nên luôn để true -->
    <add key="Email:EnableSsl" value="true" />
    <add key="Email:User" value="portal-noreply.kha@vnpt.vn" />
    <!-- Mật khẩu đặt trong secrets.config, không đặt ở đây -->
    <add key="Email:Password" value="" />
    <!-- Tên hiển thị ở ô người gửi -->
    <add key="Email:DisplayName" value="Hệ thống quản lý dự án của Nghiên Cứu Phát Triển" />

    <!--
      ===== API gửi SMS cho hệ thống đối tác =====
      Đối tác gọi GET /api/Util/SendSms, xác thực bằng khoá bí mật khai ở màn Hệ thống tích hợp.
      Phần mềm không nối thẳng vào nhà mạng mà chuyển tiếp sang tổng đài dùng chung dưới đây.
    -->
    <add key="Sms:Enabled" value="true" />
    <add key="Sms:GatewayUrl" value="https://vnptkhanhhoa.cenit.vn/api/Util/SendSms" />
    <add key="Sms:TimeoutSeconds" value="30" />
    <!-- Trần số máy nhận trong một lần gọi, chặn bắn hàng loạt do gọi nhầm -->
    <add key="Sms:MaxPhones" value="50" />

    <!--
      ===== Bộ quản lý công việc & KPI =====
      Đơn vị được phép lấy nhân sự sang bộ quản lý công việc. Màn "Nhân sự Tổ → Lấy từ HRM" chỉ
      hiện người thuộc đơn vị này và TOÀN BỘ đơn vị con bên dưới — nhân sự thật nằm ở phòng/tổ
      sâu vài cấp (ví dụ Trung tâm > Phòng Giải pháp > Tổ Giải pháp B&amp;C).

      Khai bằng MÃ đơn vị cho chắc: mã không đổi, còn tên thì có thể đổi hoặc lệch dấu.
      239.603 = Trung tâm Kinh doanh Giải pháp (VNPT Khánh Hòa).
      Vẫn nhận cả tên đơn vị nếu muốn khai cho dễ đọc.
    -->
    <add key="Work:HrmWorkplace" value="239.603" />

    <!-- Sáng thứ Hai: nhắc các dự án chưa báo cáo của TUẦN TRƯỚC -->
    <add key="Reminder:MondayHour" value="8" />
    <!-- Sáng thứ Sáu: mail riêng cho từng thành viên, nhắc gửi báo cáo về cho PM -->
    <add key="Reminder:MemberEmailHour" value="8" />
    <!-- Chiều thứ Sáu: nhắc các dự án chưa báo cáo của TUẦN NÀY -->
    <add key="Reminder:FridayHour" value="15" />
    <!-- Sáng thứ Bảy: tổng hợp "Tên PM - Dự án" của TUẦN NÀY, báo cáo cho anh Tân -->
    <add key="Reminder:SaturdayHour" value="9" />
    <!--
      Lịch tự động gửi. Để false ở máy phát triển cho khỏi bắn tin thật vào nhóm.
      Web.Release.config chuyển thành true khi publish.
      Nút gửi thủ công trên màn hình Thông báo không phụ thuộc cờ này.
    -->
    <add key="Reminder:AutoSend" value="false" />
    <!-- Khoá bảo vệ endpoint kích hoạt thủ công /Notifications/Trigger -->
    <add key="Reminder:TriggerKey" value="" />

    <!--
      ===== Tự động đăng nhập cổng VNPT GoConnect =====
      Mỗi sáng tới giờ hẹn, hệ thống mở trình duyệt nền, bấm gửi OTP rồi nhắn qua Telegram
      cho chủ tài khoản. Chủ tài khoản trả lời mã OTP, hệ thống nhập OTP + tick điều khoản +
      bấm Đăng nhập, vào tới workspace thì lưu phiên lại. Dùng chung token bot với phần nhắc
      báo cáo (Telegram:BotToken).

      An toàn: bot CHỈ nghe đúng chat id dưới đây và CHỈ dùng đúng số điện thoại mặc định.
      Yêu cầu cài trước Chromium cho Playwright (xem build/changes) và bật Always Running cho
      application pool để tiến trình nền không bị IIS ngắt.
    -->
    <add key="GoConnect:Enabled" value="true" />
    <!--
      IP của máy được phép chạy /hrm (máy local có trình duyệt, phục vụ pm.tdt.vn). Máy mang IP
      này đóng vai "máy đăng nhập": chạy /hrm, nghe bot @HRM_KHA_bot, footer hiện pm.tdt.vn. Máy
      khác (bản chạy thật) chặn /hrm, nghe bot Thư ký cho /dongbo, footer hiện App:PublicUrl.
      Cùng một bản build thả lên máy nào cũng tự nhận vai theo IP. Đổi máy thì sửa khoá này.
    -->
    <add key="GoConnect:LoginMachineIp" value="10.57.33.84" />
    <!--
      Token bot RIÊNG cho đăng nhập GoConnect (khác bot nhắc báo cáo). Đặt token thật
      trong App_Config\secrets.config. Để trống thì dùng chung Telegram:BotToken.
    -->
    <add key="GoConnect:BotToken" value="" />
    <!-- Số điện thoại của chính chủ tài khoản (chỉ chữ số) -->
    <add key="GoConnect:DefaultPhone" value="0942963127" />
    <!--
      Đơn vị cần lấy danh sách nhân sự khi đồng bộ (lệnh /hrm hoặc /dongbo). Phải là đơn vị
      cấp trên chứa toàn bộ người cần lấy — không phải đơn vị riêng của chủ tài khoản.
      Để trống thì lùi về đơn vị của chủ tài khoản đọc từ phiên đăng nhập.
    -->
    <add key="GoConnect:WorkplaceId" value="0199a597-29d9-7510-8702-ebd1a0b16b51" />
    <!--
      Địa chỉ hiện trong footer của bot GoConnect (/hrm, /dongbo). Tách RIÊNG khỏi App:PublicUrl:
      phần HRM/GoConnect gắn với tên miền pm.tdt.vn, còn nhắc báo cáo và mail vẫn dùng App:PublicUrl.
      Để trống thì lùi về App:PublicUrl.
    -->
    <add key="GoConnect:PublicUrl" value="pm.tdt.vn" />
    <!-- Chat riêng Telegram của chủ tài khoản (id dương). Trống thì dùng tạm Telegram:ChatId -->
    <add key="GoConnect:ChatId" value="805526622" />
    <!-- Giờ:phút đăng nhập tự động mỗi ngày -->
    <add key="GoConnect:AutoLoginHour" value="7" />
    <add key="GoConnect:AutoLoginMinute" value="30" />
    <!-- Chạy trình duyệt ẩn; đặt false khi cần xem tận mắt lúc gỡ lỗi -->
    <add key="GoConnect:Headless" value="true" />
    <!-- Đăng nhập xong thì trích token và gửi lên Telegram (token nhạy cảm, chỉ vào chat riêng) -->
    <add key="GoConnect:SendToken" value="true" />
    <!-- Thời gian chờ trả lời OTP trước khi huỷ phiên (giây) -->
    <add key="GoConnect:OtpTimeoutSeconds" value="180" />
    <!-- Địa chỉ trang đăng nhập và mẫu URL nhận biết đã vào workspace -->
    <add key="GoConnect:LoginUrl" value="https://goconnect.vnpt.vn/login" />
    <add key="GoConnect:WorkspaceUrlPattern" value="**/home/workspace**" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!-- maxRequestLength 12 MB: file đính kèm trao đổi tối đa 10 MB cộng phần dư của form. -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" requestValidationMode="4.5" maxRequestLength="12288" />
    <!--
      fileEncoding="utf-8" bắt ASP.NET đọc MỌI file mã nguồn giao diện (.cshtml) bằng UTF-8, không
      cần dựa vào BOM. Đây là chỗ sửa tận gốc lỗi chữ tiếng Việt trong view hiện thành ký tự rác:
      trước đây file thiếu BOM thì Razor đọc theo mã trang mặc định của máy chủ và hỏng hết.

      Script build-tools\fix-view-encoding.ps1 vẫn giữ để thêm BOM cho gọn, nhưng nó chỉ chạy lúc
      build — file view tạo ra giữa hai lần build vẫn được Razor đọc ngay, nên phải chặn ở đây.
    -->
    <globalization culture="vi-VN" uiCulture="vi-VN" fileEncoding="utf-8" />

    <!-- Đăng nhập bằng cookie. Trang tổng hợp ngoài FrontEnd vẫn xem được khi chưa đăng nhập. -->
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login"
             name=".TTKDGP_AUTH"
             timeout="480"
             slidingExpiration="true"
             protection="All"
             cookieless="UseCookies"
             requireSSL="false" />
    </authentication>

    <authorization>
      <allow users="*" />
    </authorization>

    <customErrors mode="RemoteOnly" defaultRedirect="~/Home/Index" />

    <!--
      machineKey KHÔNG được đưa vào kho mã nguồn: ai có khoá này là giả mạo được
      cookie đăng nhập của mọi người dùng.

      Không khai báo thì ASP.NET tự sinh khoá riêng cho ứng dụng — chạy tốt trên
      một máy chủ đơn lẻ, chỉ có điều mọi người bị đăng xuất mỗi khi ứng dụng
      khởi động lại.

      Khi triển khai thật, hãy sinh khoá riêng và dán vào đây:
        IIS Manager > chọn site > Machine Key > Generate Keys > Apply

      <machineKey validationKey="..." decryptionKey="..."
                  validation="HMACSHA256" decryption="AES" />
    -->
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />

    <staticContent>
      <!-- IIS chưa biết đuôi .webmanifest nên phải khai báo, không thì trả về 404 -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <!--
        Gói WebPages/Razor 3.2.9 vẫn giữ assembly version 3.0.0.0, nên redirect về 3.0.0.0
        chứ không phải theo số hiệu gói.
      -->
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages.Deployment" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <!--
        Các phụ thuộc gián tiếp của Microsoft.Playwright (System.Text.Json...) cần
        binding redirect trên .NET Framework, không thì lúc chạy có thể FileLoadException.
        Nếu gặp lỗi tải assembly khác, thêm redirect tương tự theo cảnh báo MSB3247 khi build.
      -->
      <dependentAssembly>
        <assemblyIdentity name="System.ComponentModel.Annotations" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.1.0" newVersion="4.2.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.10" newVersion="6.0.0.10" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
