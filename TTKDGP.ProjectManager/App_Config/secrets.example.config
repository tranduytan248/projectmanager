<?xml version="1.0" encoding="utf-8"?>
<!--
  MẪU cấu hình bí mật.

  Cách dùng:
    1. Chép file này thành  App_Config\secrets.config  (cùng thư mục)
    2. Điền token và chat id thật vào
    3. KHÔNG commit secrets.config — file này đã được .gitignore loại trừ
       và cũng KHÔNG nằm trong gói publish, nên phải tạo tay trên máy chủ.

  Lấy token    : nhắn @BotFather trên Telegram, lệnh /newbot hoặc /token
  Lấy chat id  : thêm bot vào nhóm, gửi một tin bất kỳ trong nhóm,
                 rồi vào màn hình Thông báo trong ứng dụng bấm "Dò chat id".

  Lưu ý: ở đây chỉ để những giá trị BÍ MẬT. Các công tắc bật/tắt
  (Telegram:Enabled, Reminder:AutoSend) nằm trong Web.config — bản publish
  Release đã tự bật sẵn qua Web.Release.config.
-->
<appSettings>
  <add key="Telegram:BotToken" value="123456789:THAY-BANG-TOKEN-THAT-CUA-BAN" />
  <add key="Telegram:ChatId" value="-1001234567890" />

  <!--
    Token bot RIÊNG cho tính năng tự động đăng nhập GoConnect (ví dụ @HRM_KHA_bot).
    Khác với bot nhắc báo cáo ở trên. Để trống thì dùng chung Telegram:BotToken.
  -->
  <add key="GoConnect:BotToken" value="THAY-BANG-TOKEN-BOT-DANG-NHAP" />

  <!-- Chuỗi bí mật để gọi /Notifications/Trigger?key=... từ Task Scheduler -->
  <add key="Reminder:TriggerKey" value="THAY-BANG-CHUOI-NGAU-NHIEN-DAI" />

  <!--
    Mật khẩu hộp thư gửi mail nhắc báo cáo. Host, cổng, tài khoản và tên hiển thị
    nằm trong Web.config; chỉ mật khẩu để ở đây.
  -->
  <add key="Email:Enabled" value="true" />
  <add key="Email:Password" value="THAY-BANG-MAT-KHAU-HOP-THU" />

  <!--
    Mật khẩu tài khoản SQL Server. Máy chủ, tên CSDL và tài khoản nằm trong Web.config;
    chỉ mật khẩu để ở đây. Nếu dùng Windows Authentication (Db:IntegratedSecurity=true)
    thì không cần khoá này.
  -->
  <add key="Db:Password" value="THAY-BANG-MAT-KHAU-SQL" />

  <!--
    Đăng nhập tự động cổng CAS VNPT (id.vnpt.com.vn -> hrm.vnpt.vn). Các khoá không nhạy cảm
    (Hrm:Enabled, Hrm:LoginUrl, Hrm:ChatId...) nằm trong Web.config; ở đây chỉ username/mật khẩu
    CAS và token bot — giống cách GoConnect:BotToken tách riêng khỏi GoConnect:ChatId.
  -->
  <add key="Hrm:Username" value="THAY-BANG-TEN-DANG-NHAP-CAS" />
  <add key="Hrm:Password" value="THAY-BANG-MAT-KHAU-CAS" />
  <add key="Hrm:BotToken" value="THAY-BANG-TOKEN-BOT-DANG-NHAP-HRM" />
</appSettings>
