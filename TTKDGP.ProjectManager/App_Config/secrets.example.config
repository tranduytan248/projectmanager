<?xml version="1.0" encoding="utf-8"?>
<!--
  MẪU cấu hình bí mật.

  Cách dùng:
    1. Chép file này thành  App_Config\secrets.config  (cùng thư mục)
    2. Điền token và chat id thật vào
    3. KHÔNG commit secrets.config — file này đã được .gitignore loại trừ
       và cũng KHÔNG nằm trong gói publish, nên phải tạo tay trên máy chủ.

  Lấy token    : nhắn @BotFather trên Telegram, lệnh /newbot hoặc /token
  Lấy chat id  : thêm bot vào nhóm, gửi một tin bất kỳ trong nhóm,
                 rồi vào màn hình Thông báo trong ứng dụng bấm "Dò chat id".

  Lưu ý: ở đây chỉ để những giá trị BÍ MẬT. Các công tắc bật/tắt
  (Telegram:Enabled, Reminder:AutoSend) nằm trong Web.config — bản publish
  Release đã tự bật sẵn qua Web.Release.config.
-->
<appSettings>
  <add key="Telegram:BotToken" value="123456789:THAY-BANG-TOKEN-THAT-CUA-BAN" />
  <add key="Telegram:ChatId" value="-1001234567890" />

  <!-- Chuỗi bí mật để gọi /Notifications/Trigger?key=... từ Task Scheduler -->
  <add key="Reminder:TriggerKey" value="THAY-BANG-CHUOI-NGAU-NHIEN-DAI" />
</appSettings>
